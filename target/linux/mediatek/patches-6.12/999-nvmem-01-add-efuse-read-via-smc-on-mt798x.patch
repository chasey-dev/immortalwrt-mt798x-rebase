---
[v1] nvmem: mtk-efuse: support reading efuse via SMC on MT798x

On mt798x SoCs that lock the efuse block to the secure world, normal
world can no longer read the efuse registers via MMIO. Instead, the
firmware (BL31) exposes a public read service over SMC that returns only
the offsets it deems public, rejecting any other access.
---
v1: Initial reading efuse via SMC implementation on MT798x
---

diff --git a/drivers/nvmem/mtk-efuse.c b/drivers/nvmem/mtk-efuse.c
index 9caf04667341..1a1bba95633d 100644
--- a/drivers/nvmem/mtk-efuse.c
+++ b/drivers/nvmem/mtk-efuse.c
@@ -4,6 +4,7 @@
  * Author: Andrew-CT Chen <andrew-ct.chen@mediatek.com>
  */
 
+#include <linux/arm-smccc.h>
 #include <linux/device.h>
 #include <linux/module.h>
 #include <linux/mod_devicetable.h>
@@ -11,15 +12,73 @@
 #include <linux/nvmem-provider.h>
 #include <linux/platform_device.h>
 #include <linux/property.h>
+#include <linux/soc/mediatek/mtk_sip_svc.h>
+
+#define MTK_SIP_EFUSE_READ_BY_OFFSET		MTK_SIP_SMC_CMD(0x505)
+
+#define MTK_EFUSE_SUCCESS			0x0
 
 struct mtk_efuse_pdata {
 	bool uses_post_processing;
+	bool uses_smc;
 };
 
 struct mtk_efuse_priv {
 	void __iomem *base;
 };
 
+static int mtk_efuse_smc_read_by_offset(u32 ofs, u32 bytes, u32 *val)
+{
+	struct arm_smccc_res res = {};
+
+	arm_smccc_smc(MTK_SIP_EFUSE_READ_BY_OFFSET, ofs, bytes,
+		      0, 0, 0, 0, 0, &res);
+
+	if (res.a0 == SMCCC_RET_NOT_SUPPORTED)
+		return -ENODEV;
+	if (res.a0 != MTK_EFUSE_SUCCESS)
+		return -EIO;
+
+	*val = res.a1;
+
+	return 0;
+}
+
+static bool mtk_efuse_smc_supported(void)
+{
+	u32 val;
+
+	return mtk_efuse_smc_read_by_offset(0, sizeof(val), &val) != -ENODEV;
+}
+
+static int mtk_reg_read_smc(void *context,
+			    unsigned int reg, void *_val, size_t bytes)
+{
+	u8 *val = _val;
+	size_t chunk;
+	u32 word;
+	int ret;
+	int i;
+
+	while (bytes) {
+		chunk = min(bytes, sizeof(u32));
+		word = 0;
+
+		ret = mtk_efuse_smc_read_by_offset(reg, chunk, &word);
+		if (ret)
+			return ret;
+
+		for (i = 0; i < chunk; i++)
+			val[i] = word >> (i * 8);
+
+		val += chunk;
+		reg += chunk;
+		bytes -= chunk;
+	}
+
+	return 0;
+}
+
 static int mtk_reg_read(void *context,
 			unsigned int reg, void *_val, size_t bytes)
 {
@@ -74,15 +133,31 @@ static int mtk_efuse_probe(struct platform_device *pdev)
 	if (!priv)
 		return -ENOMEM;
 
-	priv->base = devm_platform_get_and_ioremap_resource(pdev, 0, &res);
-	if (IS_ERR(priv->base))
-		return PTR_ERR(priv->base);
-
 	pdata = device_get_match_data(dev);
+	if (!pdata)
+		return -EINVAL;
+
+	if (pdata->uses_smc) {
+		if (!mtk_efuse_smc_supported()) {
+			dev_err(dev, "SMC read service unavailable\n");
+			return -ENODEV;
+		}
+
+		res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+		if (!res)
+			return -EINVAL;
+
+		dev_info(dev, "secure efuse access, read via SMC\n");
+	} else {
+		priv->base = devm_platform_get_and_ioremap_resource(pdev, 0, &res);
+		if (IS_ERR(priv->base))
+			return PTR_ERR(priv->base);
+	}
+
 	econfig.add_legacy_fixed_of_cells = true;
 	econfig.stride = 1;
 	econfig.word_size = 1;
-	econfig.reg_read = mtk_reg_read;
+	econfig.reg_read = pdata->uses_smc ? mtk_reg_read_smc : mtk_reg_read;
 	econfig.size = resource_size(res);
 	econfig.priv = priv;
 	econfig.dev = dev;
@@ -109,10 +184,16 @@ static const struct mtk_efuse_pdata mtk_efuse_pdata = {
 	.uses_post_processing = false,
 };
 
+static const struct mtk_efuse_pdata mtk_secure_efuse_pdata = {
+	.uses_post_processing = false,
+	.uses_smc = true,
+};
+
 static const struct of_device_id mtk_efuse_of_match[] = {
 	{ .compatible = "mediatek,mt8173-efuse", .data = &mtk_efuse_pdata },
 	{ .compatible = "mediatek,mt8186-efuse", .data = &mtk_mt8186_efuse_pdata },
 	{ .compatible = "mediatek,efuse", .data = &mtk_efuse_pdata },
+	{ .compatible = "mediatek,secure-efuse", .data = &mtk_secure_efuse_pdata },
 	{/* sentinel */},
 };
 MODULE_DEVICE_TABLE(of, mtk_efuse_of_match);
-- 
2.45.2

