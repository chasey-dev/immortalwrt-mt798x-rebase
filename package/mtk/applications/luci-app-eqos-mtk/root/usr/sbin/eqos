#!/bin/sh

DEV_DEFAULT="${DEV_DEFAULT:-br-lan}"
IFB_DEV="${IFB_DEV:-ifb-eqos}"
HNAT_DIR="${HNAT_DIR:-/sys/kernel/debug/hnat}"
NFT="${NFT:-/usr/sbin/nft}"

TABLE_FAMILY="inet"
TABLE_NAME="eqos"
CHAIN_NAME="forward"
SMART_CHAIN_NAME="smart_forward"
BRIDGE_TABLE_NAME="eqos_bridge"
BRIDGE_CHAIN_NAME="postrouting"
SMART_BRIDGE_CHAIN_NAME="smart_ipv6_down"
SMART_PRIORITY=-149
MARK_CLEAR_MASK="0xffff0000"
HNAT_EXCEPTION_MARK="0x99"
HNAT_BIND_THRESHOLD=5
HNAT_RESTART_DELAY=3

QDMA_QUEUE_COUNT=64
QDMA_RATE_MAX=1000000
TOTAL_RATE_MAX=1000
UP_SCH=2
DL_SCH=3
UP_QID_BASE=1
DL_QID_BASE=32
QUEUE_SLOTS=31
TC_SLOT_MAX=65535
PPD_QID=63
MANAGED_QID_LAST=62
DEFAULT_QUEUE_CFG="0 0 0 0 0 0 4"

LEASE_FILE="${EQOS_LEASE_FILE:-/tmp/dhcp.leases}"
STATE_DIR="${EQOS_STATE_DIR:-/tmp/eqos-smart}"
ASSIGNMENT_FILE="$STATE_DIR/assignments"
PENDING_FILE="$STATE_DIR/pending"
DEGRADED_FILE="$STATE_DIR/degraded"
WORKER_LOCK="${EQOS_WORKER_LOCK:-/var/lock/eqos-smart-worker.lock}"
HQOS_OWNER="${EQOS_HQOS_OWNER:-/var/run/eqos-hqos.owner}"
EQOS_INIT="${EQOS_INIT:-/etc/init.d/eqos}"
UCI="${UCI:-/sbin/uci}"
QUIET_SECONDS=2
MAX_WAIT_SECONDS=5

log() {
	logger -t eqos "$*"
}

die() {
	echo "eqos: $*" >&2
	logger -t eqos "$*"
	exit 1
}

is_uinteger() {
	case "$1" in
		''|*[!0-9]*|0[0-9]*) return 1 ;;
	esac

	return 0
}

valid_mode() {
	case "$1" in
		manual|smart) return 0 ;;
		*) return 1 ;;
	esac
}

valid_ipv4_host() {
	local octet IFS=.

	case "$1" in
		''|*[!0-9.]*|.*|*.|*..*) return 1 ;;
	esac

	set -- $1
	[ "$#" -eq 4 ] || return 1
	for octet; do
		[ "${#octet}" -le 3 ] && [ "$octet" -le 255 ] || return 1
	done
}

valid_selector() {
	local family="$1"
	local value="$2"

	[ -n "$value" ] || return 1
	case "$family" in
		ip) case "$value" in *[!0-9./]*) return 1 ;; esac ;;
		ip6) case "$value" in *[!0-9A-Fa-f:./]*) return 1 ;; esac ;;
		*) return 1 ;;
	esac

	printf 'table inet eqos_validate_%s {\n chain c {\n  %s saddr %s counter\n }\n}\n' \
		"$$" "$family" "$value" | "$NFT" --check -f - >/dev/null 2>&1
}

valid_mac() {
	local mac="$1"
	local first

	case "$mac" in
		[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]) ;;
		*) return 1 ;;
	esac

	[ "$mac" != "00:00:00:00:00:00" ] || return 1
	first="${mac%%:*}"
	[ $((0x$first & 1)) -eq 0 ]
}

need_nft() {
	[ -x "$NFT" ] || die "nftables is not available"
}

need_hnat() {
	[ -d "$HNAT_DIR" ] || insmod mtkhnat 2>/dev/null
	[ -d "$HNAT_DIR" ] || die "HNAT debugfs is not available"
}

write_hnat() {
	local node="$1"
	local value="$2"

	[ -w "$HNAT_DIR/$node" ] || die "$HNAT_DIR/$node is not writable"
	printf '%s' "$value" > "$HNAT_DIR/$node" ||
		die "failed to write $HNAT_DIR/$node"
}

# Same write, but for teardown steps that must not abort the rest of the
# cleanup: a node we cannot restore is worth a log line, not a failed stop.
try_write_hnat() {
	local node="$1"
	local value="$2"

	if [ ! -w "$HNAT_DIR/$node" ]; then
		log "$HNAT_DIR/$node is not writable; leaving it unchanged"
		return 0
	fi
	printf '%s' "$value" > "$HNAT_DIR/$node" ||
		log "failed to write $HNAT_DIR/$node"
	return 0
}

need_qdma_layout() {
	need_hnat

	for node in qdma_sch$UP_SCH qdma_sch$DL_SCH \
		qdma_txq$UP_QID_BASE qdma_txq$DL_QID_BASE qdma_txq$MANAGED_QID_LAST; do
		[ -w "$HNAT_DIR/$node" ] || die "$HNAT_DIR/$node is not writable"
	done

	[ -e "$HNAT_DIR/qdma_txq0" ] ||
		die "qid0 is missing; expected $QDMA_QUEUE_COUNT-QDMA NETSYS layout"
	[ -e "$HNAT_DIR/qdma_txq$PPD_QID" ] ||
		die "qid$PPD_QID is missing; expected PPD-reserved queue"
}

stop_qos() {
	local dev="$1"
	local have_ifb=0

	[ ! -d "/sys/class/net/$IFB_DEV" ] || have_ifb=1

	if tc qdisc show dev "$dev" 2>/dev/null | grep -q "qdisc htb 1:"; then
		tc qdisc del dev "$dev" root 2>/dev/null
	fi
	[ "$have_ifb" -eq 1 ] || return 0

	tc qdisc del dev "$dev" ingress 2>/dev/null
	tc qdisc del dev "$IFB_DEV" root 2>/dev/null
	ip link del dev "$IFB_DEV" 2>/dev/null
}

start_qos() {
	local dev="$1"
	local dl="$2"
	local up="$3"
	local root_qdisc

	root_qdisc="$(tc qdisc show dev "$dev" 2>/dev/null | sed -n '/ root /p')"
	case "$root_qdisc" in
		''|qdisc\ noqueue\ 0:*|qdisc\ noop\ 0:*) ;;
		*)
			echo "eqos: $dev already has a root qdisc" >&2
			return 1
			;;
	esac

	if tc qdisc show dev "$dev" 2>/dev/null |
	   grep -Eq 'qdisc (ingress|clsact) '; then
		echo "eqos: $dev already has an ingress qdisc" >&2
		return 1
	fi

	ip link add "$IFB_DEV" type ifb || return 1

	if ! ip link set dev "$IFB_DEV" up ||
	   ! tc qdisc add dev "$dev" root handle 1: htb ||
	   ! tc class add dev "$dev" parent 1: classid 1:1 htb rate "${dl}mbit" ||
	   ! tc qdisc add dev "$IFB_DEV" root handle 1: htb ||
	   ! tc class add dev "$IFB_DEV" parent 1: classid 1:1 htb rate "${up}mbit" ||
	   ! tc qdisc add dev "$dev" ingress ||
	   ! tc filter add dev "$dev" parent ffff: protocol ip pref 1 u32 \
		match u32 0 0 action mirred egress redirect dev "$IFB_DEV" ||
	   ! tc filter add dev "$dev" parent ffff: protocol ipv6 pref 2 u32 \
		match u32 0 0 action mirred egress redirect dev "$IFB_DEV"; then
		stop_qos "$dev"
		return 1
	fi
}

nft_stop() {
	need_nft
	"$NFT" delete table "$TABLE_FAMILY" "$TABLE_NAME" 2>/dev/null || true
	"$NFT" delete table bridge "$BRIDGE_TABLE_NAME" 2>/dev/null || true
}

nft_start() {
	local dev="$1"

	need_nft
	nft_stop

	"$NFT" -f - <<EOF || return 1
table $TABLE_FAMILY $TABLE_NAME {
	chain $CHAIN_NAME {
		type filter hook forward priority mangle; policy accept;
	}
}
EOF

	"$NFT" add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
		iifname "$dev" meta mark != "$HNAT_EXCEPTION_MARK" \
		meta mark set meta mark '&' "$MARK_CLEAR_MASK" || return 1
	"$NFT" add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
		oifname "$dev" meta mark != "$HNAT_EXCEPTION_MARK" \
		meta mark set meta mark '&' "$MARK_CLEAR_MASK" || return 1
}

nft_smart_start() {
	local dev="$1"
	local batch="/tmp/eqos-smart-start.$$"

	need_nft
	nft_stop
	umask 077
	cat > "$batch" <<EOF || return 1
table $TABLE_FAMILY $TABLE_NAME {
	chain $CHAIN_NAME {
		type filter hook forward priority $SMART_PRIORITY; policy accept;
		iifname "$dev" meta nfproto ipv4 ip dscp set 0
		oifname "$dev" meta nfproto ipv4 ip dscp set 0
		iifname "$dev" meta nfproto ipv6 ip6 dscp set 0
		oifname "$dev" meta nfproto ipv6 ip6 dscp set 0
		iifname "$dev" meta mark != $HNAT_EXCEPTION_MARK meta mark set meta mark & $MARK_CLEAR_MASK
		oifname "$dev" meta mark != $HNAT_EXCEPTION_MARK meta mark set meta mark & $MARK_CLEAR_MASK
		jump $SMART_CHAIN_NAME
	}

	chain $SMART_CHAIN_NAME {
	}
}

table bridge $BRIDGE_TABLE_NAME {
	chain $BRIDGE_CHAIN_NAME {
		type filter hook postrouting priority $SMART_PRIORITY; policy accept;
		jump $SMART_BRIDGE_CHAIN_NAME
	}

	chain $SMART_BRIDGE_CHAIN_NAME {
	}
}
EOF

	if ! "$NFT" --check -f "$batch" || ! "$NFT" -f "$batch"; then
		rm -f "$batch"
		return 1
	fi
	rm -f "$batch"
}

reset_hnat_qdma() {
	local i

	need_qdma_layout
	write_hnat "qdma_sch$UP_SCH" "0 wrr 0"
	write_hnat "qdma_sch$DL_SCH" "0 wrr 0"

	i=$UP_QID_BASE
	while [ "$i" -le "$MANAGED_QID_LAST" ]; do
		write_hnat "qdma_txq$i" "$DEFAULT_QUEUE_CFG"
		i=$((i + 1))
	done
}

start_hnat_qos() {
	local dl="$1"
	local up="$2"

	need_qdma_layout
	write_hnat "qos_toggle" "1"
	reset_hnat_qdma
	write_hnat "qdma_sch$UP_SCH" "1 wrr $((up * 1000))"
	write_hnat "qdma_sch$DL_SCH" "1 wrr $((dl * 1000))"
}

stop_hnat_qos() {
	local bind_rate
	[ -d "$HNAT_DIR" ] || return 0

	need_qdma_layout
	write_hnat "qos_toggle" "0"
	reset_hnat_qdma
	# Restore the platform configuration without modifying its persistent UCI state.
	bind_rate="$("$UCI" -q get turboacc.config.fastpath_mh_bind_rate)"
	if ! is_uinteger "$bind_rate" || [ "$bind_rate" -lt 1 ] || [ "$bind_rate" -gt 65535 ]; then
		bind_rate=30
	fi
	try_write_hnat "hnat_setting" "1 $bind_rate"
}

enable_hnat() {
	local hook_state

	need_hnat
	hook_state="$(cat "$HNAT_DIR/hook_toggle")"
	case "$hook_state" in
		enabled)
			write_hnat "hook_toggle" "0"
			[ "$(cat "$HNAT_DIR/hook_toggle")" = "disabled" ] ||
				die "failed to disable HNAT hooks"
			# hnat_disable_hook() restores PPE build mode on a three-second timer.
			sleep "$HNAT_RESTART_DELAY"
			;;
		disabled) ;;
		*) die "invalid HNAT hook state: $hook_state" ;;
	esac

	write_hnat "hook_toggle" "1"
	[ "$(cat "$HNAT_DIR/hook_toggle")" = "enabled" ] ||
		die "failed to enable HNAT hooks"
	write_hnat "hnat_setting" "1 $HNAT_BIND_THRESHOLD"

}

ensure_tc_qos() {
	local dev="$1"
	local dl="$2"
	local up="$3"

	[ -n "$dl" ] || dl="$(uci -q get eqos.config.download)"
	[ -n "$up" ] || up="$(uci -q get eqos.config.upload)"
	is_uinteger "$dl" || die "download rate must be an integer"
	is_uinteger "$up" || die "upload rate must be an integer"
	[ "$dl" -gt 0 ] || die "download rate must be greater than 0"
	[ "$up" -gt 0 ] || die "upload rate must be greater than 0"
	[ "$dl" -le "$TOTAL_RATE_MAX" ] && [ "$up" -le "$TOTAL_RATE_MAX" ] ||
		die "total rate must not exceed $TOTAL_RATE_MAX Mbit/s"

	if tc qdisc show dev "$dev" 2>/dev/null | grep -q "qdisc htb 1:" &&
	   tc qdisc show dev "$IFB_DEV" 2>/dev/null | grep -q "qdisc htb 1:"; then
		return 0
	fi

	stop_qos "$dev"
	start_qos "$dev" "$dl" "$up"
}

program_queue() {
	local qid="$1"
	local sch="$2"
	local rate="$3"

	[ "$rate" -eq 0 ] && return 0
	write_hnat "qdma_txq$qid" "$sch 0 0 1 $rate 4 1"
}

program_smart_queues() {
	local dl="$1"
	local up="$2"
	local slot up_min dl_min up_max dl_max

	is_uinteger "$dl" || die "download rate must be an integer"
	is_uinteger "$up" || die "upload rate must be an integer"
	[ "$dl" -gt 0 ] && [ "$dl" -le "$TOTAL_RATE_MAX" ] ||
		die "download rate must be between 1 and $TOTAL_RATE_MAX Mbit/s"
	[ "$up" -gt 0 ] && [ "$up" -le "$TOTAL_RATE_MAX" ] ||
		die "upload rate must be between 1 and $TOTAL_RATE_MAX Mbit/s"
	need_qdma_layout

	up_min=$((up * 225))
	dl_min=$((dl * 200))
	up_max=$((up * 1000))
	dl_max=$((dl * 1000))
	slot=1
	while [ "$slot" -le "$QUEUE_SLOTS" ]; do
		write_hnat "qdma_txq$slot" "$UP_SCH 1 $up_min 1 $up_max 4 1"
		write_hnat "qdma_txq$((slot + QUEUE_SLOTS))" "$DL_SCH 1 $dl_min 1 $dl_max 4 1"
		slot=$((slot + 1))
	done
}

# Emit and commit the classification rules for the current leases. This runs
# in the same process that produced and validated them, so the rows do not
# need a second round of validation on the way in.
smart_apply_rules() {
	local leases="$1"
	local assignments="$2"
	local batch="$STATE_DIR/rules.$$"
	local seen_macs="$STATE_DIR/rulemacs.$$"
	local mac ip slot down_qid

	need_nft
	"$NFT" list chain "$TABLE_FAMILY" "$TABLE_NAME" "$SMART_CHAIN_NAME" >/dev/null 2>&1 ||
		die "smart inet chain is not initialized"
	"$NFT" list chain bridge "$BRIDGE_TABLE_NAME" "$SMART_BRIDGE_CHAIN_NAME" >/dev/null 2>&1 ||
		die "smart bridge chain is not initialized"

	umask 077
	: > "$seen_macs" || die "failed to create rule state"
	if ! cat > "$batch" <<EOF
flush chain $TABLE_FAMILY $TABLE_NAME $SMART_CHAIN_NAME
flush chain bridge $BRIDGE_TABLE_NAME $SMART_BRIDGE_CHAIN_NAME
EOF
	then
		rm -f "$seen_macs" "$batch"
		die "failed to create nft batch"
	fi

	while IFS="	" read -r mac ip; do
		slot="$(awk -F '\t' -v want="$mac" '$1 == want { print $2; exit }' "$assignments")"
		[ -n "$slot" ] || {
			rm -f "$seen_macs" "$batch"
			die "no slot assigned for $mac"
		}
		down_qid=$((slot + QUEUE_SLOTS))
		# Keep the 6.6 wire DSCP values; rebase uses a different downlink QID base.
		cat >> "$batch" <<EOF
add rule $TABLE_FAMILY $TABLE_NAME $SMART_CHAIN_NAME iifname "$DEV_DEFAULT" ip saddr $ip meta mark != $HNAT_EXCEPTION_MARK ip dscp set $slot meta mark set (meta mark & $MARK_CLEAR_MASK) | $slot counter comment "eqos-smart-ip4-up-$mac"
add rule $TABLE_FAMILY $TABLE_NAME $SMART_CHAIN_NAME oifname "$DEV_DEFAULT" ip daddr $ip meta mark != $HNAT_EXCEPTION_MARK ip dscp set $((slot + 32)) meta mark set (meta mark & $MARK_CLEAR_MASK) | $down_qid counter comment "eqos-smart-ip4-down-$mac"
EOF

		grep -Fqx "$mac" "$seen_macs" && continue
		printf '%s\n' "$mac" >> "$seen_macs"
		cat >> "$batch" <<EOF
add rule $TABLE_FAMILY $TABLE_NAME $SMART_CHAIN_NAME iifname "$DEV_DEFAULT" meta nfproto ipv6 ether saddr $mac meta mark != $HNAT_EXCEPTION_MARK meta mark set (meta mark & $MARK_CLEAR_MASK) | $slot counter comment "eqos-smart-ip6-up-$mac"
add rule bridge $BRIDGE_TABLE_NAME $SMART_BRIDGE_CHAIN_NAME ether type ip6 ether daddr $mac meta mark != $HNAT_EXCEPTION_MARK meta mark set (meta mark & $MARK_CLEAR_MASK) | $down_qid counter comment "eqos-smart-ip6-down-$mac"
EOF
	done < "$leases"

	if ! "$NFT" --check -f "$batch" || ! "$NFT" -f "$batch"; then
		rm -f "$seen_macs" "$batch"
		die "failed to commit smart nft rules"
	fi

	rm -f "$seen_macs" "$batch"
}

tc_filter_rule() {
	local dir="$1"
	local family="$2"
	local value="$3"
	local pref="$4"
	local classid="$5"
	local dev="$6"
	local tcdev key

	[ -n "$value" ] || return 0

	case "$dir" in
		up)
			tcdev="$IFB_DEV"
			key="src"
			;;
		dl)
			tcdev="$dev"
			key="dst"
			;;
		*)
			return 1
			;;
	esac

	case "$family" in
		ip)
			tc filter add dev "$tcdev" parent 1: protocol ip pref "$pref" u32 \
				match ip "$key" "$value" flowid "1:$classid"
			;;
		ip6)
			tc filter add dev "$tcdev" parent 1: protocol ipv6 pref "$pref" u32 \
				match ip6 "$key" "$value" flowid "1:$classid"
			;;
		*)
			return 1
			;;
	esac
}

program_tc_queue() {
	local dir="$1"
	local slot="$2"
	local rate="$3"
	local ip4="$4"
	local ip6="$5"
	local dev="$6"
	local classid tcdev

	[ "$rate" -eq 0 ] && return 0
	[ -n "$ip4$ip6" ] ||
		die "software tc queue requires an IPv4 or IPv6 selector"

	case "$dir" in
		up) tcdev="$IFB_DEV" ;;
		dl) tcdev="$dev" ;;
		*) return 1 ;;
	esac

	classid="$(printf '%x\n' "$slot")"
	tc class replace dev "$tcdev" parent 1:1 classid "1:$classid" \
		htb rate "${rate}kbit" ceil "${rate}kbit" || return 1
	tc_filter_rule "$dir" ip "$ip4" "$slot" "$classid" "$dev" || return 1
	tc_filter_rule "$dir" ip6 "$ip6" "$slot" "$classid" "$dev" || return 1
}

nft_mark_rule() {
	local dir="$1"
	local family="$2"
	local value="$3"
	local qid="$4"
	local addr

	[ -n "$value" ] || return 0

	case "$dir" in
		up) addr="saddr" ;;
		dl) addr="daddr" ;;
		*)
			return 1
			;;
	esac

	case "$family" in
		ip)
			"$NFT" add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
				ip "$addr" "$value" \
				meta mark != "$HNAT_EXCEPTION_MARK" \
				meta mark set "$qid"
			;;
		ip6)
			"$NFT" add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
				ip6 "$addr" "$value" \
				meta mark != "$HNAT_EXCEPTION_MARK" \
				meta mark set "$qid"
			;;
		*)
			return 1
			;;
	esac
}

nft_exception_rule() {
	local dir="$1"
	local family="$2"
	local value="$3"
	local addr

	[ -n "$value" ] || return 0

	case "$dir" in
		up) addr="saddr" ;;
		dl) addr="daddr" ;;
		*)
			return 1
			;;
	esac

	case "$family" in
		ip)
			"$NFT" add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
				ip "$addr" "$value" \
				meta mark set "$HNAT_EXCEPTION_MARK"
			;;
		ip6)
			"$NFT" add rule "$TABLE_FAMILY" "$TABLE_NAME" "$CHAIN_NAME" \
				ip6 "$addr" "$value" \
				meta mark set "$HNAT_EXCEPTION_MARK"
			;;
		*)
			return 1
			;;
	esac
}

add_rule() {
	local slot="$1"
	local dl="$2"
	local up="$3"
	local ip4="$4"
	local ip6="$5"
	local total_dl="$6"
	local total_up="$7"
	local dev="$DEV_DEFAULT"
	local up_qid dl_qid

	is_uinteger "$slot" || die "queue slot must be an integer"
	is_uinteger "$dl" || die "download rate must be an integer"
	is_uinteger "$up" || die "upload rate must be an integer"

	[ "$slot" -ge 1 ] && [ "$slot" -le "$TC_SLOT_MAX" ] ||
		die "queue slot must be between 1 and $TC_SLOT_MAX"
	[ "$dl" -le "$QDMA_RATE_MAX" ] && [ "$up" -le "$QDMA_RATE_MAX" ] ||
		die "device rate must not exceed $QDMA_RATE_MAX kbit/s"
	[ "$dl" -ne 0 ] || [ "$up" -ne 0 ] || return 0

	need_qdma_layout

	if [ "$slot" -gt "$QUEUE_SLOTS" ]; then
		ensure_tc_qos "$dev" "$total_dl" "$total_up" || return 1
		program_tc_queue up "$slot" "$up" "$ip4" "$ip6" "$dev" || return 1
		program_tc_queue dl "$slot" "$dl" "$ip4" "$ip6" "$dev" || return 1

		if [ "$up" -ne 0 ]; then
			nft_exception_rule up ip "$ip4" || return 1
			nft_exception_rule up ip6 "$ip6" || return 1
		fi

		if [ "$dl" -ne 0 ]; then
			nft_exception_rule dl ip "$ip4" || return 1
			nft_exception_rule dl ip6 "$ip6" || return 1
		fi

		return 0
	fi

	up_qid="$slot"
	dl_qid=$((slot + QUEUE_SLOTS))

	program_queue "$up_qid" "$UP_SCH" "$up" || return 1
	program_queue "$dl_qid" "$DL_SCH" "$dl" || return 1

	if [ "$up" -ne 0 ]; then
		nft_mark_rule up ip "$ip4" "$up_qid" || return 1
		nft_mark_rule up ip6 "$ip6" "$up_qid" || return 1
	fi

	if [ "$dl" -ne 0 ]; then
		nft_mark_rule dl ip "$ip4" "$dl_qid" || return 1
		nft_mark_rule dl ip6 "$ip6" "$dl_qid" || return 1
	fi

}

add_inferred_rule() {
	local slot="$1"
	local dl="$2"
	local up="$3"
	local selector="$4"
	local total_dl="$5"
	local total_up="$6"
	local ip4 ip6

	[ -n "$selector" ] || die "selector is required"
	need_nft

	if valid_selector ip "$selector"; then
		ip4="$selector"
	elif valid_selector ip6 "$selector"; then
		ip6="$selector"
	else
		die "selector must be an IPv4 or IPv6 address"
	fi

	add_rule "$slot" "$dl" "$up" "$ip4" "$ip6" "$total_dl" "$total_up"
}

start_all() {
	local dl="$1"
	local up="$2"
	local mode="${3:-manual}"
	local dev="$DEV_DEFAULT"

	valid_mode "$mode" || die "mode must be manual or smart"

	is_uinteger "$dl" || die "download rate must be an integer"
	is_uinteger "$up" || die "upload rate must be an integer"
	[ "$dl" -gt 0 ] || die "download rate must be greater than 0"
	[ "$up" -gt 0 ] || die "upload rate must be greater than 0"
	[ "$dl" -le "$TOTAL_RATE_MAX" ] && [ "$up" -le "$TOTAL_RATE_MAX" ] ||
		die "total rate must not exceed $TOTAL_RATE_MAX Mbit/s"

	need_qdma_layout
	stop_qos "$dev"
	nft_stop
	start_hnat_qos "$dl" "$up"
	case "$mode" in
		manual)
			nft_start "$dev" || die "failed to configure nftables"
			;;
		smart)
			nft_smart_start "$dev" || die "failed to configure smart nftables"
			program_smart_queues "$dl" "$up"
			smart_rebuild 1
			;;
	esac
}

stop_all() {
	local dev="$DEV_DEFAULT"

	stop_qos "$dev"
	nft_stop
	stop_hnat_qos
}

prepare_state_dir() {
	umask 077
	mkdir -p "$STATE_DIR" /var/lock || return 1
}

normalize_leases() {
	local output="$1"
	local expiry mac ip rest normalized

	local raw="${output}.raw"

	[ -r "$LEASE_FILE" ] || return 1
	: > "$raw" || return 1

	while read -r expiry mac ip rest; do
		[ -n "$expiry" ] && [ -n "$mac" ] && [ -n "$ip" ] || continue
		normalized="$(printf '%s\n' "$mac" | tr 'A-F' 'a-f')"
		if ! valid_mac "$normalized" || ! valid_ipv4_host "$ip"; then
			log "ignoring invalid DHCP lease: $mac $ip"
			continue
		fi
		printf '%s\t%s\n' "$normalized" "$ip" >> "$raw" || return 1
	done < "$LEASE_FILE"

	# Never use "sort -o": BusyBox parses the option unconditionally but only
	# implements the output redirect under FEATURE_SORT_BIG, which this target
	# does not enable. It then exits 0, leaves the file untouched and prints
	# the sorted result to stdout.
	sort -u "$raw" > "$output" || {
		rm -f "$raw"
		return 1
	}
	rm -f "$raw"

	awk -F '\t' '
		seen[$2] && seen[$2] != $1 { exit 1 }
		{ seen[$2] = $1 }
	' "$output"
}

validate_assignments() {
	local file="$1"
	local mac slot extra normalized
	local seen="$STATE_DIR/seen.$$"

	: > "$seen" || return 1
	while IFS="	" read -r mac slot extra; do
		[ -n "$mac" ] && [ -n "$slot" ] && [ -z "$extra" ] || {
			rm -f "$seen"
			return 1
		}
		normalized="$(printf '%s\n' "$mac" | tr 'A-F' 'a-f')"
		[ "$normalized" = "$mac" ] && valid_mac "$mac" || {
			rm -f "$seen"
			return 1
		}
		case "$slot" in
			''|*[!0-9]*) rm -f "$seen"; return 1 ;;
		esac
		[ "$slot" -ge 1 ] && [ "$slot" -le "$QUEUE_SLOTS" ] || {
			rm -f "$seen"
			return 1
		}
		grep -Fqx "$mac" "$seen" && {
			rm -f "$seen"
			return 1
		}
		printf '%s\n' "$mac" >> "$seen" || {
			rm -f "$seen"
			return 1
		}
	done < "$file"
	rm -f "$seen"
}

allocate_slot() {
	local mac="$1"
	local assignments="$2"
	local hex base slot attempts=0

	hex="$(printf '%s' "$mac" | tr -d ':')"
	base=$((0x$hex % QUEUE_SLOTS + 1))
	slot="$base"
	while [ "$attempts" -lt "$QUEUE_SLOTS" ]; do
		if ! grep -Eq "[[:space:]]${slot}$" "$assignments"; then
			echo "$slot"
			return 0
		fi
		slot=$((slot % QUEUE_SLOTS + 1))
		attempts=$((attempts + 1))
	done

	# All dedicated slots are occupied. Preserve existing assignments and
	# deterministically share this host's hash origin.
	echo "$base"
}

reconcile_assignments() {
	local leases="$1"
	local output="$2"
	local initial="$3"
	local mac slot
	local macs="$STATE_DIR/macs.$$"
	local preserved="$STATE_DIR/preserved.$$"

	cut -f1 "$leases" | sort -u > "$macs" || return 1
	: > "$preserved" || return 1

	if [ "$initial" -eq 0 ] && [ -e "$ASSIGNMENT_FILE" ]; then
		if ! validate_assignments "$ASSIGNMENT_FILE"; then
			rm -f "$macs" "$preserved"
			return 2
		fi
		while IFS="	" read -r mac slot; do
			grep -Fqx "$mac" "$macs" || continue
			printf '%s\t%s\n' "$mac" "$slot" >> "$preserved" || return 1
		done < "$ASSIGNMENT_FILE"
	fi

	sort -u "$preserved" > "$output" || return 1
	while read -r mac; do
		[ -n "$mac" ] || continue
		grep -Eq "^${mac}[[:space:]]" "$output" && continue
		slot="$(allocate_slot "$mac" "$output")" || return 1
		printf '%s\t%s\n' "$mac" "$slot" >> "$output" || return 1
	done < "$macs"
	sort "$output" > "$preserved" || return 1
	mv -f "$preserved" "$output" || return 1
	rm -f "$macs" "$preserved"
}

worker() {
	local first now token current

	prepare_state_dir || exit 1
	exec 9>"$WORKER_LOCK" || exit 1
	flock 9 || exit 1

	while [ -e "$PENDING_FILE" ]; do
		first="$(date +%s)"
		while :; do
			token="$(cat "$PENDING_FILE" 2>/dev/null)"
			[ -n "$token" ] || break
			sleep "$QUIET_SECONDS"
			current="$(cat "$PENDING_FILE" 2>/dev/null)"
			now="$(date +%s)"
			[ "$current" = "$token" ] && break
			[ $((now - first)) -ge "$MAX_WAIT_SECONDS" ] && break
		done

		[ -e "$PENDING_FILE" ] || continue
		rm -f "$PENDING_FILE" || continue
		"$EQOS_INIT" smart_rebuild || log "scheduled rebuild failed"
	done
}

schedule() {
	local token

	[ "$($UCI -q get eqos.config.enabled)" = 1 ] || return 0
	[ "$($UCI -q get eqos.config.smarthqos)" = 1 ] || return 0
	[ "$(cat "$HQOS_OWNER" 2>/dev/null)" = smart ] || return 0
	prepare_state_dir || die "failed to create runtime state"
	token="$(date +%s).$$"
	printf '%s\n' "$token" > "${PENDING_FILE}.$$" || die "failed to queue rebuild"
	mv -f "${PENDING_FILE}.$$" "$PENDING_FILE" || die "failed to publish rebuild request"

	(
		exec </dev/null >>"$STATE_DIR/worker.log" 2>&1
		worker
	) &
}

# Rebuild the whole lease->slot mapping and the rules derived from it.
# initial=1 is the boot path driven by start_all(), where no owner has been
# published yet; initial=0 is the DHCP-driven path.
smart_rebuild() {
	local initial="${1:-0}"
	local leases assignments ret

	if [ "$initial" -eq 1 ]; then
		# The lifecycle lock is held by /etc/init.d/eqos around the whole
		# start sequence; an owner already being published means smart mode
		# is running and a from-scratch rebuild would discard slot stability.
		[ ! -e "$HQOS_OWNER" ] || die "initial rebuild requires no published owner"
	else
		[ "$(cat "$HQOS_OWNER" 2>/dev/null)" = smart ] ||
			die "dynamic rebuild requires smart ownership"
		[ ! -e "$DEGRADED_FILE" ] ||
			die "runtime state is degraded; reload EQoS to recover"
	fi

	prepare_state_dir || die "failed to create runtime state"
	leases="$STATE_DIR/leases.$$"
	assignments="$STATE_DIR/assignments.$$"
	trap 'rm -f "$leases" "$assignments"' EXIT INT TERM

	normalize_leases "$leases" || die "failed to normalize DHCP leases"
	reconcile_assignments "$leases" "$assignments" "$initial"
	ret=$?
	if [ "$ret" -eq 2 ]; then
		printf '%s\n' "invalid runtime assignments" > "$DEGRADED_FILE"
		die "runtime assignments are invalid; reload EQoS to recover"
	elif [ "$ret" -ne 0 ]; then
		die "failed to reconcile runtime assignments"
	fi

	smart_apply_rules "$leases" "$assignments"

	if ! mv -f "$assignments" "$ASSIGNMENT_FILE"; then
		printf '%s\n' "assignment commit failed after nft commit" > "$DEGRADED_FILE"
		die "failed to publish runtime assignments; reload EQoS to recover"
	fi
	rm -f "$DEGRADED_FILE"
	trap - EXIT INT TERM
	rm -f "$leases"
}

usage() {
	cat <<EOF
Usage: $0 <command> [options]

Commands:
  start <download_mbit> <upload_mbit> [manual|smart]
  smart-rebuild                 rebuild lease mappings (smart mode)
  smart-schedule                queue a debounced rebuild (DHCP hotplug)
  smart-clear                   drop smart runtime state
  add <slot> <download_kbit> <upload_kbit> <ipv4|ipv6> [total_down_mbit] [total_up_mbit]
  enable
  stop

Run enable once after all add commands.

Queue slots 1-31 use the common NETSYS V2/V3 64-QDMA layout. EQoS keeps
qid0 as the default unclassified queue, uses qid1-31 for upload and
qid32-62 for download, and keeps qid63 free for the PPD path. Slots 32
and above use tc software shaping with an IPv4 or IPv6 selector.
EOF
}

case "$1" in
	start)
		shift
		start_all "$@"
		;;
	stop)
		shift
		stop_all "$@"
		;;
	add)
		shift
		add_inferred_rule "$@"
		;;
	check-selector)
		shift
		[ "$#" -eq 2 ] || die "check-selector requires family and value"
		need_nft
		valid_selector "$1" "$2" || die "invalid $1 selector: $2"
		;;
	smart-rebuild)
		shift
		[ "$#" -eq 0 ] || die "smart-rebuild takes no arguments"
		smart_rebuild 0
		;;
	smart-schedule)
		shift
		[ "$#" -eq 0 ] || die "smart-schedule takes no arguments"
		schedule
		;;
	smart-clear)
		shift
		[ "$#" -eq 0 ] || die "smart-clear takes no arguments"
		rm -rf "$STATE_DIR"
		;;
	enable)
		shift
		[ "$#" -eq 0 ] || die "enable takes no arguments"
		enable_hnat
		;;
	*)
		usage
		exit 1
		;;
esac
