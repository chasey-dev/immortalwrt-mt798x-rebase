+
+#ifdef CONFIG_IEEE80211R_AP
+static int nl80211_mtk_set_ftie(struct i802_bss *bss,
+				struct wpa_driver_ap_params *params)
+{
+	struct ap_11r_params ft_params;
+	struct nl_msg *msg;
+	struct nlattr *data;
+	int ret;
+
+	if (!params->mtk_ft_nas_identifier_len)
+		return 0;
+
+	if (params->mtk_ft_nas_identifier_len >
+	    sizeof(ft_params.nas_identifier))
+		return -EINVAL;
+
+	os_memset(&ft_params, 0, sizeof(ft_params));
+	ft_params.nas_id_len = params->mtk_ft_nas_identifier_len;
+	os_memcpy(ft_params.nas_identifier, params->mtk_ft_nas_identifier,
+		  params->mtk_ft_nas_identifier_len);
+	os_memcpy(ft_params.r1_key_holder, params->mtk_ft_r1_key_holder,
+		  ETH_ALEN);
+	os_memcpy(ft_params.own_mac, params->mtk_ft_own_mac, ETH_ALEN);
+	ft_params.reassociation_deadline =
+		params->mtk_ft_reassociation_deadline;
+
+	wpa_printf(MSG_INFO,
+		   "nl80211: MTK set FTIE ifname=%s nas_id_len=%d r1kh="
+		   MACSTR " own=" MACSTR " reassoc_deadline=%u",
+		   bss->ifname, ft_params.nas_id_len,
+		   MAC2STR(ft_params.r1_key_holder),
+		   MAC2STR(ft_params.own_mac),
+		   ft_params.reassociation_deadline);
+
+	msg = nl80211_bss_msg(bss, 0, NL80211_CMD_VENDOR);
+	if (!msg ||
+	    nla_put_u32(msg, NL80211_ATTR_VENDOR_ID, MTK_NL80211_VENDOR_ID) ||
+	    nla_put_u32(msg, NL80211_ATTR_VENDOR_SUBCMD,
+			MTK_NL80211_VENDOR_SUBCMD_SET_FT) ||
+	    !(data = nla_nest_start(msg, NL80211_ATTR_VENDOR_DATA)) ||
+	    nla_put(msg, MTK_NL80211_VENDOR_ATTR_SET_FTIE,
+		    sizeof(ft_params), &ft_params))
+		goto fail;
+
+	nla_nest_end(msg, data);
+
+	ret = send_and_recv_cmd(bss->drv, msg);
+	if (ret)
+		wpa_printf(MSG_INFO,
+			   "nl80211: MTK failed to set FTIE ifname=%s ret=%d (%s)",
+			   bss->ifname, ret, strerror(-ret));
+
+	return ret;
+
+fail:
+	nlmsg_free(msg);
+	return -ENOBUFS;
+}
+#endif /* CONFIG_IEEE80211R_AP */
 #endif /* CONFIG_DRIVER_NL80211_MTK */
 
 
