+#endif /* CONFIG_IEEE80211BE && CONFIG_DRIVER_NL80211_MTK */
+
 	hapd = iface->bss[0];
 
 	hostapd_tx_queue_params(iface);
@@ -3195,6 +3209,377 @@ static void hostapd_bss_alloc_link_id(st
 	wpa_printf(MSG_DEBUG, "AP MLD: %s: Link ID %d assigned.",
 		   hapd->mld->name, hapd->mld_link_id);
 }
+
+
+bool hostapd_is_mtk_private_mld(struct hostapd_data *hapd)
+{
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	return hapd && hapd->conf && hapd->conf->mtk_private_mld;
+#else /* CONFIG_DRIVER_NL80211_MTK */
+	return false;
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+}
+
+
+bool hostapd_has_mtk_bss_mlo_info(struct hostapd_data *hapd)
+{
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	return hapd && hapd->conf && hapd->mtk_mld_group_idx &&
+		hapd->mld_link_id < MAX_NUM_MLD_LINKS &&
+		!is_zero_ether_addr(hapd->conf->mld_addr);
+#else /* CONFIG_DRIVER_NL80211_MTK */
+	return false;
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+}
+
+
+static int hostapd_update_mtk_bss_mlo_info(struct hostapd_data *hapd,
+					    u8 group_idx, u8 link_id,
+					    const u8 *mld_addr)
+{
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	struct hapd_interfaces *interfaces;
+	const char *ifname;
+	bool is_private;
+	bool is_changed;
+	size_t i, j;
+
+	ifname = hapd->conf->iface;
+	is_private = hostapd_is_mtk_private_mld(hapd);
+
+	if (!group_idx) {
+		wpa_printf(MSG_ERROR,
+			   "MTK BSS MLO: refuse update without driver group: iface=%s",
+			   ifname);
+		return -1;
+	}
+
+	if (link_id >= MAX_NUM_MLD_LINKS || !mld_addr ||
+	    is_zero_ether_addr(mld_addr))
+		return -1;
+
+	if (hapd->mtk_mld_group_idx &&
+	    hapd->mtk_mld_group_idx != group_idx && is_private) {
+		wpa_printf(MSG_ERROR,
+			   "MTK private MLD: refuse group change: "
+			   "iface=%s cached_group=%u driver_group=%u",
+			   ifname, hapd->mtk_mld_group_idx, group_idx);
+		return -1;
+	}
+
+	interfaces = hapd->iface ? hapd->iface->interfaces : NULL;
+	if (is_private && interfaces) {
+		for (i = 0; i < interfaces->count; i++) {
+			struct hostapd_iface *iface = interfaces->iface[i];
+
+			if (!iface)
+				continue;
+
+			for (j = 0; j < iface->num_bss; j++) {
+				struct hostapd_data *bss = iface->bss[j];
+
+				if (!bss || bss == hapd ||
+				    !hostapd_is_mtk_private_mld(bss))
+					continue;
+
+				if (!bss->mtk_mld_group_idx ||
+				    is_zero_ether_addr(bss->conf->mld_addr))
+					continue;
+
+				if (bss->mtk_mld_group_idx == group_idx) {
+					if (!ether_addr_equal(bss->conf->mld_addr,
+							      mld_addr)) {
+						wpa_printf(MSG_ERROR,
+							   "MTK private MLD: refuse conflicting group member: "
+							   "iface=%s group=%u mld_addr=" MACSTR
+							   " partner_iface=%s"
+							   " partner_mld_addr=" MACSTR,
+							   ifname, group_idx, MAC2STR(mld_addr),
+							   bss->conf->iface,
+							   MAC2STR(bss->conf->mld_addr));
+						return -1;
+					}
+
+					if (bss->mld_link_id == link_id) {
+						wpa_printf(MSG_ERROR,
+							   "MTK private MLD: refuse duplicate link ID: "
+							   "iface=%s group=%u link_id=%u partner_iface=%s",
+							   ifname, group_idx, link_id,
+							   bss->conf->iface);
+						return -1;
+					}
+
+					continue;
+				}
+
+				if (ether_addr_equal(bss->conf->mld_addr,
+						     mld_addr)) {
+					wpa_printf(MSG_ERROR,
+						   "MTK private MLD: refuse duplicate MLD address: "
+						   "iface=%s group=%u mld_addr=" MACSTR
+						   " partner_iface=%s partner_group=%u",
+						   ifname, group_idx, MAC2STR(mld_addr),
+						   bss->conf->iface, bss->mtk_mld_group_idx);
+					return -1;
+				}
+			}
+		}
+	}
+
+	is_changed = hapd->mtk_mld_group_idx != group_idx ||
+		hapd->mld_link_id != link_id ||
+		is_zero_ether_addr(hapd->conf->mld_addr) ||
+		!ether_addr_equal(hapd->conf->mld_addr, mld_addr);
+
+	if (hapd->wpa_auth &&
+	    wpa_auth_set_mld_addr(hapd->wpa_auth, mld_addr, link_id)) {
+		wpa_printf(MSG_ERROR,
+			   "MTK BSS MLO: failed to update WPA MLD info: iface=%s",
+			   ifname);
+		return -1;
+	}
+
+	hapd->mtk_mld_group_idx = group_idx;
+	hapd->mld_link_id = link_id;
+	os_memcpy(hapd->conf->mld_addr, mld_addr, ETH_ALEN);
+	if (hapd->driver->set_bss_mlo_info)
+		hapd->driver->set_bss_mlo_info(hapd->drv_priv, mld_addr,
+					     link_id, group_idx);
+
+	/*
+	 * MTK driver manages BSS MLD beacon/ML IE state. It can report
+	 * the final MLD address while the link beacon path is still settling,
+	 * so keep hostapd/WPA state in sync without pushing another beacon.
+	 */
+	if (is_changed && hapd->started)
+		wpa_printf(MSG_DEBUG,
+			   "MTK BSS MLO: updated driver-owned link: "
+			   "iface=%s group=%u link_id=%u "
+			   "mld_addr=" MACSTR,
+			   ifname, group_idx, link_id, MAC2STR(mld_addr));
+
+	return 0;
+#else /* CONFIG_DRIVER_NL80211_MTK */
+	return 0;
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+}
+
+
+int hostapd_clear_mtk_bss_mlo_info(struct hostapd_data *hapd,
+				    u8 group_idx, u8 link_id)
+{
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	const char *ifname;
+
+	ifname = hapd->conf->iface;
+
+	if (!group_idx) {
+		wpa_printf(MSG_ERROR,
+			   "MTK BSS MLO: refuse DEL_LINK without driver group: iface=%s",
+			   ifname);
+		return -1;
+	}
+
+	if (hapd->mtk_mld_group_idx &&
+	    hapd->mtk_mld_group_idx != group_idx) {
+		wpa_printf(MSG_ERROR,
+			   "MTK BSS MLO: refuse DEL_LINK group mismatch: "
+			   "iface=%s driver_group=%u cached_group=%u",
+			   ifname, group_idx, hapd->mtk_mld_group_idx);
+		return -1;
+	}
+
+	if (hapd->mld_link_id != link_id) {
+		wpa_printf(MSG_ERROR,
+			   "MTK BSS MLO: refuse DEL_LINK link mismatch: "
+			   "iface=%s driver_link_id=%u cached_link_id=%u",
+			   ifname, link_id, hapd->mld_link_id);
+		return -1;
+	}
+
+	/* Stations and link references must not survive a device-owned BSS
+	 * identity change. Keep the old tuple available during STA teardown. */
+	hostapd_free_stas(hapd);
+	if (hapd->driver->set_bss_mlo_info)
+		hapd->driver->set_bss_mlo_info(hapd->drv_priv, NULL, 0, 0);
+
+	if (hapd->wpa_auth && wpa_auth_clear_mld_addr(hapd->wpa_auth)) {
+		wpa_printf(MSG_ERROR,
+			   "MTK BSS MLO: failed to clear WPA MLD info: iface=%s",
+			   ifname);
+		return -1;
+	}
+
+	os_memset(hapd->conf->mld_addr, 0, ETH_ALEN);
+	hapd->mtk_mld_group_idx = 0;
+	hapd->mld_link_id = 0;
+
+	return 0;
+#else /* CONFIG_DRIVER_NL80211_MTK */
+	return 0;
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+}
+
+
+#ifdef CONFIG_DRIVER_NL80211_MTK
+static int hostapd_sync_mtk_bss_mlo_info_single(struct hostapd_data *hapd)
+{
+	u8 mld_addr[ETH_ALEN];
+	u8 group_idx = 0;
+	u8 link_id = 0;
+	bool is_private;
+
+	if (!hapd || !hapd->conf)
+		return -1;
+
+	is_private = hostapd_is_mtk_private_mld(hapd);
+	if (hapd->conf->mld_ap && !is_private)
+		return 0;
+
+	if (!hapd->driver || !hapd->driver->get_bss_mlo_info)
+		return is_private ? -1 : 0;
+
+	os_memset(mld_addr, 0, sizeof(mld_addr));
+	if (hapd->driver->get_bss_mlo_info(hapd->drv_priv, mld_addr,
+					   &link_id, &group_idx))
+		return is_private ? -1 : 0;
+
+	if (is_zero_ether_addr(mld_addr)) {
+		if (hostapd_has_mtk_bss_mlo_info(hapd) &&
+		    hostapd_clear_mtk_bss_mlo_info(hapd, hapd->mtk_mld_group_idx,
+					    hapd->mld_link_id))
+			return -1;
+
+		/*
+		 * MTK driver may publish BSS MLD info after the BSS is
+		 * attached. Keep the state empty until it publishes a non-zero
+		 * MLD address.
+		 */
+		wpa_printf(MSG_DEBUG,
+			   "MTK BSS MLO: defer driver MLD address: iface=%s",
+			   hapd->conf->iface);
+		return 0;
+	}
+
+	/* A delayed DEL event may query a newer ADD state. Tear down the old
+	 * identity before accepting the replacement, even without an empty
+	 * query result between the two events. */
+	if (hostapd_has_mtk_bss_mlo_info(hapd) &&
+	    (hapd->mtk_mld_group_idx != group_idx ||
+	     hapd->mld_link_id != link_id ||
+	     !ether_addr_equal(hapd->conf->mld_addr, mld_addr)) &&
+	    hostapd_clear_mtk_bss_mlo_info(hapd, hapd->mtk_mld_group_idx,
+					hapd->mld_link_id))
+		return -1;
+
+	return hostapd_update_mtk_bss_mlo_info(hapd, group_idx, link_id,
+					      mld_addr);
+}
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+
+
+int hostapd_sync_mtk_bss_mlo_info(struct hostapd_data *hapd)
+{
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	struct mtk_bss_mlo_info {
+		struct hostapd_data *bss;
+		u8 addr[ETH_ALEN];
+		u8 group;
+		u8 link;
+	} *info;
+	struct hapd_interfaces *interfaces;
+	size_t i, j, n = 0, count = 0;
+	int ret = -1;
+
+	if (!hapd || !hapd->conf || !hapd->drv_priv)
+		return -1;
+	if (!hostapd_is_mtk_private_mld(hapd) || !hapd->iface ||
+	    !hapd->iface->interfaces)
+		return hostapd_sync_mtk_bss_mlo_info_single(hapd);
+	interfaces = hapd->iface->interfaces;
+	for (i = 0; i < interfaces->count; i++) {
+		if (interfaces->iface[i])
+			count += interfaces->iface[i]->num_bss;
+	}
+	info = os_calloc(count, sizeof(*info));
+	if (!info)
+		return -1;
+
+	/* Query all private BSSs before changing cached membership. An event
+	 * can arrive after several links have already changed in the driver. */
+	for (i = 0; i < interfaces->count; i++) {
+		struct hostapd_iface *iface = interfaces->iface[i];
+
+		if (!iface)
+			continue;
+		for (j = 0; j < iface->num_bss; j++) {
+			struct hostapd_data *bss = iface->bss[j];
+
+			if (!hostapd_is_mtk_private_mld(bss) || !bss->drv_priv)
+				continue;
+			/* Secondary BSSs share the primary driver context until
+			 * hostapd_setup_bss() adds their own interface. */
+			if (bss != iface->bss[0] && !bss->interface_added)
+				continue;
+			if (!bss->driver || !bss->driver->get_bss_mlo_info ||
+			    bss->driver->get_bss_mlo_info(bss->drv_priv,
+						 info[n].addr, &info[n].link,
+						 &info[n].group))
+				goto out;
+			info[n++].bss = bss;
+		}
+	}
+	/* Validate the queried group, not a mixture of old and new tuples. */
+	for (i = 0; i < n; i++) {
+		if (is_zero_ether_addr(info[i].addr))
+			continue;
+		if (!info[i].group || info[i].link >= MAX_NUM_MLD_LINKS)
+			goto out;
+		for (j = 0; j < i; j++) {
+			bool same_addr, same_group;
+
+			if (is_zero_ether_addr(info[j].addr))
+				continue;
+			same_addr = ether_addr_equal(info[i].addr, info[j].addr);
+			same_group = info[i].group == info[j].group;
+			if (same_addr != same_group ||
+			    (same_group && info[i].link == info[j].link)) {
+				wpa_printf(MSG_ERROR,
+					   "MTK BSS MLO: conflicting driver membership: %s and %s",
+					   info[i].bss->conf->iface,
+					   info[j].bss->conf->iface);
+				goto out;
+			}
+		}
+	}
+	/* Release old security references on every changed link before any
+	 * replacement is installed. This also handles swapped link IDs. */
+	for (i = 0; i < n; i++) {
+		struct hostapd_data *bss = info[i].bss;
+
+		if (hostapd_has_mtk_bss_mlo_info(bss) &&
+		    (bss->mtk_mld_group_idx != info[i].group ||
+		     bss->mld_link_id != info[i].link ||
+		     !ether_addr_equal(bss->conf->mld_addr, info[i].addr)) &&
+		    hostapd_clear_mtk_bss_mlo_info(bss, bss->mtk_mld_group_idx,
+						bss->mld_link_id))
+			goto out;
+	}
+	for (i = 0; i < n; i++) {
+		if (!is_zero_ether_addr(info[i].addr) &&
+		    hostapd_update_mtk_bss_mlo_info(info[i].bss, info[i].group,
+						  info[i].link, info[i].addr))
+			goto out;
+	}
+	ret = 0;
+out:
+	os_free(info);
+	return ret;
+#else /* CONFIG_DRIVER_NL80211_MTK */
+	return 0;
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+}
+
 #endif /* CONFIG_IEEE80211BE */
 
 
@@ -3978,6 +4363,8 @@ int hostapd_add_iface(struct hapd_interf
 				goto fail;
 			}
 		} else {
+			bool setup_failed;
+
 			/* Assign new BSS with bss[0]'s driver info */
 			hapd = hapd_iface->bss[hapd_iface->num_bss - 1];
 			hapd->driver = hapd_iface->bss[0]->driver;
@@ -3985,9 +4372,14 @@ int hostapd_add_iface(struct hapd_interf
 			os_memcpy(hapd->own_addr, hapd_iface->bss[0]->own_addr,
 				  ETH_ALEN);
 
-			if (start_ctrl_iface_bss(hapd) < 0 ||
-			    (hapd_iface->state == HAPD_IFACE_ENABLED &&
-			     hostapd_setup_bss(hapd, -1, true))) {
+			setup_failed = start_ctrl_iface_bss(hapd) < 0;
+			if (!setup_failed && hapd_iface->state == HAPD_IFACE_ENABLED)
+				setup_failed = hostapd_setup_bss(hapd, -1, true);
+#if defined(CONFIG_IEEE80211BE) && defined(CONFIG_DRIVER_NL80211_MTK)
+			if (!setup_failed && hapd_iface->state == HAPD_IFACE_ENABLED)
+				setup_failed = hostapd_sync_mtk_bss_mlo_info(hapd);
