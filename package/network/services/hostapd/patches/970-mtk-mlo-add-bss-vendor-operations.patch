--- a/src/drivers/driver_common.c
+++ b/src/drivers/driver_common.c
@@ -102,6 +102,9 @@ const char * event_to_string(enum wpa_ev
 	E2S(LINK_RECONFIG);
 	E2S(MLD_INTERFACE_FREED);
 	E2S(SETUP_LINK_RECONFIG);
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	E2S(MTK_BSS_MLO_INFO);
+#endif /* CONFIG_DRIVER_NL80211_MTK */
 	}
 
 	return "UNKNOWN";
