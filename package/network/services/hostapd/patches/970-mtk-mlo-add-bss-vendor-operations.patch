From: chasey-dev <ellenyoung0912@gmail.com>
Subject: [PATCH] nl80211: Add MTK BSS MLO query and update operations

MTK driver reports BSS MLO state through vendor queries and link events.
nl80211 exposes these to hostapd and commits cached state only after
hostapd accepts it. The vendor interface also carries peer link
information needed for authentication.

Signed-off-by: chasey-dev <ellenyoung0912@gmail.com>
---
--- a/src/drivers/driver_nl80211.c
+++ b/src/drivers/driver_nl80211.c
@@ -54,6 +54,15 @@ static int nl80211_mtk_set_ft_params(str
 #ifndef NETLINK_CAP_ACK
 #define NETLINK_CAP_ACK 10
 #endif /* NETLINK_CAP_ACK */
+
+#ifdef CONFIG_DRIVER_NL80211_MTK
+static int nl80211_mtk_get_bss_mlo_info(struct i802_bss *bss,
+					u8 *mld_addr, u8 *link_id,
+					u8 *mld_grp_idx);
+static int nl80211_mtk_set_auth_mlo_ie(struct i802_bss *bss,
+				       const u8 *mld_addr,
+				       const u8 *link_addr);
+#endif /* CONFIG_DRIVER_NL80211_MTK */
 /* support for extack if compilation headers are too old */
 #ifndef NETLINK_EXT_ACK
 #define NETLINK_EXT_ACK 11
@@ -14489,6 +14498,225 @@ fail:
 
 
 #ifdef CONFIG_DRIVER_NL80211_MTK
+struct mtk_bss_mlo_info_ctx {
+	struct bss_mlo_info info;
+	bool has_info;
+};
+
+static int nl80211_mtk_bss_mlo_info_handler(struct nl_msg *msg, void *arg)
+{
+	struct nlattr *tb[NL80211_ATTR_MAX + 1];
+	struct nlattr *sub_tb[MTK_NL80211_VENDOR_ATTR_BSS_MLO_INFO_ATTR_MAX + 1];
+	struct genlmsghdr *gnlh = nlmsg_data(nlmsg_hdr(msg));
+	struct mtk_bss_mlo_info_ctx *ctx = arg;
+	struct nlattr *info;
+
+	if (gnlh->cmd != NL80211_CMD_VENDOR)
+		return NL_SKIP;
+
+	if (nla_parse(tb, NL80211_ATTR_MAX, genlmsg_attrdata(gnlh, 0),
+		      genlmsg_attrlen(gnlh, 0), NULL) ||
+	    !tb[NL80211_ATTR_VENDOR_DATA])
+		return NL_SKIP;
+
+	if (nla_parse_nested(sub_tb,
+			     MTK_NL80211_VENDOR_ATTR_BSS_MLO_INFO_ATTR_MAX,
+			     tb[NL80211_ATTR_VENDOR_DATA], NULL))
+		return NL_SKIP;
+
+	info = sub_tb[MTK_NL80211_VENDOR_ATTR_BSS_MLO_INFO];
+	if (!info)
+		return NL_SKIP;
+
+	if ((size_t) nla_len(info) != sizeof(ctx->info)) {
+		wpa_printf(MSG_DEBUG,
+			   "nl80211: MTK BSS MLO info length mismatch: len=%d expected=%zu",
+			   nla_len(info), sizeof(ctx->info));
+		return NL_SKIP;
+	}
+
+	os_memcpy(&ctx->info, nla_data(info), sizeof(ctx->info));
+	ctx->has_info = true;
+
+	return NL_SKIP;
+}
+
+static int nl80211_mtk_get_bss_mlo_info(struct i802_bss *bss,
+					u8 *mld_addr, u8 *link_id,
+					u8 *mld_grp_idx)
+{
+	struct wpa_driver_nl80211_data *drv = bss->drv;
+	struct mtk_bss_mlo_info_ctx ctx = {};
+	struct nl_msg *msg;
+	struct nlattr *data;
+	int ret;
+
+	wpa_printf(MSG_DEBUG, "nl80211: Query MTK BSS MLO info: ifname=%s",
+		   bss->ifname);
+
+	msg = nl80211_bss_msg(bss, 0, NL80211_CMD_VENDOR);
+	if (!msg ||
+	    nla_put_u32(msg, NL80211_ATTR_VENDOR_ID, MTK_NL80211_VENDOR_ID) ||
+	    nla_put_u32(msg, NL80211_ATTR_VENDOR_SUBCMD,
+			MTK_NL80211_VENDOR_SUBCMD_GET_BSS_MLO_INFO) ||
+	    !(data = nla_nest_start(msg, NL80211_ATTR_VENDOR_DATA)) ||
+	    nla_put_flag(msg, MTK_NL80211_VENDOR_ATTR_BSS_MLO_INFO))
+		goto fail;
+
+	nla_nest_end(msg, data);
+
+	ret = send_and_recv_resp(drv, msg, nl80211_mtk_bss_mlo_info_handler,
+				 &ctx);
+	if (ret) {
+		wpa_printf(MSG_DEBUG,
+			   "nl80211: MTK get BSS MLO info failed: ifname=%s ret=%d (%s)",
+			   bss->ifname, ret, strerror(-ret));
+		return ret;
+	}
+
+	if (!ctx.has_info) {
+		wpa_printf(MSG_DEBUG,
+			   "nl80211: Missing MTK BSS MLO info reply: ifname=%s",
+			   bss->ifname);
+		return -EINVAL;
+	}
+
+	/* MTK driver returns its last ADD/DEL event in link_cnt. */
+	if (ctx.info.link_cnt != MTK_BSS_MLO_EVENT_ADD_LINK &&
+	    ctx.info.link_cnt != MTK_BSS_MLO_EVENT_DEL_LINK)
+		return -EINVAL;
+
+	if (ctx.info.link_cnt == MTK_BSS_MLO_EVENT_DEL_LINK ||
+	    (!ctx.info.mld_grp_idx && is_zero_ether_addr(ctx.info.addr))) {
+		if (mld_addr)
+			os_memset(mld_addr, 0, ETH_ALEN);
+		if (link_id)
+			*link_id = 0;
+		if (mld_grp_idx)
+			*mld_grp_idx = 0;
+		wpa_printf(MSG_DEBUG, "nl80211: No MTK BSS MLO info: ifname=%s",
+			   bss->ifname);
+		return 0;
+	}
+
+	if (!ctx.info.mld_grp_idx || is_zero_ether_addr(ctx.info.addr) ||
+	    is_multicast_ether_addr(ctx.info.addr) ||
+	    ctx.info.link_id >= MAX_NUM_MLD_LINKS) {
+		wpa_printf(MSG_DEBUG,
+			   "nl80211: Invalid MTK BSS MLO info: "
+			   "ifname=%s group=%u link_id=%u mld_addr=" MACSTR,
+			   bss->ifname, ctx.info.mld_grp_idx,
+			   ctx.info.link_id, MAC2STR(ctx.info.addr));
+		return -EINVAL;
+	}
+
+	if (mld_addr)
+		os_memcpy(mld_addr, ctx.info.addr, ETH_ALEN);
+	if (link_id)
+		*link_id = ctx.info.link_id;
+	if (mld_grp_idx)
+		*mld_grp_idx = ctx.info.mld_grp_idx;
+
+	wpa_printf(MSG_DEBUG,
+		   "nl80211: MTK BSS MLO info: ifname=%s event_id=%u group=%u "
+		   "link_id=%u mld_addr=" MACSTR,
+		   bss->ifname, ctx.info.link_cnt, ctx.info.mld_grp_idx,
+		   ctx.info.link_id, MAC2STR(ctx.info.addr));
+
+	return 0;
+
+fail:
+	nlmsg_free(msg);
+	return -ENOBUFS;
+}
+
+static int wpa_driver_nl80211_get_bss_mlo_info(void *priv, u8 *mld_addr,
+					       u8 *link_id,
+					       u8 *mld_grp_idx)
+{
+	struct i802_bss *bss = priv;
+
+	return nl80211_mtk_get_bss_mlo_info(bss, mld_addr, link_id,
+					    mld_grp_idx);
+}
+
+static void wpa_driver_nl80211_set_bss_mlo_info(void *priv,
+					     const u8 *mld_addr, u8 link_id,
+					     u8 mld_grp_idx)
+{
+	struct i802_bss *bss = priv;
+
+	bss->has_mtk_mlo_info = mld_addr != NULL;
+	bss->mtk_mlo_group_idx = mld_addr ? mld_grp_idx : 0;
+	bss->mtk_mlo_link_id = mld_addr ? link_id : 0;
+	if (mld_addr)
+		os_memcpy(bss->mtk_mlo_addr, mld_addr, ETH_ALEN);
+	else
+		os_memset(bss->mtk_mlo_addr, 0, ETH_ALEN);
+}
+
+static int nl80211_mtk_set_auth_mlo_ie(struct i802_bss *bss,
+				       const u8 *mld_addr,
+				       const u8 *link_addr)
+{
+	struct wpa_driver_nl80211_data *drv = bss->drv;
+	struct wpa_mlo_ie_parse peer_mlo;
+	struct nl_msg *msg;
+	struct nlattr *data;
+	int ret;
+
+	if (!mld_addr || !link_addr || !bss->has_mtk_mlo_info ||
+	    is_zero_ether_addr(mld_addr) ||
+	    is_multicast_ether_addr(mld_addr) ||
+	    is_zero_ether_addr(link_addr) ||
+	    is_multicast_ether_addr(link_addr))
+		return -EINVAL;
+
+	os_memset(&peer_mlo, 0, sizeof(peer_mlo));
+	peer_mlo.type = MULTI_LINK_CONTROL_TYPE_BASIC;
+	os_memcpy(peer_mlo.ml_addr, mld_addr, ETH_ALEN);
+	peer_mlo.common_info_len = 1 + ETH_ALEN;
+	peer_mlo.ml_link_num = 1;
+	peer_mlo.valid = 1;
+	peer_mlo.profiles[0].link_id = bss->mtk_mlo_link_id;
+	os_memcpy(peer_mlo.profiles[0].addr, link_addr, ETH_ALEN);
+	peer_mlo.profiles[0].mac_addr_present = 1;
+
+	if (!(msg = nl80211_drv_msg(drv, 0, NL80211_CMD_VENDOR)) ||
+	    nla_put_u32(msg, NL80211_ATTR_VENDOR_ID, MTK_NL80211_VENDOR_ID) ||
+	    nla_put_u32(msg, NL80211_ATTR_VENDOR_SUBCMD,
+			MTK_NL80211_VENDOR_SUBCMD_SET_MLO_IE) ||
+	    !(data = nla_nest_start(msg, NL80211_ATTR_VENDOR_DATA)) ||
+	    nla_put(msg, MTK_NL80211_VENDOR_ATTR_SET_AUTH_MLO_IE,
+		    sizeof(peer_mlo), &peer_mlo)) {
+		nlmsg_free(msg);
+		return -ENOBUFS;
+	}
+	nla_nest_end(msg, data);
+
+	wpa_printf(MSG_DEBUG,
+		   "nl80211: MTK set auth MLO IE: ifname=%s mld_addr=" MACSTR
+		   " link_addr=" MACSTR,
+		   bss->ifname, MAC2STR(mld_addr),
+		   MAC2STR(link_addr));
+
+	ret = send_and_recv_cmd(drv, msg);
+	if (ret)
+		wpa_printf(MSG_ERROR,
+			   "nl80211: MTK failed to set auth MLO IE: ifname=%s ret=%d (%s)",
+			   bss->ifname, ret, strerror(-ret));
+	return ret;
+}
+
+static int wpa_driver_nl80211_set_auth_mlo_ie(void *priv,
+					      const u8 *mld_addr,
+					      const u8 *link_addr)
+{
+	struct i802_bss *bss = priv;
+
+	return nl80211_mtk_set_auth_mlo_ie(bss, mld_addr, link_addr);
+}
+
 static int nl80211_mtk_do_acs(struct i802_bss *bss,
 			      struct drv_acs_params *params)
 {
@@ -15470,4 +15698,9 @@ const struct wpa_driver_ops wpa_driver_n
 	.radio_disable = testing_nl80211_radio_disable,
 #endif /* CONFIG_TESTING_OPTIONS */
 	.get_multi_hw_info = wpa_driver_get_multi_hw_info,
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	.get_bss_mlo_info = wpa_driver_nl80211_get_bss_mlo_info,
+	.set_bss_mlo_info = wpa_driver_nl80211_set_bss_mlo_info,
+	.set_auth_mlo_ie = wpa_driver_nl80211_set_auth_mlo_ie,
+#endif /* CONFIG_DRIVER_NL80211_MTK */
 };
--- a/src/drivers/driver_nl80211.h
+++ b/src/drivers/driver_nl80211.h
@@ -91,6 +91,13 @@ struct i802_bss {
 
 	int if_dynamic;
 
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	unsigned int has_mtk_mlo_info:1;
+	u8 mtk_mlo_group_idx;
+	u8 mtk_mlo_link_id;
+	u8 mtk_mlo_addr[ETH_ALEN];
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+
 	void *ctx;
 	struct nl_sock *nl_preq, *nl_mgmt, *nl_connect;
 	struct nl_cb *nl_cb;
--- a/src/drivers/driver_nl80211_event.c
+++ b/src/drivers/driver_nl80211_event.c
@@ -3609,6 +3609,13 @@ static void nl80211_vendor_event_brcm(st
 
 #ifdef CONFIG_DRIVER_NL80211_MTK
 
+struct mtk_bss_mlo_info_event {
+	u8 event_id;
+	u8 mld_grp_idx;
+	u8 link_id;
+	u8 addr[ETH_ALEN];
+};
+
 static enum hostapd_hw_mode get_mtk_hw_mode(u8 hw_mode)
 {
 	switch (hw_mode) {
@@ -3717,6 +3724,67 @@ static void mtk_nl80211_acs_select_ch(st
 	wpa_supplicant_event(bss->ctx, EVENT_ACS_CHANNEL_SELECTED, &event);
 }
 
+static void nl80211_mtk_bss_mlo_info_event(struct i802_bss *bss,
+					  u8 *data, size_t len)
+{
+	const struct mtk_bss_mlo_info_event *event;
+	struct nlattr *attr;
+	union wpa_event_data ev;
+	int rem;
+
+	if (!data || len < sizeof(*attr))
+		return;
+
+	rem = len;
+	attr = (struct nlattr *) data;
+	if (!nla_ok(attr, rem) ||
+	    nla_type(attr) != MTK_NL80211_VENDOR_EVENT_SEND_ML_INFO ||
+	    (size_t) nla_len(attr) != sizeof(*event)) {
+		wpa_printf(MSG_DEBUG,
+			   "nl80211: Ignore invalid MTK BSS MLO event: ifname=%s",
+			   bss->ifname);
+		return;
+	}
+
+	event = nla_data(attr);
+	os_memset(&ev, 0, sizeof(ev));
+	ev.mtk_bss_mlo_info.event_id = event->event_id;
+
+	switch (event->event_id) {
+	case MTK_BSS_MLO_EVENT_ADD_LINK:
+		if (!event->mld_grp_idx || event->link_id >= MAX_NUM_MLD_LINKS ||
+		    is_zero_ether_addr(event->addr) ||
+		    is_multicast_ether_addr(event->addr)) {
+			wpa_printf(MSG_DEBUG,
+				   "nl80211: Ignore invalid MTK BSS MLO add event: ifname=%s",
+				   bss->ifname);
+			return;
+		}
+
+		ev.mtk_bss_mlo_info.mld_grp_idx = event->mld_grp_idx;
+		ev.mtk_bss_mlo_info.link_id = event->link_id;
+		os_memcpy(ev.mtk_bss_mlo_info.mld_addr, event->addr, ETH_ALEN);
+		wpa_printf(MSG_DEBUG,
+			   "nl80211: MTK BSS MLO add event: ifname=%s group=%u link_id=%u "
+			   "mld_addr=" MACSTR,
+			   bss->ifname, event->mld_grp_idx,
+			   event->link_id, MAC2STR(event->addr));
+		break;
+	case MTK_BSS_MLO_EVENT_DEL_LINK:
+		wpa_printf(MSG_DEBUG,
+			   "nl80211: MTK BSS MLO delete event: ifname=%s",
+			   bss->ifname);
+		break;
+	default:
+		wpa_printf(MSG_DEBUG,
+			   "nl80211: Ignore unknown MTK BSS MLO event: ifname=%s event_id=%u",
+			   bss->ifname, event->event_id);
+		return;
+	}
+
+	wpa_supplicant_event(bss->ctx, EVENT_MTK_BSS_MLO_INFO, &ev);
+}
+
 
 static void nl80211_vendor_event_mtk(struct i802_bss *bss, u32 subcmd,
 				     u8 *data, size_t len)
@@ -3725,6 +3793,9 @@ static void nl80211_vendor_event_mtk(str
 	case MTK_NL80211_VENDOR_EVENT_ACS_COMPLETE_EVENT:
 		mtk_nl80211_acs_select_ch(bss, data, len);
 		break;
+	case MTK_NL80211_VENDOR_EVENT_SEND_ML_INFO:
+		nl80211_mtk_bss_mlo_info_event(bss, data, len);
+		break;
 	default:
 		wpa_printf(MSG_DEBUG,
 			   "nl80211: Ignore unsupported MTK vendor event %u",
--- a/src/drivers/driver.h
+++ b/src/drivers/driver.h
@@ -5561,8 +5561,50 @@ struct wpa_driver_ops {
 	 */
 	struct hostapd_multi_hw_info *
 	(*get_multi_hw_info)(void *priv, unsigned int *num_multi_hws);
+
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	/**
+	 * get_bss_mlo_info - Query MTK BSS MLO information
+	 * @priv: Private driver interface data
+	 * @mld_addr: Driver-owned BSS MLD address
+	 * @link_id: Driver-owned BSS MLO link ID
+	 * @mld_grp_idx: Driver-owned MLD group index
+	 *
+	 * This optional callback queries driver-owned MLO state for a BSS.
+	 */
+	int (*get_bss_mlo_info)(void *priv, u8 *mld_addr, u8 *link_id,
+				u8 *mld_grp_idx);
+	/**
+	 * set_bss_mlo_info - Cache BSS MLO information accepted by hostapd
+	 * @priv: Private driver interface data
+	 * @mld_addr: Accepted MLD address, or NULL to clear the cache
+	 * @link_id: Accepted link ID
+	 * @mld_grp_idx: Accepted group index
+	 *
+	 * This updates the driver wrapper's cache, not the device state.
+	 */
+	void (*set_bss_mlo_info)(void *priv, const u8 *mld_addr, u8 link_id,
+				u8 mld_grp_idx);
+
+	/**
+	 * set_auth_mlo_ie - Pass peer MLD/link address for MTK SAE auth
+	 * @priv: Private driver interface data
+	 * @mld_addr: Peer MLD address
+	 * @link_addr: Peer setup-link address
+	 *
+	 * MTK BSS MLDs keep auth address translation in the driver. This
+	 * optional callback provides the peer MLD and setup-link addresses
+	 * before hostapd transmits the SAE authentication response.
+	 */
+	int (*set_auth_mlo_ie)(void *priv, const u8 *mld_addr, const u8 *link_addr);
+#endif /* CONFIG_DRIVER_NL80211_MTK */
 };
 
+#ifdef CONFIG_DRIVER_NL80211_MTK
+#define MTK_BSS_MLO_EVENT_ADD_LINK 0
+#define MTK_BSS_MLO_EVENT_DEL_LINK 1
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+
 /**
  * enum wpa_event_type - Event type for wpa_supplicant_event() calls
  */
@@ -6198,6 +6240,16 @@ enum wpa_event_type {
 	 * EVENT_SETUP_LINK_RECONFIG - Notification that new AP links added
 	 */
 	EVENT_SETUP_LINK_RECONFIG,
+
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	/**
+	 * EVENT_MTK_BSS_MLO_INFO - MTK BSS MLO state update
+	 *
+	 * This event reports driver-owned MLO group and link information for a
+	 * BSS.
+	 */
+	EVENT_MTK_BSS_MLO_INFO,
+#endif /* CONFIG_DRIVER_NL80211_MTK */
 };
 
 
@@ -7198,6 +7250,22 @@ union wpa_event_data {
 		const u8 *resp_ie; /* Starting from Group Key Data */
 		size_t resp_ie_len;
 	} reconfig_info;
+
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	/**
+	 * struct mtk_bss_mlo_info - Data for EVENT_MTK_BSS_MLO_INFO
+	 * @event_id: MTK MLO event ID from the driver
+	 * @mld_grp_idx: MTK MLD group index
+	 * @link_id: Link ID in the MLD group
+	 * @mld_addr: Driver-owned MLD address
+	 */
+	struct mtk_bss_mlo_info {
+		u8 event_id;
+		u8 mld_grp_idx;
+		u8 link_id;
+		u8 mld_addr[ETH_ALEN];
+	} mtk_bss_mlo_info;
+#endif /* CONFIG_DRIVER_NL80211_MTK */
 };
 
