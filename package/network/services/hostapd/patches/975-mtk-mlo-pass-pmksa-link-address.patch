From: chasey-dev <ellenyoung0912@gmail.com>
Subject: [PATCH] WPA: Pass MLO link addresses to MTK PMKID operations

Shared PMKSA entries are indexed by MLD address. MTK PMKID addition
requires the station link address, while removal requires the AP link
address of the callback's BSS context. PMKSA callbacks preserve MLD
lookup and supply the appropriate link address for each operation.

Signed-off-by: chasey-dev <ellenyoung0912@gmail.com>
---
--- a/src/ap/ieee802_11.c
+++ b/src/ap/ieee802_11.c
@@ -1158,16 +1158,39 @@ static int sae_assign_vlan(struct hostap
 
 void sae_accept_sta(struct hostapd_data *hapd, struct sta_info *sta)
 {
+	const u8 *pmksa_addr = sta->addr;
+	const u8 *pmksa_link_addr = sta->addr;
+	bool has_ml_rsn = ap_sta_has_ml_rsn(hapd, sta);
 	int ret;
 
+#ifdef CONFIG_IEEE80211BE
+	if (has_ml_rsn) {
+		const u8 link_id = sta->mld_assoc_link_id;
+
+		if (link_id >= MAX_NUM_MLD_LINKS) {
+			wpa_printf(MSG_ERROR,
+				   "MLD: Invalid association link ID %u",
+				   link_id);
+			return;
+		}
+
+		/*
+		 * PMKSA uses the MLD address, while the driver also needs the
+		 * link address.
+		 */
+		pmksa_addr = sta->mld_info.common_info.mld_addr;
+		pmksa_link_addr = sta->mld_info.links[link_id].peer_addr;
+	}
+#endif /* CONFIG_IEEE80211BE */
+
 	if (sta->sae->tmp &&
 	    sae_assign_vlan(hapd, sta, sta->sae->tmp->vlan_id) < 0)
 		return;
 
-	ret = wpa_auth_pmksa_add_sae(hapd->wpa_auth, sta->addr,
-				   sta->sae->pmk, sta->sae->pmk_len,
-				   sta->sae->pmkid, sta->sae->akmp,
-				   ap_sta_is_mld(hapd, sta), sta->vlan_id);
+	ret = wpa_auth_pmksa_add_sae(hapd->wpa_auth, pmksa_addr,
+				   pmksa_link_addr, sta->sae->pmk,
+				   sta->sae->pmk_len, sta->sae->pmkid,
+				   sta->sae->akmp, has_ml_rsn, sta->vlan_id);
 	if (ret < 0 && !hapd->conf->disable_pmksa_caching &&
 	    (hapd->iface->drv_flags2 & WPA_DRIVER_FLAGS2_MTK_AP_SME)) {
 		sta->flags &= ~WLAN_STA_AUTH;
--- a/src/ap/wpa_auth.c
+++ b/src/ap/wpa_auth.c
@@ -6722,8 +6722,9 @@ int wpa_auth_pmksa_add_preauth(struct wp
 
 
 int wpa_auth_pmksa_add_sae(struct wpa_authenticator *wpa_auth, const u8 *addr,
-			   const u8 *pmk, size_t pmk_len, const u8 *pmkid,
-			   int akmp, bool is_ml, int vlan_id)
+			   const u8 *link_addr, const u8 *pmk,
+			   size_t pmk_len, const u8 *pmkid, int akmp,
+			   bool is_ml, int vlan_id)
 {
 	struct rsn_pmksa_cache *pmksa = wpa_auth->pmksa;
 	struct rsn_pmksa_cache_entry *entry;
@@ -6752,8 +6753,8 @@ int wpa_auth_pmksa_add_sae(struct wpa_au
 #ifdef CONFIG_IEEE80211BE
 	entry->is_ml = is_ml;
 #endif /* CONFIG_IEEE80211BE */
-	if (!is_ml && wpa_auth->cb->add_pmkid &&
-	    wpa_auth->cb->add_pmkid(wpa_auth->cb_ctx, aa, addr, addr,
+	if (wpa_auth->cb->add_pmkid &&
+	    wpa_auth->cb->add_pmkid(wpa_auth->cb_ctx, aa, addr, link_addr,
 				  entry->pmk, entry->pmk_len,
 				  entry->pmkid, entry->akmp) < 0) {
 		wpa_printf(MSG_ERROR, "RSN: Failed to add PMKID to driver for "
--- a/src/ap/wpa_auth.h
+++ b/src/ap/wpa_auth.h
@@ -526,8 +526,9 @@ int wpa_auth_pmksa_add_preauth(struct wp
 			       int session_timeout,
 			       struct eapol_state_machine *eapol);
 int wpa_auth_pmksa_add_sae(struct wpa_authenticator *wpa_auth, const u8 *addr,
-			   const u8 *pmk, size_t pmk_len, const u8 *pmkid,
-			   int akmp, bool is_ml, int vlan_id);
+			   const u8 *link_addr, const u8 *pmk,
+			   size_t pmk_len, const u8 *pmkid, int akmp,
+			   bool is_ml, int vlan_id);
 void wpa_auth_add_sae_pmkid(struct wpa_state_machine *sm, const u8 *pmkid);
 int wpa_auth_pmksa_add2(struct wpa_authenticator *wpa_auth, const u8 *addr,
 			const u8 *pmk, size_t pmk_len, const u8 *pmkid,
--- a/src/ap/wpa_auth_glue.c
+++ b/src/ap/wpa_auth_glue.c
@@ -1769,7 +1769,7 @@ static int hostapd_wpa_auth_remove_pmkid
 	struct hostapd_data *hapd = ctx;
 
 #ifdef CONFIG_DRIVER_NL80211_MTK
-	if (os_memcmp(aa, link_addr, ETH_ALEN) == 0)
+	if (aa && sta_addr && link_addr)
 		return hostapd_remove_mtk_pmkid(hapd, aa, sta_addr, link_addr,
 						pmkid, akmp);
 #else /* CONFIG_DRIVER_NL80211_MTK */
--- a/src/ap/wpa_auth_ie.c
+++ b/src/ap/wpa_auth_ie.c
@@ -1217,14 +1217,17 @@ wpa_validate_wpa_ie(struct wpa_authentic
 	sm->pmksa = NULL;
 	for (i = 0; i < data.num_pmkid; i++) {
 		struct rsn_pmksa_cache *pmksa = wpa_auth->pmksa;
+		const u8 *pmksa_spa = sm->addr;
 
 		wpa_hexdump(MSG_DEBUG, "RSN IE: STA PMKID",
 			    &data.pmkid[i * PMKID_LEN], PMKID_LEN);
 #ifdef CONFIG_IEEE80211BE
-		if (is_ml)
+		if (is_ml) {
 			pmksa = wpa_auth->ml_pmksa;
+			pmksa_spa = sm->peer_mld_addr;
+		}
 #endif /* CONFIG_IEEE80211BE */
-		sm->pmksa = pmksa_cache_auth_get(pmksa, sm->addr,
+		sm->pmksa = pmksa_cache_auth_get(pmksa, pmksa_spa,
 						 &data.pmkid[i * PMKID_LEN]);
 #ifdef CONFIG_IEEE80211BE
 		if (!sm->pmksa && !is_ml && wpa_auth->is_ml)
@@ -1236,7 +1239,7 @@ wpa_validate_wpa_ie(struct wpa_authentic
 
 			idata.wpa_auth = wpa_auth;
 			idata.pmksa = NULL;
-			idata.spa = sm->addr;
+			idata.spa = pmksa_spa;
 			idata.pmkid = &data.pmkid[i * PMKID_LEN];
 			wpa_auth_for_each_auth(wpa_auth,
 					       wpa_auth_pmksa_iter,
--- a/wpa_supplicant/p2p_supplicant.c
+++ b/wpa_supplicant/p2p_supplicant.c
