From: chasey-dev <ellenyoung0912@gmail.com>
Subject: [PATCH] warp: Use a void platform remove callback

The platform remove callback returns void in the target kernel.
warp_remove() must use that signature and omit its integer return values.

Signed-off-by: chasey-dev <ellenyoung0912@gmail.com>
--- a/warp_main.c
+++ b/warp_main.c
@@ -487,7 +487,7 @@ warp_probe(struct platform_device *pdev)
 /*
 *
 */
-static int
+static void
 warp_remove(struct platform_device *pdev)
 {
 	struct warp_entry *warp;
@@ -503,7 +503,7 @@ warp_remove(struct platform_device *pdev
 	if (warp == NULL) {
 		warp_dbg(WARP_DBG_ERR, "%s(): remove faild since can't find warp entry!\n",
 			 __func__);
-		return -1;
+		return;
 	}
 
 	wed = &warp->wed;
@@ -549,7 +549,6 @@ warp_remove(struct platform_device *pdev
 	/* unregister warp msg */
 	warp_msg_deinit(warp->idx);
 #endif
-	return 0;
 }
 
 /*
