+#define WARP_BM_ALIGN 128
+
+static inline u32 warp_bm_ring_len(u32 n)
+{
+#ifdef WARP_BM_SHRINK_RING
+	u32 len = ALIGN(n, WARP_BM_ALIGN);
+	return len > 65536 ? 65536 : len;
+#else
+	return 65536;
+#endif
+}
