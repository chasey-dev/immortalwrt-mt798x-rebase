+int wpa_auth_set_mld_addr(struct wpa_authenticator *wpa_auth,
+			  const u8 *mld_addr, int link_id)
+{
+	struct rsn_pmksa_cache *new_ml_pmksa = NULL;
+	struct wpa_authenticator *pa;
+	struct wpa_get_link_auth_ctx ctx;
+	bool is_primary;
+
+	if (!wpa_auth || !mld_addr || is_zero_ether_addr(mld_addr) ||
+	    link_id < 0 || link_id >= MAX_NUM_MLD_LINKS)
+		return -1;
+	if (wpa_auth->is_ml &&
+	    ether_addr_equal(wpa_auth->mld_addr, mld_addr) &&
+	    wpa_auth->link_id == link_id)
+		return 0;
+
+	if (wpa_auth->is_ml) {
+		wpa_printf(MSG_ERROR,
+			   "MLD state changed before the previous state was cleared.");
+		return -1;
+	}
+
+	/*
+	 * MTK BSS MLD state may become available after wpa_init(), so
+	 * initialize the ML view on the first non-zero update.
+	 */
+	ctx.addr = mld_addr;
+	ctx.wpa_auth = NULL;
+	wpa_auth_for_each_auth(wpa_auth, wpa_get_primary_auth_cb, &ctx);
+	pa = ctx.wpa_auth;
+	is_primary = !pa || pa == wpa_auth;
+	if (is_primary) {
+		if (!wpa_auth->ml_pmksa) {
+			new_ml_pmksa = pmksa_cache_auth_init(wpa_auth_pmksa_free_cb,
+							     wpa_auth);
+			if (!new_ml_pmksa) {
+				wpa_printf(MSG_ERROR,
+					   "MLD-level PMKSA cache initialization failed.");
+				return -1;
+			}
+		}
+	} else {
+		if (!pa->ml_pmksa) {
+			wpa_printf(MSG_ERROR,
+				   "Primary MLD-level PMKSA cache is missing.");
+			return -1;
+		}
+	}
+
+	if (is_primary) {
+		wpa_auth->primary_auth = true;
+		if (new_ml_pmksa)
+			wpa_auth->ml_pmksa = new_ml_pmksa;
+	} else {
+		wpa_auth->primary_auth = false;
+		wpa_auth->ml_pmksa = pa->ml_pmksa;
+		eloop_cancel_timeout(wpa_rekey_gtk, wpa_auth, NULL);
+	}
+
+	os_memcpy(wpa_auth->mld_addr, mld_addr, ETH_ALEN);
+	wpa_auth->conf.mld_addr = wpa_auth->mld_addr;
+	wpa_auth->conf.link_id = link_id;
+	wpa_auth->link_id = link_id;
+	wpa_auth->is_ml = true;
+
+	return 0;
+}
+
+
+int wpa_auth_clear_mld_addr(struct wpa_authenticator *wpa_auth)
+{
+	struct wpa_authenticator *next_pa = NULL;
+
+	if (!wpa_auth || !wpa_auth->is_ml)
+		return 0;
+
+	eloop_cancel_timeout(wpa_rekey_gtk, wpa_auth, NULL);
+
+	if (wpa_auth->primary_auth) {
+		next_pa = wpa_auth->cb->next_primary_auth(wpa_auth->cb_ctx);
+		if (next_pa && next_pa != wpa_auth) {
+			next_pa->primary_auth = true;
+			next_pa->ml_pmksa = wpa_auth->ml_pmksa;
+			wpa_auth->ml_pmksa = NULL;
+			pmksa_cache_auth_set_ctx(next_pa->ml_pmksa, next_pa);
+			if (next_pa->conf.wpa_group_rekey)
+				eloop_register_timeout(next_pa->conf.wpa_group_rekey,
+						       0, wpa_rekey_gtk, next_pa, NULL);
+		} else {
+			pmksa_cache_auth_deinit(wpa_auth->ml_pmksa);
+			wpa_auth->ml_pmksa = NULL;
+		}
+	} else {
+		wpa_auth->ml_pmksa = NULL;
+	}
+
+	wpa_auth->primary_auth = false;
+	wpa_auth->is_ml = false;
+	wpa_auth->link_id = 0;
+	wpa_auth->conf.mld_addr = NULL;
+	wpa_auth->conf.link_id = -1;
+	os_memset(wpa_auth->mld_addr, 0, ETH_ALEN);
+	if (wpa_auth->conf.wpa_group_rekey)
+		eloop_register_timeout(wpa_auth->conf.wpa_group_rekey, 0,
+				       wpa_rekey_gtk, wpa_auth, NULL);
+
+	return 0;
+}
