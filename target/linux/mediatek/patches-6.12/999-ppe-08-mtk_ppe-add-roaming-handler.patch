+++ b/drivers/net/ethernet/mediatek/mtk_ppe_debugfs.c
@@ -253,6 +253,60 @@ static const struct file_operations mtk_
 };
 
 static int
+mtk_ppe_internal_debugfs_level_show(struct seq_file *m, void *private)
+{
+	struct mtk_eth *eth = m->private;
+
+	seq_printf(m, "PPE debug level=%d\n", eth->debug_level);
+
+	return 0;
+}
+
+static int
+mtk_ppe_internal_debugfs_level_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, mtk_ppe_internal_debugfs_level_show,
+			   inode->i_private);
+}
+
+static ssize_t
+mtk_ppe_internal_debugfs_level_write(struct file *file, const char __user *buf,
+				     size_t count, loff_t *offset)
+{
+	struct seq_file *m = file->private_data;
+	struct mtk_eth *eth = (struct mtk_eth *)m->private;
+	char tmp[8] = {0};
+	u32 level;
+
+	if ((count > sizeof(tmp)))
+		return -EFAULT;
+
+	if (copy_from_user(tmp, buf, count))
+		return -EFAULT;
+
+	if (sscanf(tmp, "%d", &level) != 1)
+		return -EFAULT;
+
+	if (level < 0 || level > 7) {
+		pr_warn("The input debug level is invalid, "
+			"it should range from 0 to 7.\n");
+		return -EINVAL;
+	}
+
+	eth->debug_level = level;
+
+	return count;
+}
+
+static const struct file_operations mtk_ppe_internal_debugfs_level_fops = {
+	.open = mtk_ppe_internal_debugfs_level_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.write = mtk_ppe_internal_debugfs_level_write,
+	.release = single_release,
+};
+
+static int
 mtk_ppe_internal_debugfs_foe_all_show(struct seq_file *m, void *private)
 {
 	struct mtk_eth *eth = m->private;
@@ -311,6 +365,8 @@ int mtk_ppe_internal_debugfs_init(struct
 			    &mtk_ppe_internal_debugfs_foe_bind_fops);
 	debugfs_create_file("qos_toggle", S_IRUGO, root, eth,
 			    &mtk_ppe_internal_debugfs_qos_fops);
+	debugfs_create_file("debug_level", S_IRUGO, root, eth,
+			    &mtk_ppe_internal_debugfs_level_fops);
 
 	for (i = 0; i < (mtk_is_netsys_v2_or_greater(eth) ? 4 : 2); i++) {
 		ret = snprintf(name, sizeof(name), "qdma_sch%ld", i);
--- a/net/netfilter/nf_flow_table_core.c
+++ b/net/netfilter/nf_flow_table_core.c
@@ -372,6 +372,45 @@ void flow_offload_teardown_by_tuple(stru
 }
 EXPORT_SYMBOL_GPL(flow_offload_teardown_by_tuple);
 
+static void nf_flow_teardown_by_mac(struct nf_flowtable *flowtable,
+				    struct flow_offload *flow, void *data)
+{
+	const u8 *mac = data;
+	int dir;
+
+	if (test_bit(NF_FLOW_TEARDOWN, &flow->flags))
+		return;
+
+	for (dir = 0; dir < FLOW_OFFLOAD_DIR_MAX; dir++) {
+		const struct flow_offload_tuple *t = &flow->tuplehash[dir].tuple;
+
+		/* out unions with dst_cache, only valid for XMIT_DIRECT */
+		if (t->xmit_type != FLOW_OFFLOAD_XMIT_DIRECT)
+			continue;
+
+		if (ether_addr_equal(t->out.h_dest, mac)) {
+			flow_offload_teardown(flow);
+			return;
+		}
+	}
+}
+
+/* Tear down every offloaded flow destined to @mac, so the software shortcut and
+ * any hardware offload get rebuilt for the port the client has roamed to.
+ * Sleeps on flowtable_lock: process context only.
+ */
+void flow_offload_teardown_by_mac(const u8 *mac)
+{
+	struct nf_flowtable *flowtable;
+
+	mutex_lock(&flowtable_lock);
+	list_for_each_entry(flowtable, &flowtables, list)
+		nf_flow_table_iterate(flowtable, nf_flow_teardown_by_mac,
+				      (void *)mac);
+	mutex_unlock(&flowtable_lock);
+}
+EXPORT_SYMBOL_GPL(flow_offload_teardown_by_mac);
+
 struct flow_offload_tuple_rhash *
 flow_offload_lookup(struct nf_flowtable *flow_table,
 		    struct flow_offload_tuple *tuple)
--- a/include/net/netfilter/nf_flow_table.h
+++ b/include/net/netfilter/nf_flow_table.h
@@ -296,6 +296,7 @@ void nf_flow_table_free(struct nf_flowta
 
 void flow_offload_teardown(struct flow_offload *flow);
 void flow_offload_teardown_by_tuple(struct flow_offload_tuple *tuple);
+void flow_offload_teardown_by_mac(const u8 *mac);
 
 int nf_flow_table_iterate(struct nf_flowtable *flow_table,
                       void (*iter)(struct nf_flowtable *flowtable,
