From: chasey-dev <ellenyoung0912@gmail.com>
Subject: [PATCH] OWE: Preserve MTK driver station entries during association

MTK AP SME creates a station entry before forwarding an OWE association
request to hostapd. Removing and recreating that entry during
association processing discards driver state needed by the request.
hostapd preserves this entry when MTK AP SME is in use.

Signed-off-by: chasey-dev <ellenyoung0912@gmail.com>
---
--- a/src/ap/ieee802_11.c
+++ b/src/ap/ieee802_11.c
@@ -5158,6 +5158,7 @@ static int add_associated_sta(struct hos
 	int set = 1;
 	const u8 *mld_link_addr = NULL;
 	bool mld_link_sta = false;
+	bool owe_assoc_req = false;
 	u16 eml_cap = 0;
 
 #ifdef CONFIG_IEEE80211BE
@@ -5207,7 +5208,17 @@ static int add_associated_sta(struct hos
 		   wpa_auth_sta_ft_tk_already_set(sta->wpa_sm),
 		   wpa_auth_sta_fils_tk_already_set(sta->wpa_sm));
 
-	if (!mld_link_sta && !sta->added_unassoc &&
+#if defined(CONFIG_OWE) && defined(CONFIG_DRIVER_NL80211_MTK)
+	/*
+	 * MTK driver creates an authenticated STA entry before hostapd
+	 * handles the OWE association request. Deleting it here sends a
+	 * deauth and removes the state needed by the later assoc response.
+	 */
+	owe_assoc_req = (hapd->iface->drv_flags2 & WPA_DRIVER_FLAGS2_MTK_AP_SME) &&
+		wpa_auth_sta_key_mgmt(sta->wpa_sm) == WPA_KEY_MGMT_OWE;
+#endif /* CONFIG_OWE && CONFIG_DRIVER_NL80211_MTK */
+
+	if (!owe_assoc_req && !mld_link_sta && !sta->added_unassoc &&
 	    (!(sta->flags & WLAN_STA_AUTHORIZED) ||
 	     (reassoc && sta->ft_over_ds && sta->auth_alg == WLAN_AUTH_FT) ||
 	     (!wpa_auth_sta_ft_tk_already_set(sta->wpa_sm) &&
