+#if defined(CONFIG_DRIVER_NL80211_MTK) && defined(CONFIG_SAE) && \
+	defined(CONFIG_SME) && defined(CONFIG_IEEE80211BE)
+static int
+wpas_mtk_set_ml_link_security(const struct wpa_sm_link *reporting_link,
+			      const u8 *sta_profile, size_t sta_profile_len,
+			      struct wpa_sm_link *reported_link)
+{
+	struct ieee802_11_elems elems;
+	const u8 *non_inherit, *pos;
+	size_t i, len;
+	bool should_inherit_rsne = true, should_inherit_rsnxe = true;
+	bool should_inherit_vendor = true;
+
+	if (ieee802_11_parse_elems(sta_profile, sta_profile_len, &elems, 1) ==
+	    ParseFailed)
+		return -1;
+
+	non_inherit = get_ie_ext(sta_profile, sta_profile_len,
+				 WLAN_EID_EXT_NON_INHERITANCE);
+	if (non_inherit) {
+		if (non_inherit[1] < 3 ||
+		    non_inherit + 2 + non_inherit[1] !=
+		    sta_profile + sta_profile_len)
+			return -1;
+
+		/* Skip the element header and extension ID. */
+		pos = non_inherit + 3;
+		len = non_inherit[1] - 1;
+		if (len < 1U + pos[0])
+			return -1;
+
+		for (i = 0; i < pos[0]; i++) {
+			switch (pos[1 + i]) {
+			case WLAN_EID_RSN:
+				should_inherit_rsne = false;
+				break;
+			case WLAN_EID_RSNX:
+				should_inherit_rsnxe = false;
+				break;
+			case WLAN_EID_VENDOR_SPECIFIC:
+				should_inherit_vendor = false;
+				break;
+			}
+		}
+
+		len -= 1 + pos[0];
+		pos += 1 + pos[0];
+		if (len < 1U || len != 1U + pos[0])
+			return -1;
+	}
+
+	/*
+	 * IEs omitted from a Per-STA Profile inherit from the reporting link
+	 * unless the Non-Inheritance element explicitly excludes their EID.
+	 */
+	if (elems.rsn_ie) {
+		reported_link->ap_rsne = (u8 *) elems.rsn_ie - 2;
+		reported_link->ap_rsne_len = 2 + elems.rsn_ie_len;
+	} else if (should_inherit_rsne) {
+		reported_link->ap_rsne = reporting_link->ap_rsne;
+		reported_link->ap_rsne_len = reporting_link->ap_rsne_len;
+	}
+	if (elems.rsnxe) {
+		reported_link->ap_rsnxe = (u8 *) elems.rsnxe - 2;
+		reported_link->ap_rsnxe_len = 2 + elems.rsnxe_len;
+	} else if (should_inherit_rsnxe) {
+		reported_link->ap_rsnxe = reporting_link->ap_rsnxe;
+		reported_link->ap_rsnxe_len = reporting_link->ap_rsnxe_len;
+	}
+	if (elems.rsne_override) {
+		reported_link->ap_rsnoe = (u8 *) elems.rsne_override - 2;
+		reported_link->ap_rsnoe_len = 2 + elems.rsne_override_len;
+	} else if (should_inherit_vendor) {
+		reported_link->ap_rsnoe = reporting_link->ap_rsnoe;
+		reported_link->ap_rsnoe_len = reporting_link->ap_rsnoe_len;
+	}
+	if (elems.rsne_override_2) {
+		reported_link->ap_rsno2e = (u8 *) elems.rsne_override_2 - 2;
+		reported_link->ap_rsno2e_len = 2 + elems.rsne_override_2_len;
+	} else if (should_inherit_vendor) {
+		reported_link->ap_rsno2e = reporting_link->ap_rsno2e;
+		reported_link->ap_rsno2e_len = reporting_link->ap_rsno2e_len;
+	}
+	if (elems.rsnxe_override) {
+		reported_link->ap_rsnxoe = (u8 *) elems.rsnxe_override - 2;
+		reported_link->ap_rsnxoe_len = 2 + elems.rsnxe_override_len;
+	} else if (should_inherit_vendor) {
+		reported_link->ap_rsnxoe = reporting_link->ap_rsnxoe;
+		reported_link->ap_rsnxoe_len = reporting_link->ap_rsnxoe_len;
+	}
+
+	return reported_link->ap_rsne ? 0 : -1;
+}
+
+
+static int wpa_sm_set_mtk_ml_info(struct wpa_supplicant *wpa_s,
+				  union wpa_event_data *data,
+				  const u8 *bssid)
+{
+	struct ieee802_11_elems req_elems, resp_elems;
+	struct ml_sta_link_info ml_info[MAX_NUM_MLD_LINKS];
+	struct wpabuf *resp_mlbuf = NULL;
+	struct wpa_sm_mlo mlo;
+	struct wpa_bss *assoc_bss;
+	const u8 *own_mld_addr, *ap_mld_addr;
+	const u8 *rsne, *rsnxe, *rsnoe, *rsno2e, *rsnxoe;
+	unsigned int i, n_links;
+	int ret = -1;
+	u16 resp_links;
+	u8 link_id;
+
+	wpa_s->mtk_mlo = false;
+	if (!data)
+		return wpa_s->sme.ext_auth_mlo_ie_len ? -1 : 0;
+
+	os_memset(&req_elems, 0, sizeof(req_elems));
+	os_memset(&resp_elems, 0, sizeof(resp_elems));
+	if ((data->assoc_info.req_ies &&
+	     ieee802_11_parse_elems(data->assoc_info.req_ies,
+				   data->assoc_info.req_ies_len,
+				   &req_elems, 1) == ParseFailed) ||
+	    (data->assoc_info.resp_ies &&
+	     ieee802_11_parse_elems(data->assoc_info.resp_ies,
+				   data->assoc_info.resp_ies_len,
+				   &resp_elems, 1) == ParseFailed)) {
+		wpa_dbg(wpa_s, MSG_INFO,
+			"MTK MLO: Invalid association request or response IEs");
+		return -1;
+	}
+
+	if (!req_elems.basic_mle && !resp_elems.basic_mle)
+		return wpa_s->sme.ext_auth_mlo_ie_len ? -1 : 0;
+
+	/* Cached PMKSA association can skip SAE external authentication. */
+	own_mld_addr = get_basic_mle_mld_addr(req_elems.basic_mle,
+					    req_elems.basic_mle_len);
+	ap_mld_addr = get_basic_mle_mld_addr(resp_elems.basic_mle,
+					   resp_elems.basic_mle_len);
+	if (!own_mld_addr || !ap_mld_addr ||
+	    is_zero_ether_addr(own_mld_addr) ||
+	    is_multicast_ether_addr(own_mld_addr) ||
+	    is_zero_ether_addr(ap_mld_addr) ||
+	    is_multicast_ether_addr(ap_mld_addr))
+		return -1;
+
+	assoc_bss = wpa_supplicant_get_new_bss(wpa_s, bssid);
+	if (!assoc_bss ||
+	    os_memcmp(assoc_bss->mld_addr, ap_mld_addr, ETH_ALEN) ||
+	    (wpa_s->sme.ext_auth_mlo_ie_len &&
+	     (os_memcmp(wpa_s->sme.ext_auth_own_mld_addr, own_mld_addr,
+			ETH_ALEN) ||
+	      os_memcmp(wpa_s->sme.ext_auth_ap_mld_addr, ap_mld_addr,
+			ETH_ALEN)))) {
+		wpa_dbg(wpa_s, MSG_INFO,
+			"MTK MLO: Association MLD addresses do not match");
+		return -1;
+	}
+
+	os_memset(&mlo, 0, sizeof(mlo));
+	os_memcpy(mlo.ap_mld_addr, ap_mld_addr, ETH_ALEN);
+	os_memcpy(mlo.own_mld_addr, own_mld_addr, ETH_ALEN);
+	if (wpas_mtk_parse_ml_assoc_req(&req_elems, own_mld_addr, &mlo)) {
+		wpa_dbg(wpa_s, MSG_INFO,
+			"MTK MLO: Invalid association request Multi-Link element");
+		return -1;
+	}
+
+	n_links = wpas_ml_parse_assoc(ap_mld_addr,
+				      &resp_elems, ml_info, &resp_mlbuf);
+	if (!n_links || ml_info[0].link_id >= MAX_NUM_MLD_LINKS) {
+		wpa_dbg(wpa_s, MSG_INFO,
+			"MTK MLO: Invalid association response Multi-Link element");
+		goto out;
+	}
+
+	link_id = ml_info[0].link_id;
+	if (mlo.req_links & BIT(link_id)) {
+		wpa_dbg(wpa_s, MSG_INFO,
+			"MTK MLO: Association link repeated in request profiles");
+		goto out;
+	}
+
+	mlo.assoc_link_id = link_id;
+	mlo.req_links |= BIT(link_id);
+	mlo.valid_links = BIT(link_id);
+	resp_links = BIT(link_id);
+	os_memcpy(mlo.links[link_id].addr, wpa_s->own_addr, ETH_ALEN);
+	os_memcpy(mlo.links[link_id].bssid, bssid, ETH_ALEN);
+
+	rsne = wpa_bss_get_ie(assoc_bss, WLAN_EID_RSN);
+	rsnxe = wpa_bss_get_ie(assoc_bss, WLAN_EID_RSNX);
+	rsnoe = wpa_bss_get_vendor_ie(assoc_bss,
+					 RSNE_OVERRIDE_IE_VENDOR_TYPE);
+	rsno2e = wpa_bss_get_vendor_ie(assoc_bss,
+					  RSNE_OVERRIDE_2_IE_VENDOR_TYPE);
+	rsnxoe = wpa_bss_get_vendor_ie(assoc_bss,
+					  RSNXE_OVERRIDE_IE_VENDOR_TYPE);
+	if (!rsne) {
+		wpa_dbg(wpa_s, MSG_INFO,
+			"MTK MLO: Association link BSS has no RSNE");
+		goto out;
+	}
+	mlo.links[link_id].ap_rsne = (u8 *) rsne;
+	mlo.links[link_id].ap_rsne_len = 2 + rsne[1];
+	mlo.links[link_id].ap_rsnxe = (u8 *) rsnxe;
+	mlo.links[link_id].ap_rsnxe_len = rsnxe ? 2 + rsnxe[1] : 0;
+	mlo.links[link_id].ap_rsnoe = (u8 *) rsnoe;
+	mlo.links[link_id].ap_rsnoe_len = rsnoe ? 2 + rsnoe[1] : 0;
+	mlo.links[link_id].ap_rsno2e = (u8 *) rsno2e;
+	mlo.links[link_id].ap_rsno2e_len = rsno2e ? 2 + rsno2e[1] : 0;
+	mlo.links[link_id].ap_rsnxoe = (u8 *) rsnxoe;
+	mlo.links[link_id].ap_rsnxoe_len = rsnxoe ? 2 + rsnxoe[1] : 0;
+
+	for (i = 1; i < n_links; i++) {
+		link_id = ml_info[i].link_id;
+		if (link_id >= MAX_NUM_MLD_LINKS ||
+		    !(mlo.req_links & BIT(link_id)) ||
+		    (resp_links & BIT(link_id)) ||
+		    is_zero_ether_addr(ml_info[i].bssid) ||
+		    is_multicast_ether_addr(ml_info[i].bssid)) {
+			wpa_dbg(wpa_s, MSG_INFO,
+				"MTK MLO: Response does not match requested links");
+			goto out;
+		}
+
+		resp_links |= BIT(link_id);
+		os_memcpy(mlo.links[link_id].bssid, ml_info[i].bssid,
+			  ETH_ALEN);
+		if (wpas_mtk_set_ml_link_security(
+			    &mlo.links[mlo.assoc_link_id],
+			    ml_info[i].sta_profile,
+			    ml_info[i].sta_profile_len,
+			    &mlo.links[link_id])) {
+			wpa_dbg(wpa_s, MSG_INFO,
+				"MTK MLO: Link %u profile has no valid RSNE",
+				link_id);
+			goto out;
+		}
+		if (ml_info[i].status == WLAN_STATUS_SUCCESS)
+			mlo.valid_links |= BIT(link_id);
+	}
+
+	if (resp_links != mlo.req_links) {
+		wpa_dbg(wpa_s, MSG_INFO,
+			"MTK MLO: Response omits a requested link");
+		goto out;
+	}
+
+	wpa_dbg(wpa_s, MSG_DEBUG,
+		"MTK MLO: association link=%u requested=0x%04x accepted=0x%04x",
+		mlo.assoc_link_id, mlo.req_links, mlo.valid_links);
+
+	ret = wpa_sm_set_mlo_params(wpa_s->wpa, &mlo);
+	if (!ret)
+		wpa_s->mtk_mlo = true;
+out:
+	wpabuf_free(resp_mlbuf);
+	return ret;
+}
+#endif /* CONFIG_DRIVER_NL80211_MTK && CONFIG_SAE && CONFIG_SME && CONFIG_IEEE80211BE */
+
+
 static void wpa_supplicant_event_assoc(struct wpa_supplicant *wpa_s,
 				       union wpa_event_data *data)
 {
@@ -4459,6 +4833,20 @@ static void wpa_supplicant_event_assoc(s
 		return;
 	}
 
+#if defined(CONFIG_DRIVER_NL80211_MTK) && defined(CONFIG_SAE) && \
+	defined(CONFIG_SME) && defined(CONFIG_IEEE80211BE)
+	if (!wpa_s->valid_links &&
+	    (wpa_s->drv_flags2 & WPA_DRIVER_FLAGS2_MTK_AP_SME) &&
+	    wpa_key_mgmt_sae(wpa_s->key_mgmt) &&
+	    wpa_sm_set_mtk_ml_info(wpa_s, data, bssid)) {
+		wpa_dbg(wpa_s, MSG_INFO,
+			"Failed to set MTK private MLO connection info to wpa_sm");
+		wpa_supplicant_deauthenticate(wpa_s,
+					      WLAN_REASON_DEAUTH_LEAVING);
+		return;
+	}
+#endif /* CONFIG_DRIVER_NL80211_MTK && CONFIG_SAE && CONFIG_SME && CONFIG_IEEE80211BE */
+
 	if (wpa_s->l2)
 		l2_packet_notify_auth_start(wpa_s->l2);
 
@@ -5990,7 +6378,9 @@ static void wpas_event_assoc_reject(stru
 		unsigned int n_links, i, idx;
 
 		idx = 0;
-		n_links = wpas_ml_parse_assoc(wpa_s, &elems, ml_info);
+		n_links = wpas_ml_parse_assoc(wpa_s->valid_links ?
+					      wpa_s->ap_mld_addr : NULL,
