+static int
+wpas_mtk_parse_ml_assoc_req(struct ieee802_11_elems *elems,
+			    const u8 *own_mld_addr,
+			    struct wpa_sm_mlo *mlo)
+{
+	struct wpabuf *mlbuf;
+	const struct ieee80211_eht_ml *ml;
+	const struct eht_ml_basic_common_info *common_info;
+	const u8 *pos, *ml_end;
+	size_t ml_len;
+	int ret = -1;
+
+	if (!own_mld_addr || !elems->basic_mle || !elems->basic_mle_len)
+		return -1;
+
+	mlbuf = ieee802_11_defrag(elems->basic_mle, elems->basic_mle_len,
+				 true);
+	if (!mlbuf)
+		return -1;
+
+	ml = wpabuf_head(mlbuf);
+	ml_len = wpabuf_len(mlbuf);
+	ml_end = (const u8 *) ml + ml_len;
+	if (ml_len < sizeof(*ml) + 1 + ETH_ALEN ||
+	    (le_to_host16(ml->ml_control) & MULTI_LINK_CONTROL_TYPE_MASK) !=
+	    MULTI_LINK_CONTROL_TYPE_BASIC)
+		goto out;
+
+	common_info = (const struct eht_ml_basic_common_info *) ml->variable;
+	if (common_info->len < 1 + ETH_ALEN ||
+	    sizeof(*ml) + common_info->len > ml_len ||
+	    !ether_addr_equal(common_info->mld_addr, own_mld_addr))
+		goto out;
+
+	pos = (const u8 *) common_info + common_info->len;
+	while (ml_end - pos > 2) {
+		size_t sub_elem_len, sta_info_len;
+		const u8 *sub_elem_end;
+		u16 control;
+		u8 link_id, nstr_bitmap_len = 0;
+		int num_frag_subelems;
+
+		num_frag_subelems =
+			ieee802_11_defrag_mle_subelem(mlbuf, pos,
+						      &sub_elem_len);
+		if (num_frag_subelems < 0)
+			goto out;
+
+		ml_len -= num_frag_subelems * 2;
+		ml_end = (const u8 *) ml + ml_len;
+		if (2 + sub_elem_len > (size_t) (ml_end - pos))
+			goto out;
+
+		if (*pos != EHT_ML_SUB_ELEM_PER_STA_PROFILE) {
+			pos += 2 + sub_elem_len;
+			continue;
+		}
+
+		pos += 2;
+		sub_elem_end = pos + sub_elem_len;
+		if (sub_elem_end - pos < 2)
+			goto out;
+
+		control = WPA_GET_LE16(pos);
+		link_id = control & EHT_PER_STA_CTRL_LINK_ID_MSK;
+		pos += 2;
+		if (link_id >= MAX_NUM_MLD_LINKS ||
+		    (mlo->req_links & BIT(link_id)) ||
+		    !(control & EHT_PER_STA_CTRL_COMPLETE_PROFILE_MSK) ||
+		    !(control & EHT_PER_STA_CTRL_MAC_ADDR_PRESENT_MSK))
+			goto out;
+
+		if (control & EHT_PER_STA_CTRL_NSTR_LINK_PAIR_PRESENT_MSK)
+			nstr_bitmap_len =
+				(control & EHT_PER_STA_CTRL_NSTR_BM_SIZE_MSK) ? 2 : 1;
+
+		sta_info_len = 1 + ETH_ALEN + nstr_bitmap_len;
+		if (sta_info_len > (size_t) (sub_elem_end - pos) ||
+		    sta_info_len > *pos || *pos > sub_elem_end - pos)
+			goto out;
+		if (is_zero_ether_addr(pos + 1) ||
+		    is_multicast_ether_addr(pos + 1))
+			goto out;
+
+		os_memcpy(mlo->links[link_id].addr, pos + 1, ETH_ALEN);
+		mlo->req_links |= BIT(link_id);
+		pos = sub_elem_end;
+	}
+
+	ret = 0;
+out:
+	wpabuf_free(mlbuf);
+	return ret;
+}
+#endif /* CONFIG_DRIVER_NL80211_MTK && CONFIG_SAE && CONFIG_SME && CONFIG_IEEE80211BE */
