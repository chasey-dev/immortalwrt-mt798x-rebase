From: chasey-dev <ellenyoung0912@gmail.com>
Subject: [PATCH] FT: Derive default NAS identifiers from BSS addresses

A BSS without an explicit MAC address may not have its final address
when configuration validation runs. A default NAS identifier derived at
that point would not identify the BSS address returned by the driver.

Missing NAS identifiers are derived after that address becomes
available, before WPA setup and during reload. Explicitly configured
identifiers still undergo length validation.

Signed-off-by: chasey-dev <ellenyoung0912@gmail.com>
---
--- a/src/ap/ap_config.c
+++ b/src/ap/ap_config.c
@@ -1323,14 +1323,21 @@ static int hostapd_config_check_bss(stru
 	}
 
 #ifdef CONFIG_IEEE80211R_AP
-	if (full_config && wpa_key_mgmt_ft(bss->wpa_key_mgmt) &&
-	    (bss->nas_identifier == NULL ||
-	     os_strlen(bss->nas_identifier) < 1 ||
-	     os_strlen(bss->nas_identifier) > FT_R0KH_ID_MAX_LEN)) {
-		wpa_printf(MSG_ERROR, "FT (IEEE 802.11r) requires "
-			   "nas_identifier to be configured as a 1..48 octet "
-			   "string");
-		return -1;
+	if (full_config && wpa_key_mgmt_ft(bss->wpa_key_mgmt)) {
+		size_t nas_identifier_len = bss->nas_identifier ?
+			os_strlen(bss->nas_identifier) : 0;
+		bool has_valid_nas_identifier = nas_identifier_len >= 1 &&
+			nas_identifier_len <= FT_R0KH_ID_MAX_LEN;
+		bool can_derive_nas_identifier = !bss->nas_identifier &&
+			conf->use_driver_iface_addr &&
+			is_zero_ether_addr(bss->bssid);
+
+		if (!has_valid_nas_identifier && !can_derive_nas_identifier) {
+			wpa_printf(MSG_ERROR, "FT (IEEE 802.11r) requires "
+				   "nas_identifier to be configured as a 1..48 octet "
+				   "string");
+			return -1;
+		}
 	}
 #endif /* CONFIG_IEEE80211R_AP */
 
--- a/src/ap/hostapd.c
+++ b/src/ap/hostapd.c
@@ -275,6 +275,33 @@ int hostapd_check_max_sta(struct hostapd
 	return 0;
 }
 
+
+#ifdef CONFIG_IEEE80211R_AP
+static int hostapd_derive_nas_identifier(struct hostapd_bss_config *conf,
+					 const u8 *addr)
+{
+	char nas_identifier[2 * ETH_ALEN + 1];
+	int ret;
+
+	if (conf->nas_identifier || !wpa_key_mgmt_ft(conf->wpa_key_mgmt))
+		return 0;
+
+	ret = os_snprintf(nas_identifier, sizeof(nas_identifier),
+			  COMPACT_MACSTR, MAC2STR(addr));
+	if (is_zero_ether_addr(addr) ||
+	    os_snprintf_error(sizeof(nas_identifier), ret)) {
+		wpa_printf(MSG_ERROR,
+			   "FT: Failed to derive NAS identifier for %s",
+			   conf->iface);
+		return -1;
+	}
+
+	conf->nas_identifier = os_strdup(nas_identifier);
+	return conf->nas_identifier ? 0 : -1;
+}
+#endif /* CONFIG_IEEE80211R_AP */
+
+
 int hostapd_reload_config(struct hostapd_iface *iface)
 {
 	struct hapd_interfaces *interfaces = iface->interfaces;
@@ -332,6 +359,16 @@ int hostapd_reload_config(struct hostapd
 		return res;
 	}
 
+#ifdef CONFIG_IEEE80211R_AP
+	for (j = 0; j < iface->num_bss; j++) {
+		if (hostapd_derive_nas_identifier(newconf->bss[j],
+						  iface->bss[j]->own_addr)) {
+			hostapd_config_free(newconf);
+			return -1;
+		}
+	}
+#endif /* CONFIG_IEEE80211R_AP */
+
 	for (j = 0; j < iface->num_bss; j++) {
 		hapd = iface->bss[j];
 		if (!hapd->conf->config_id || !newconf->bss[j]->config_id ||
@@ -1552,6 +1589,11 @@ setup_mld:
 	}
 #endif /* CONFIG_IEEE80211BE */
 
+#ifdef CONFIG_IEEE80211R_AP
+	if (hostapd_derive_nas_identifier(conf, hapd->own_addr))
+		return -1;
+#endif /* CONFIG_IEEE80211R_AP */
+
 	hostapd_ucode_create_bss(hapd);
 
 	if (conf->wmm_enabled < 0)
