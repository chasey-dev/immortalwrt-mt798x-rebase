---
[v2] net: ethernet: mtk_ppe: add mxl862 switch dsa tag 8021q flow offload support

Without this patch, MXL862 switch ports using DSA tag_8021q protocol cannot be
hardware-offloaded through the PPE, and PPE-offloaded flows towards a DSA user
port ignore the per-conduit DSA queue map.
---
v2: Adapt OpenWrt upstream 795-03, 795-07 and 795-09 by Daniel Golle
    <daniel@makrotopia.org> -- eef4108f42f1, 6916564f8a24 and 031ec521141a:
    build the outer MxL862xx VLAN from dsa_tag_8021q_standalone_vid() instead
    of "port + GENMASK(11, 10)", which ignores the DSA tree and switch ID, and
    take the egress queue from the per-conduit DSA queue map.
    Drop the proto argument of mtk_foe_entry_set_dsa() and push the
    outer VLAN via mtk_foe_entry_set_vlan() in mtk_ppe_offload.c.
v1: Add mxl862 switch DSA tag 8021q flow offload support.
---

From 66da960d9d987af9cb8b8f63bac91fa456bdbaf3 Mon Sep 17 00:00:00 2001
From: "chak-kei.lam" <chak-kei.lam@mediatek.com>
Date: Thu, 8 Jan 2026 15:09:19 +0800
Subject: [PATCH] net: ethernet: mtk_ppe: add mxl862 switch dsa tag 8021q flow
 offload support

---
 .../net/ethernet/mediatek/mtk_ppe_offload.c   | 92 ++++++++++++++++-----
 1 file changed, 74 insertions(+), 18 deletions(-)

--- a/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
+++ b/drivers/net/ethernet/mediatek/mtk_ppe_offload.c
@@ -12,6 +12,7 @@
 #include <net/netfilter/nf_conntrack_acct.h>
 #include <net/netfilter/nf_flow_table.h>
 #include <net/dsa.h>
+#include <linux/dsa/8021q.h>
 #include "mtk_eth_soc.h"
 #include "mtk_wed.h"
 
@@ -168,8 +169,25 @@ mtk_flow_mangle_ipv4(const struct flow_a
 	return 0;
 }
 
+/*
+ * Inspect *dev as a DSA user netdev.  On success, substitute *dev with
+ * the conduit netdev, return the DSA user port's dp->index, and in
+ * *push_vid hand back either 0 (native MTK tag; the PPE injects its
+ * magic etype later via mtk_foe_entry_set_dsa()) or the outer 802.1Q
+ * VID the PPE should push on the egressing frame (tag_8021q taggers
+ * that use an outer Q-in-Q tag with a standalone per-port VID, i.e.
+ * the MxL862xx tag_8021q tagger).
+ *
+ * push_vid may be NULL for callers that only want the idev->conduit
+ * substitution (e.g. ingress-side ppe_idx selection, where no VID
+ * is to be pushed on the flow entry).
+ *
+ * Other tag_8021q-based taggers (sja1105, ocelot_8021q, ...) use
+ * different tag layers and/or bridge-scoped VIDs; do not extend the
+ * switch below to cover them without per-tagger review.
+ */
 static int
-mtk_flow_get_dsa_port(struct net_device **dev)
+mtk_flow_get_dsa_port(struct net_device **dev, u16 *push_vid)
 {
 #if IS_ENABLED(CONFIG_NET_DSA)
 	struct dsa_port *dp;
@@ -178,8 +196,18 @@ mtk_flow_get_dsa_port(struct net_device
 	if (IS_ERR(dp))
 		return -ENODEV;
 
-	if (dp->cpu_dp->tag_ops->proto != DSA_TAG_PROTO_MTK)
+	switch (dp->cpu_dp->tag_ops->proto) {
+	case DSA_TAG_PROTO_MTK:
+		if (push_vid)
+			*push_vid = 0;
+		break;
+	case DSA_TAG_PROTO_MXL862_8021Q:
+		if (push_vid)
+			*push_vid = dsa_tag_8021q_standalone_vid(dp);
+		break;
+	default:
 		return -ENODEV;
+	}
 
 	*dev = dsa_port_to_conduit(dp);
 
@@ -291,8 +319,11 @@ mtk_flow_set_output_device(struct mtk_et
 	struct net_device *odev_conduit = odev;
 	struct mtk_wdma_info info = {};
 	struct nf_conn *ct = NULL;
+	struct mtk_mac *mac;
 	u32 ct_mark = 0;
-	int pse_port, dsa_port, queue;
+	int err, pse_port, dsa_port, queue;
+	u16 push_vid = 0;
+	u8 dsa_queue_count = READ_ONCE(eth->dsa_queue_count);
 
 	if (mtk_flow_get_wdma_info(odev, dest_mac, &info) == 0) {
 		mtk_foe_entry_set_wdma(eth, foe, info.wdma_idx, info.queue,
@@ -318,7 +349,7 @@ mtk_flow_set_output_device(struct mtk_et
 		goto out;
 	}
 
-	dsa_port = mtk_flow_get_dsa_port(&odev_conduit);
+	dsa_port = mtk_flow_get_dsa_port(&odev_conduit, &push_vid);
 
 	if (odev_conduit == eth->netdev[0])
 		pse_port = PSE_GDM1_PORT;
@@ -330,8 +361,18 @@ mtk_flow_set_output_device(struct mtk_et
 		return -EOPNOTSUPP;
 
 	if (dsa_port >= 0) {
-		mtk_foe_entry_set_dsa(eth, foe, dsa_port);
-		queue = 3 + dsa_port;
+		if (push_vid) {
+			err = mtk_foe_entry_set_vlan(eth, foe, push_vid);
+			if (err)
+				return err;
+		} else {
+			mtk_foe_entry_set_dsa(eth, foe, dsa_port);
+		}
+	}
+
+	if (dsa_port >= 0 && dsa_port < MTK_DSA_USER_PORT_MAX) {
+		mac = netdev_priv(odev_conduit);
+		queue = mac->dsa_queue_base + mac->dsa_port_rank[dsa_port];
 	} else {
 		queue = (pse_port == PSE_GDM3_PORT) ? 2 : pse_port - 1;
 	}
@@ -347,10 +388,11 @@ mtk_flow_set_output_device(struct mtk_et
 			/* Dispatch the IPv4/IPv6 TCP Ack packets to the high-priority
 			 * queue, assuming they are less than 64 bytes.
 			 */
-			if (mtk_flow_is_tcp_ack(eth, foe, ct))
-				queue += 6;
+			if (mtk_flow_is_tcp_ack(eth, foe, ct) &&
+			    queue + dsa_queue_count < MTK_QDMA_NUM_QUEUES)
+				queue += dsa_queue_count;
 		}
-		mtk_foe_entry_set_queue(eth, foe, queue);
+		mtk_foe_entry_set_queue(eth, foe, queue & MTK_QDMA_QUEUE_MASK);
 	} else if (eth->qos_toggle == 1 || (ct_mark & MTK_QDMA_QUEUE_MASK) >= 15) {
 		u8 qos_ul_toggle;
 
@@ -421,6 +463,17 @@ mtk_flow_offload_replace(struct mtk_eth
 		flow_rule_match_meta(rule, &match);
 		if (mtk_is_netsys_v2_or_greater(eth)) {
 			idev = __dev_get_by_index(&init_net, match.key->ingress_ifindex);
+			/*
+			 * If idev is a DSA user netdev, substitute it with
+			 * its conduit so the valid-idev check below passes
+			 * and ppe_index picks up the conduit's PPE engine.
+			 * Without this, upstream flows from a DSA user port
+			 * (e.g. MxL862xx lanN) install on ppe[0] while the
+			 * conduit's GDMA routes ingress through its own
+			 * ppe[mac->ppe_idx]; the lookup misses and the
+			 * flow never binds in HW.
+			 */
+			mtk_flow_get_dsa_port(&idev, NULL);
 			if (mtk_flow_is_valid_idev(eth, idev)) {
 				struct mtk_mac *mac = netdev_priv(idev);
 
@@ -610,15 +663,6 @@ mtk_flow_offload_replace(struct mtk_eth
 			return err;
 	}
 
-	if (offload_type == MTK_PPE_PKT_TYPE_BRIDGE)
-		foe.bridge.vlan = data.vlan_in;
-
-	for (i = 0; i < data.vlan.num; i++)
-		mtk_foe_entry_set_vlan(eth, &foe, data.vlan.vlans[i].id);
-
-	if (data.pppoe.num == 1)
-		mtk_foe_entry_set_pppoe(eth, &foe, data.pppoe.sid);
-
 	err = mtk_flow_set_output_device(eth, &foe, idev, odev, f,
 					 data.eth.h_dest, &wed_index, dscp);
 	if (err)
@@ -627,6 +671,18 @@ mtk_flow_offload_replace(struct mtk_eth
 	if (wed_index >= 0 && (err = mtk_wed_flow_add(wed_index)) < 0)
 		return err;
 
+	if (offload_type == MTK_PPE_PKT_TYPE_BRIDGE)
+		foe.bridge.vlan = data.vlan_in;
+
+	for (i = 0; i < data.vlan.num; i++) {
+		err = mtk_foe_entry_set_vlan(eth, &foe, data.vlan.vlans[i].id);
+		if (err)
+			return err;
+	}
+
+	if (data.pppoe.num == 1)
+		mtk_foe_entry_set_pppoe(eth, &foe, data.pppoe.sid);
+
 	entry = kzalloc(sizeof(*entry), GFP_KERNEL);
 	if (!entry)
 		return -ENOMEM;
