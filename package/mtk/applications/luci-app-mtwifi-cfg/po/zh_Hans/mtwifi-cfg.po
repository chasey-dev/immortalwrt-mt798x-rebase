msgid "Add MLO Access Point"
msgstr "添加 MLO 接入点"

msgid "MLO Access Point"
msgstr "MLO 接入点 (AP)"

msgid "Click \"Switch mode\" to open the MLO AP configuration."
msgstr "请点击“切换模式”打开 MLO 接入点配置。"

msgid "Really switch mode?"
msgstr "确定切换模式？"

msgid "Switch mode"
msgstr "切换模式"

msgid "Member radios"
msgstr "无线成员"

msgid "Select at least two member radios."
msgstr "请选择至少两个无线成员。"

msgid "Member radio %s is not an mtwifi radio."
msgstr "无线成员 %s 不是 mtwifi。"

msgid "Member radio %s is disabled. Enable the radio first."
msgstr "无线成员 %s 已禁用，请先启用该成员。"

msgid "Member radio %s is not configured for 802.11be (BE). Configure the radio operating frequency first."
msgstr "无线成员 %s 未配置为 802.11be (BE)，请先配置该无线的工作频率。"

msgid "The maximum number of AP interfaces on %s has been reached."
msgstr "%s 上的 AP 接口数量已达到上限。"

msgid "This MLO AP configuration only supports WPA3-SAE or OWE encryption when a 6 GHz radio is included."
msgstr "此 MLO 接入点配置包含 6 GHz 无线时，仅支持 WPA3-SAE 或 OWE 加密。"

msgid "At least one AP interface must remain on %s."
msgstr "%s 上必须至少保留一个 AP 接口。"

msgid "MLO Client"
msgstr "MLO 客户端"

msgid "Join this network using the selected radio."
msgstr "使用当前选择的无线加入此网络。"

msgid "This MLO client configuration requires one 2.4 GHz main radio and one 5 GHz member radio."
msgstr "此 MLO 客户端配置需要一个 2.4 GHz 主无线成员和一个 5 GHz 无线成员。"

msgid "Member radio %s already has a client interface."
msgstr "无线成员 %s 已有客户端接口。"

msgid "This version only supports WPA3-SAE encryption in MLO client mode."
msgstr "当前版本在 MLO 客户端模式下仅支持 WPA3-SAE 加密。"

msgid "The scan result does not identify whether this network supports MLO. Select this mode only for a known MLO AP."
msgstr "扫描结果无法确认该网络是否支持 MLO。请仅对已知的 MLO 接入点选择此模式。"
