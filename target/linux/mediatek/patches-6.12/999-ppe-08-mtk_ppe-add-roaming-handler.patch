---
[v2] net: ethernet: mtk_ppe: add roaming handler

Without this patch, the traffic may stop over 30 seconds when the
WiFi roams.
---
v2: Replace mtk_flow_offload_teardown_by_roaming() with
    flow_offload_teardown_by_mac(). The old helper derived the 5-tuples from
    the PPE bind entries, so flows that were never bound to hardware were
    left behind and kept using the client's previous output port. Walking the
    software flowtables by destination MAC instead covers both bound and
    unbound flows.
v1: Add PPE roaming handler to delete the PPE BIND entry related to the
    WiFi roaming station.
---

From 79ba7f4667a0848dbdf4546a361f8f74cdf1e6da Mon Sep 17 00:00:00 2001
From: Bo-Cun Chen <bc-bocun.chen@mediatek.com>
Date: Wed, 24 Sep 2025 12:52:33 +0800
Subject: [PATCH] net: ethernet: mtk_ppe: add roaming handler

Without this patch, the traffic may stop over 30 seconds when the
WiFi roams.
---
 drivers/net/ethernet/mediatek/mtk_ppe.c       | 115 +++++++++++++++++++
 drivers/net/ethernet/mediatek/mtk_ppe.h       |   2 +
 .../net/ethernet/mediatek/mtk_ppe_debugfs.c   |  56 +++++++++
 include/net/netfilter/nf_flow_table.h         |   1 +
 net/netfilter/nf_flow_table_core.c            |  39 +++++++
 5 files changed, 213 insertions(+)

--- a/drivers/net/ethernet/mediatek/mtk_ppe.c
+++ b/drivers/net/ethernet/mediatek/mtk_ppe.c
@@ -12,6 +12,7 @@
 #include <net/dst_metadata.h>
 #include <net/dsa.h>
 #include <net/ipv6.h>
+#include <net/netfilter/nf_flow_table.h>
 
 #include "mtk_eth_soc.h"
 #include "mtk_ppe.h"
@@ -1164,3 +1165,117 @@ int mtk_ppe_stop(struct mtk_ppe *ppe)
 
 	return 0;
 }
+
+static void mtk_ppe_roam_handler(struct work_struct *work)
+{
+	struct mtk_eth *eth = container_of(work, struct mtk_eth, ppe_roam_work);
+	struct net_device *dev = NULL;
+	struct kvec iov;
+	struct msghdr msg;
+	struct nlmsghdr *nlh;
+	struct ndmsg *ndm;
+	struct nlattr *nla;
+	int len, ifindex;
+	u8 mac[ETH_ALEN];
+
+	if (!eth->ppe_roam_sock)
+		return;
+
+	iov.iov_base = eth->ppe_roam_buf;
+	iov.iov_len = sizeof(eth->ppe_roam_buf);
+	memset(&msg, 0, sizeof(msg));
+	msg.msg_namelen = sizeof(struct sockaddr_nl);
+
+	len = kernel_recvmsg(eth->ppe_roam_sock, &msg, &iov, 1, iov.iov_len, 0);
+	if (len <= 0)
+		goto out;
+
+	nlh = (struct nlmsghdr*)eth->ppe_roam_buf;
+	if (!NLMSG_OK(nlh, len) || nlh->nlmsg_type != RTM_NEWNEIGH)
+		goto out;
+
+	len = nlh->nlmsg_len - NLMSG_HDRLEN;
+	ndm = (struct ndmsg *)NLMSG_DATA(nlh);
+	if (ndm->ndm_family != PF_BRIDGE)
+		goto out;
+
+	ifindex = ndm->ndm_ifindex;
+	dev = dev_get_by_index(&init_net, ifindex);
+	if (!dev)
+		goto out;
+
+	if (!dev->ieee80211_ptr)
+		goto out;
+
+	nla = (struct nlattr *)((unsigned char *)ndm + sizeof(struct ndmsg));
+	len -= NLMSG_LENGTH(sizeof(struct ndmsg));
+	while (nla_ok(nla, len)) {
+		if (nla_type(nla) == NDA_LLADDR) {
+			memcpy(mac, nla_data(nla), ETH_ALEN);
+			flow_offload_teardown_by_mac(mac);
+			if (eth->debug_level >= 6)
+				pr_info("mtk_ppe: the neighbor (%pM) has been updated\n", mac);
+		}
+		nla = nla_next(nla, &len);
+	}
+
+out:
+	if (dev)
+		dev_put(dev);
+	if (!work_pending(&eth->ppe_roam_work))
+		schedule_work(&eth->ppe_roam_work);
+}
+
+int mtk_ppe_roaming_start(struct mtk_eth *eth)
+{
+	struct socket *sock = NULL;
+	struct sockaddr_nl addr;
+	int ret;
+
+	INIT_WORK(&eth->ppe_roam_work, mtk_ppe_roam_handler);
+
+	ret = sock_create_kern(&init_net, AF_NETLINK, SOCK_RAW, NETLINK_ROUTE, &sock);
+	if (ret < 0) {
+		pr_warn("mtk_ppe: roaming work is unable to create socket\n");
+		goto out;
+	}
+
+	addr.nl_family = AF_NETLINK;
+	addr.nl_pad = 0;
+	addr.nl_pid = 65534;
+	addr.nl_groups = 1 << (RTNLGRP_NEIGH - 1);
+	ret = kernel_bind(sock, (struct sockaddr *)&addr, sizeof(addr));
+	if (ret < 0) {
+		pr_warn("mtk_ppe: roaming work is unable to bind socket\n");
+		goto out;
+	}
+
+	eth->ppe_roam_sock = sock;
+	eth->ppe_roam_sock->sk->sk_rcvtimeo = msecs_to_jiffies(100);
+
+	schedule_work(&eth->ppe_roam_work);
+
+	pr_info("mtk_ppe: roaming work has been activated\n");
+
+	return 0;
+
+out:
+	if (sock)
+		sock_release(sock);
+
+	return ret;
+}
+
+int mtk_ppe_roaming_stop(struct mtk_eth *eth)
+{
+	if (!eth->ppe_roam_sock)
+		return -ENOENT;
+
+	cancel_work_sync(&eth->ppe_roam_work);
+	sock_release(eth->ppe_roam_sock);
+	eth->ppe_roam_sock = NULL;
+
+	pr_info("mtk_ppe: roaming work has been deactivated\n");
+
+	return 0;
+}
--- a/drivers/net/ethernet/mediatek/mtk_ppe.h
+++ b/drivers/net/ethernet/mediatek/mtk_ppe.h
@@ -349,6 +349,8 @@ struct mtk_ppe {
 struct mtk_ppe *mtk_ppe_init(struct mtk_eth *eth, void __iomem *base, int index);
 
 void mtk_ppe_deinit(struct mtk_eth *eth);
+int mtk_ppe_roaming_start(struct mtk_eth *eth);
+int mtk_ppe_roaming_stop(struct mtk_eth *eth);
 void mtk_ppe_update_mtu(struct mtk_ppe *ppe, int mtu);
 void mtk_ppe_start(struct mtk_ppe *ppe);
 int mtk_ppe_stop(struct mtk_ppe *ppe);
