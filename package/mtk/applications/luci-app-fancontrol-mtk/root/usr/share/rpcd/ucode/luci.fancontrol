'use strict';

import * as fs from 'fs';

const HWMON_NAME = 'pwmfan';
/* pwm-fan mode 2 keeps both the PWM output and fan supply enabled. */
const PWM_ENABLE_MODE = 2;

function read_trimmed(path) {
	let value = fs.readfile(path);
	return value == null ? null : trim(value);
}

function read_int(path) {
	let value = read_trimmed(path);
	return value == null || value == '' ? null : int(value);
}

function parse_uint(value) {
	let text = trim('' + value);
	return match(text, /^[0-9]+$/) ? int(text) : null;
}

function resolve_hwmon(wanted) {
	let path;

	if (wanted && wanted != 'auto') {
		if (match(wanted, /^\/sys\//))
			path = wanted;
		else if (match(wanted, /^hwmon[0-9]+$/))
			path = `/sys/class/hwmon/${wanted}`;

		if (path && fs.access(`${path}/pwm1`) && fs.access(`${path}/pwm1_enable`))
			return path;

		return null;
	}

	for (path in fs.glob('/sys/class/hwmon/hwmon*') || []) {
		if (read_trimmed(`${path}/name`) == HWMON_NAME &&
		    fs.access(`${path}/pwm1`) &&
		    fs.access(`${path}/pwm1_enable`))
			return path;
	}

	return null;
}

function write_uint(path, value) {
	let n = fs.writefile(path, `${value}\n`);
	return n != null;
}

function fan_info(path) {
	if (!path)
		return null;

	let pwm = read_int(`${path}/pwm1`);
	let rpm = read_int(`${path}/fan1_input`);

	return {
		path: path,
		realpath: fs.realpath(path) || path,
		name: read_trimmed(`${path}/name`),
		pwm: pwm,
		pwm_enable: read_int(`${path}/pwm1_enable`),
		rpm: rpm,
		percent: pwm == null ? null : int((pwm * 100 + 127) / 255)
	};
}

function temperature_info() {
	let sensors = [];
	let path;

	for (path in fs.glob('/sys/class/thermal/thermal_zone*') || []) {
		let temp = read_int(`${path}/temp`);
		if (temp == null)
			continue;

		push(sensors, {
			name: read_trimmed(`${path}/type`) || path,
			path: `${path}/temp`,
			temp_mC: temp,
			temp_C: temp / 1000.0
		});
	}

	for (path in fs.glob('/sys/class/hwmon/hwmon*') || []) {
		let name = read_trimmed(`${path}/name`);
		let temp = read_int(`${path}/temp1_input`);

		if (temp == null || name == HWMON_NAME)
			continue;

		push(sensors, {
			name: name || path,
			path: `${path}/temp1_input`,
			temp_mC: temp,
			temp_C: temp / 1000.0
		});
	}

	return sensors;
}

function cooling_info() {
	let path;

	for (path in fs.glob('/sys/class/thermal/cooling_device*') || []) {
		let type = read_trimmed(`${path}/type`);

		if (type != 'pwm-fan')
			continue;

		return {
			path: path,
			type: type,
			cur_state: read_int(`${path}/cur_state`),
			max_state: read_int(`${path}/max_state`)
		};
	}

	return null;
}

function build_status(wanted) {
	let path = resolve_hwmon(wanted || 'auto');

	return {
		ok: path != null,
		error: path ? null : 'pwmfan hwmon not found',
		fan: fan_info(path),
		temperatures: temperature_info(),
		cooling: cooling_info()
	};
}

const methods = {
	getStatus: {
		args: {
			hwmon: 'hwmon'
		},
		call: function(request) {
			return build_status(request.args?.hwmon);
		}
	},

	setPwm: {
		args: {
			pwm: 0,
			hwmon: 'hwmon'
		},
		call: function(request) {
			let pwm = parse_uint(request.args?.pwm);
			let path = resolve_hwmon(request.args?.hwmon || 'auto');

			if (path == null)
				return { ok: false, error: 'pwmfan hwmon not found' };

			if (pwm == null || pwm < 0 || pwm > 255)
				return { ok: false, error: 'invalid pwm value' };

			if (!write_uint(`${path}/pwm1_enable`, PWM_ENABLE_MODE))
				return { ok: false, error: 'failed to write pwm1_enable' };

			if (!write_uint(`${path}/pwm1`, pwm))
				return { ok: false, error: 'failed to write pwm1' };

			let status = build_status(path);
			status.ok = true;

			return status;
		}
	}
};

return { 'luci.fancontrol': methods };
