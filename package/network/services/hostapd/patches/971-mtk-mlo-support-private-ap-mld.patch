+				return -1;
+			wpa_printf(MSG_DEBUG,
+				   "Setup of MTK private link (%d) BSS %s",
+				   hapd->mld_link_id, hapd->conf->iface);
+		} else if (hapd->conf->mld_ap) {
 			wpa_printf(MSG_DEBUG,
 				   "Setup of first link (%d) BSS of MLD %s",
 				   hapd->mld_link_id, hapd->conf->iface);
@@ -2780,6 +2786,14 @@ static int hostapd_setup_interface_compl
 		}
 	}
 
+#if defined(CONFIG_IEEE80211BE) && defined(CONFIG_DRIVER_NL80211_MTK)
+	for (j = 0; j < iface->num_bss; j++) {
+		hapd = iface->bss[j];
+		if (hostapd_sync_mtk_bss_mlo_info(hapd))
