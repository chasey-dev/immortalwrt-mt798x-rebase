From: chasey-dev <ellenyoung0912@gmail.com>
Subject: [PATCH] warp: Use pde_data() for proc private data

PDE_DATA() is no longer available in the target kernel. Proc callbacks
use pde_data() to retrieve their private data.

Signed-off-by: chasey-dev <ellenyoung0912@gmail.com>
--- a/warp_proc.c
+++ b/warp_proc.c
@@ -182,7 +182,7 @@ wdma_proc_show(struct seq_file *seq, voi
 static int
 wdma_proc_open(struct inode *inode, struct file *file)
 {
-	return single_open(file, wdma_proc_show, PDE_DATA(file_inode(file)));
+	return single_open(file, wdma_proc_show, pde_data(file_inode(file)));
 }
 
 /*
@@ -196,7 +196,7 @@ wdma_proc_write(struct file *file, const
 	char value[64] = {0};
 	char *end;
 	char choice;
-	struct wdma_entry *wdma = (struct wdma_entry *)PDE_DATA(file_inode(file));
+	struct wdma_entry *wdma = (struct wdma_entry *)pde_data(file_inode(file));
 
 	if (!len1 || len1 >= sizeof(value))
 		return -EINVAL;
@@ -286,7 +286,7 @@ warp_proc_handle(struct seq_file *seq, s
 static int
 wed_proc_open(struct inode *inode, struct file *file)
 {
-	return single_open(file, wed_proc_show, PDE_DATA(file_inode(file)));
+	return single_open(file, wed_proc_show, pde_data(file_inode(file)));
 }
 
