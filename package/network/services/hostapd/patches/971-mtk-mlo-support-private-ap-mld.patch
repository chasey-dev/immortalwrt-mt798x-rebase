@@ -965,6 +965,10 @@ struct hostapd_bss_config {
 	/* The AP is part of an AP MLD */
 	u8 mld_ap;
 
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	u8 mtk_private_mld;
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+
 	/* The MLD ID to which the AP MLD is affiliated with */
 	u8 mld_id;
 
