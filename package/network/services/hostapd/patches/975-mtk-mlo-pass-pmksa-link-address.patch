 				       params->pmk, params->pmk_len,
 				       params->pmkid, WPA_KEY_MGMT_SAE,
 				       false, 0);
@@ -2922,6 +2923,7 @@ static void wpas_set_go_security_config(
 			   MAC2STR(params->peer_device_addr));
 		wpa_auth_pmksa_add_sae(hapd->wpa_auth,
 				       params->peer_device_addr,
+				       params->peer_device_addr,
 				       params->pmk, params->pmk_len,
 				       params->pmkid, WPA_KEY_MGMT_SAE,
 				       false, 0);
