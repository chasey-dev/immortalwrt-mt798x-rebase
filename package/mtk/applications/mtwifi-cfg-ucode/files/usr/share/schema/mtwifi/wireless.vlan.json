{
    "description": "mtwifi vlan schema",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "description": "VLAN name"
        },
        "vid": {
            "type": "string",
            "description": "VLAN ID"
        },
        "iface": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "List of associated interfaces"
        },
        "bridge_isolate": {
            "type": "boolean",
            "description": "Enable bridge port isolation"
        }
    }
}
