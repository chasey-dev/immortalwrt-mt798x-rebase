+					 skb_hnat_sport(skb) == PSE_WDMA2_PORT))
+					to_ppd = true;
 			}
 
 			/* With slow path rate limit enabled, packets take
@@ -3068,6 +3092,12 @@ static int mtk_poll_rx(struct napi_struc
 			mtk_eth_debugfs_hwlro_flush_stats_update(eth, ring->ring_no, &trxd);
 		}
 
+		/* set to Rx PPD */
+		if (unlikely(to_ppd)) {
+			skb->dev = rx_ppdev;
