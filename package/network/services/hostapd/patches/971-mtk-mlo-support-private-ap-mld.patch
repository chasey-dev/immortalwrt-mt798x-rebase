From: chasey-dev <ellenyoung0912@gmail.com>
Subject: [PATCH] AP MLD: Track driver-managed MTK link membership

MTK driver manages AP MLD membership outside standard nl80211 MLO.
hostapd queries private BSSs and validates the resulting group, link ID
and MLD addresses before updating authenticator and nl80211 caches.

A notification can arrive after several driver links have changed.
Changed members release stations and shared security references before
any replacement is installed, so old partner tuples cannot strand the
first updated link. Conflicting queried tuples still fail validation.

Signed-off-by: chasey-dev <ellenyoung0912@gmail.com>
---
--- a/hostapd/config_file.c
+++ b/hostapd/config_file.c
@@ -4958,6 +4958,10 @@ static int hostapd_config_fill(struct ho
 		conf->punct_acs_threshold = val;
 	} else if (os_strcmp(buf, "mld_ap") == 0) {
 		bss->mld_ap = !!atoi(pos);
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	} else if (os_strcmp(buf, "mtk_private_mld") == 0) {
+		bss->mtk_private_mld = !!atoi(pos);
+#endif /* CONFIG_DRIVER_NL80211_MTK */
 	} else if (os_strcmp(buf, "mld_link_id") == 0) {
 		bss->mld_link_id = atoi(pos);
 	} else if (os_strcmp(buf, "mld_addr") == 0) {
--- a/hostapd/main.c
+++ b/hostapd/main.c
@@ -311,7 +311,14 @@ pre_setup_mld:
 	 * would be derived from the original interface address if BSSID is not
 	 * configured, and otherwise it would be the configured BSSID.
 	 */
-	if (hapd->conf->mld_ap) {
+	if (hostapd_is_mtk_private_mld(hapd)) {
+		if (hostapd_sync_mtk_bss_mlo_info(hapd))
+			return -1;
+
+		wpa_printf(MSG_DEBUG,
+			   "Setup of MTK private link (%d) BSS %s",
+			   hapd->mld_link_id, hapd->conf->iface);
+	} else if (hapd->conf->mld_ap) {
 		os_memcpy(hapd->mld->mld_addr, hapd->own_addr, ETH_ALEN);
 
 		if (!b)
--- a/src/ap/ap_config.h
