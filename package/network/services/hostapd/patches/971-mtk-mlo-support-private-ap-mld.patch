@@ -1559,7 +1559,13 @@ int hostapd_setup_bss(struct hostapd_dat
 			os_memcpy(hapd->own_addr, if_addr, ETH_ALEN);
 
 #ifdef CONFIG_IEEE80211BE
-		if (hapd->conf->mld_ap) {
+		if (hostapd_is_mtk_private_mld(hapd)) {
