+#ifdef CONFIG_DRIVER_NL80211_MTK
+/* Must match the MTK driver struct mt_priv_pmkid ABI. */
+struct mtk_pmkid_entry {
+	u8 bssid[ETH_ALEN];
+	u8 sta[ETH_ALEN];
+	u8 link_addr[ETH_ALEN];
+	u8 pmkid[PMKID_LEN];
+	u8 add_remove;
+	int akmp;
+};
+
+static int nl80211_mtk_set_pmkid(struct i802_bss *bss,
+				 struct wpa_pmkid_params *params, bool add)
+{
+	struct mtk_pmkid_entry entry = {};
+	struct nl_msg *msg;
+	struct nlattr *data;
+
+	if (!params->mtk_own_addr || !params->mtk_sta_addr ||
+	    !params->mtk_link_addr || !params->pmkid)
+		return -EINVAL;
+
+	os_memcpy(entry.bssid, params->mtk_own_addr, ETH_ALEN);
+	os_memcpy(entry.sta, params->mtk_sta_addr, ETH_ALEN);
+	os_memcpy(entry.link_addr, params->mtk_link_addr, ETH_ALEN);
+	os_memcpy(entry.pmkid, params->pmkid, PMKID_LEN);
+	entry.add_remove = add ? 1 : 0;
+	entry.akmp = params->mtk_akmp;
+
+	wpa_printf(MSG_INFO,
+		   "nl80211: MTK %s PMKID own=" MACSTR " sta=" MACSTR
+		   " %s=" MACSTR " akmp=0x%x",
+		   add ? "add" : "remove", MAC2STR(entry.bssid),
+		   MAC2STR(entry.sta), add ? "sta_link" : "ap_link",
+		   MAC2STR(entry.link_addr), entry.akmp);
+
+	msg = nl80211_bss_msg(bss, 0, NL80211_CMD_VENDOR);
+	if (!msg ||
+	    nla_put_u32(msg, NL80211_ATTR_VENDOR_ID, MTK_NL80211_VENDOR_ID) ||
+	    nla_put_u32(msg, NL80211_ATTR_VENDOR_SUBCMD,
+			MTK_NL80211_VENDOR_SUBCMD_SET_PMKID) ||
+	    !(data = nla_nest_start(msg, NL80211_ATTR_VENDOR_DATA)) ||
+	    nla_put(msg, MTK_NL80211_VENDOR_ATTR_SET_PMKSA_CACHE,
+		    sizeof(entry), &entry))
+		goto fail;
+
+	nla_nest_end(msg, data);
+	return send_and_recv_cmd(bss->drv, msg);
+
+fail:
+	nlmsg_free(msg);
+	return -ENOBUFS;
+}
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+
