+					  hapd->mtk_mld_group_idx,
+					  hapd->mld_link_id,
+					  MAC2STR(hapd->conf->mld_addr));
+			if (os_snprintf_error(buflen - len, ret))
+				return len;
+			len += ret;
+#endif /* CONFIG_DRIVER_NL80211_MTK */
 		}
 	}
 #endif /* CONFIG_IEEE80211BE */
--- a/src/ap/drv_callbacks.c
+++ b/src/ap/drv_callbacks.c
@@ -2925,6 +2925,33 @@ void hostapd_wpa_event(void *ctx, enum w
 			   hapd->conf->iface);
 		hostapd_mld_interface_freed(hapd);
 		break;
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	case EVENT_MTK_BSS_MLO_INFO:
+	{
+		u8 event_id;
+
+		if (!data)
+			break;
+
+		event_id = data->mtk_bss_mlo_info.event_id;
+
+		switch (event_id) {
+		case MTK_BSS_MLO_EVENT_ADD_LINK:
+		case MTK_BSS_MLO_EVENT_DEL_LINK:
