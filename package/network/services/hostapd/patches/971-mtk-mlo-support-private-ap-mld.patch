+				   "MTK BSS MLO: ignore driver event: iface=%s event_id=%u",
+				   hapd->conf->iface, event_id);
+			break;
+		}
+		break;
+	}
+#endif /* CONFIG_DRIVER_NL80211_MTK */
 #endif /* CONFIG_IEEE80211BE */
 	default:
 		wpa_printf(MSG_DEBUG, "Unknown event %d", event);
