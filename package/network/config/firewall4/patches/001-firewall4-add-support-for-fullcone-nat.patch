From: openwrt-sonic-fullcone integration <noreply@localhost>
Date: Mon, 21 Sep 2026 15:46:36 +0000
Subject: [PATCH] firewall4: fullcone NAT with per-zone and per-protocol granularity

Extends the existing fullcone support with two levels of control on top of
the global gates:

  config defaults
      option fullcone      1   # global gate, IPv4
      option fullcone6     0   # global gate, IPv6

  config zone
      option fullcone            1        # opt this zone in (default 1)
      list   fullcone_proto     'udp'     # optional L4 protocol restriction

defaults.fullcone / defaults.fullcone6 remain the global gates, so existing
configurations keep their behaviour: with the gate on, every masquerading
zone has fullcone enabled. zone.fullcone additionally allows disabling
fullcone for a single zone, and zone.fullcone_proto restricts fullcone to
the listed L4 protocols while every other protocol keeps plain masquerading
(the fullcone rules are emitted first in the nat chain and the generic
masquerade rule stays as fallback).

The fullcone rules carry a counter so the running ruleset can be told apart
from a merely configured one; the counter is emitted before the fullcone
statement because the first nat statement in a chain terminates rule
traversal.

The kernel side comes from the SONiC fullcone patches (984/986 in
target/linux/generic/hack-6.12), which register the "fullcone" nftables
expression inside nft_masq.ko; libnftnl/nftables userspace is unchanged.

---
diff --git a/root/etc/config/firewall b/root/etc/config/firewall
index 48b2440..d1e4280 100644
--- a/root/etc/config/firewall
+++ b/root/etc/config/firewall
@@ -5,6 +5,10 @@
 	option forward		REJECT
 # Uncomment this line to disable ipv6 rules
 #	option disable_ipv6	1
+	option flow_offloading	0
+	option flow_offloading_hw	0
+	option fullcone		1
+	option fullcone6	0
 
 config zone
 	option name		lan
diff --git a/root/usr/share/firewall4/templates/ruleset.uc b/root/usr/share/firewall4/templates/ruleset.uc
index 2bec4d9..02d7535 100644
--- a/root/usr/share/firewall4/templates/ruleset.uc
+++ b/root/usr/share/firewall4/templates/ruleset.uc
@@ -327,6 +327,16 @@
 {%   for (let redirect in fw4.redirects(`dstnat_${zone.name}`)): %}
 		{%+ include("redirect.uc", { fw4, zone, redirect }) %}
 {%   endfor %}
+{%   if (zone.masq && zone.fullcone): %}
+{%    for (let proto in (zone.fullcone_proto || [null])): %}
+		{%+ include("zone-fullcone.uc", { fw4, zone, family: 4, direction: "dstnat", proto }) %}
+{%    endfor %}
+{%   endif %}
+{%   if (zone.masq6 && zone.fullcone6): %}
+{%    for (let proto in (zone.fullcone_proto || [null])): %}
+		{%+ include("zone-fullcone.uc", { fw4, zone, family: 6, direction: "dstnat", proto }) %}
+{%    endfor %}
+{%   endif %}
 {%   fw4.includes('chain-append', `dstnat_${zone.name}`) %}
 	}
 
@@ -338,18 +348,32 @@
 		{%+ include("redirect.uc", { fw4, zone, redirect }) %}
 {%   endfor %}
 {%   if (zone.masq): %}
-{%    for (let saddrs in zone.masq4_src_subnets): %}
-{%     for (let daddrs in zone.masq4_dest_subnets): %}
+{%    if (zone.fullcone): %}
+{%     for (let proto in (zone.fullcone_proto || [null])): %}
+		{%+ include("zone-fullcone.uc", { fw4, zone, family: 4, direction: "srcnat", proto }) %}
+{%     endfor %}
+{%    endif %}
+{%    if (!zone.fullcone || zone.fullcone_proto): %}
+{%     for (let saddrs in zone.masq4_src_subnets): %}
+{%      for (let daddrs in zone.masq4_dest_subnets): %}
 		{%+ include("zone-masq.uc", { fw4, zone, family: 4, saddrs, daddrs }) %}
+{%      endfor %}
 {%     endfor %}
-{%    endfor %}
+{%    endif %}
 {%   endif %}
 {%   if (zone.masq6): %}
-{%    for (let saddrs in zone.masq6_src_subnets): %}
-{%     for (let daddrs in zone.masq6_dest_subnets): %}
+{%    if (zone.fullcone6): %}
+{%     for (let proto in (zone.fullcone_proto || [null])): %}
+		{%+ include("zone-fullcone.uc", { fw4, zone, family: 6, direction: "srcnat", proto }) %}
+{%     endfor %}
+{%    endif %}
+{%    if (!zone.fullcone6 || zone.fullcone_proto): %}
+{%     for (let saddrs in zone.masq6_src_subnets): %}
+{%      for (let daddrs in zone.masq6_dest_subnets): %}
 		{%+ include("zone-masq.uc", { fw4, zone, family: 6, saddrs, daddrs }) %}
+{%      endfor %}
 {%     endfor %}
-{%    endfor %}
+{%    endif %}
 {%   endif %}
 {%   fw4.includes('chain-append', `srcnat_${zone.name}`) %}
 	}
diff --git a/root/usr/share/firewall4/templates/zone-fullcone.uc b/root/usr/share/firewall4/templates/zone-fullcone.uc
new file mode 100644
index 0000000..f25190d
--- /dev/null
+++ b/root/usr/share/firewall4/templates/zone-fullcone.uc
@@ -0,0 +1,6 @@
+{# /usr/share/firewall4/templates/zone-fullcone.uc
+   proto: L4 protocol name to restrict the rule to, or null for all protocols
+ #}
+		meta nfproto {{ fw4.nfproto(family) }}{% if (proto): %} meta l4proto {{ proto }}{% endif %}{% if (zone.counter): %} counter{% endif %} fullcone comment "!fw4: Handle {{
+		zone.name
+}} {{ fw4.nfproto(family, true) }}{% if (proto): %} {{ proto }}{% endif %} fullcone NAT {{ direction }} traffic"
diff --git a/root/usr/share/ucode/fw4.uc b/root/usr/share/ucode/fw4.uc
index 690deb0..3e88a3a 100644
--- a/root/usr/share/ucode/fw4.uc
+++ b/root/usr/share/ucode/fw4.uc
@@ -1,3 +1,5 @@
+// /usr/share/ucode/fw4.uc
+
 const fs = require("fs");
 const uci = require("uci");
 const ubus = require("ubus");
@@ -489,6 +491,25 @@
 	return (rc == 0);
 }
 
+function nft_try_fullcone() {
+	let nft_test =
+		'add table inet fw4-fullcone-test; ' +
+		'add chain inet fw4-fullcone-test dstnat { ' +
+			'type nat hook prerouting priority -100; policy accept; ' +
+			'fullcone; ' +
+		'}; ' +
+		'add chain inet fw4-fullcone-test srcnat { ' +
+			'type nat hook postrouting priority -100; policy accept; ' +
+			'fullcone; ' +
+		'}; ';
+	let cmd = sprintf("/usr/sbin/nft -c '%s' 2>/dev/null", replace(nft_test, "'", "'\\''"));
+	let ok = system(cmd) == 0;
+	if (!ok) {
+		warn("nft_try_fullcone: cmd "+ cmd + "\n");
+	}
+	return ok;
+}
+
 
 return {
 	read_kernel_version: function() {
@@ -855,6 +876,18 @@
 			warn(`[!] ${msg}\n`);
 	},
 
+	myinfo: function(fmt, ...args) {
+		if (getenv("QUIET"))
+			return;
+
+		let msg = sprintf(fmt, ...args);
+
+		if (getenv("TTY"))
+			warn(`\033[32m${msg}\033[m\n`);
+		else
+			warn(`[I] ${msg}\n`);
+	},
+
 	get: function(sid, opt) {
 		return this.cursor.get("firewall", sid, opt);
 	},
@@ -1036,6 +1069,21 @@
 		}
 	},
 
+	myinfo_section: function(s, msg) {
+		if (s[".name"]) {
+			if (s.name)
+				this.myinfo("Section %s (%s) %s", this.section_id(s[".name"]), s.name, msg);
+			else
+				this.myinfo("Section %s %s", this.section_id(s[".name"]), msg);
+		}
+		else {
+			if (s.name)
+				this.myinfo("ubus %s (%s) %s", s.type || "rule", s.name, msg);
+			else
+				this.myinfo("ubus %s %s", s.type || "rule", msg);
+		}
+	},
+
 	parse_policy: function(val) {
 		return this.parse_enum(val, [
 			"accept",
@@ -1475,6 +1523,7 @@
 			"dnat",
 			"snat",
 			"masquerade",
+			"fullcone",
 			"accept",
 			"reject",
 			"drop"
@@ -1946,6 +1995,8 @@
 		}
 
 		let defs = this.parse_options(data, {
+			fullcone: [ "bool", "0" ],
+			fullcone6: [ "bool", "0" ],
 			input: [ "policy", "drop" ],
 			output: [ "policy", "drop" ],
 			forward: [ "policy", "drop" ],
@@ -1980,6 +2031,12 @@
 
 		delete defs.syn_flood;
 
+		if (!nft_try_fullcone()) {
+			delete defs.fullcone;
+			delete defs.fullcone6;
+			warn("nft_try_fullcone failed, disable fullcone globally\n");
+		}
+
 		this.state.defaults = defs;
 	},
 
@@ -2005,6 +2062,9 @@
 
 			masq6: [ "bool" ],
 
+			fullcone: [ "bool", "1" ],
+			fullcone_proto: [ "protocol", null, PARSE_LIST | NO_INVERT ],
+
 			extra: [ "string", null, UNSUPPORTED ],
 			extra_src: [ "string", null, UNSUPPORTED ],
 			extra_dest: [ "string", null, UNSUPPORTED ],
@@ -2036,6 +2096,34 @@
 			}
 		}
 
+		/* Fullcone NAT: defaults.fullcone / defaults.fullcone6 act as global gates,
+		 * zone.fullcone opts a single zone in (default: enabled), and
+		 * zone.fullcone_proto optionally restricts fullcone to specific L4
+		 * protocols - every other protocol keeps plain masquerading. */
+		/* The per-zone intent must be read before the IPv4 gate is applied below.
+		 * Reading the already-gated zone.fullcone would silently make IPv6
+		 * fullcone depend on defaults.fullcone as well. */
+		let fullcone_raw = zone.fullcone;
+
+		zone.fullcone = !!(this.state.defaults.fullcone && fullcone_raw);
+		zone.fullcone6 = !!(this.state.defaults.fullcone6 && fullcone_raw);
+
+		if (zone.fullcone_proto && length(zone.fullcone_proto)) {
+			let protos = [];
+
+			for (let p in zone.fullcone_proto) {
+				if (!p || p.any || !p.name)
+					continue;
+
+				push(protos, p.name);
+			}
+
+			zone.fullcone_proto = length(protos) ? protos : null;
+		}
+		else {
+			zone.fullcone_proto = null;
+		}
+
 		if (zone.mtu_fix && this.kernel < 0x040a0000) {
 			this.warn_section(data, "option 'mtu_fix' requires kernel 4.10 or later");
 			return;
@@ -2205,8 +2293,23 @@
 		zone.related_subnets = related_subnets;
 		zone.related_physdevs = related_physdevs;
 
-		if (zone.masq || zone.masq6)
+		if (zone.masq) {
+			zone.dflags.snat = true;
+			if (zone.fullcone) {
+				zone.dflags.dnat = true;
+				this.myinfo_section(data, "IPv4 fullcone NAT enabled for zone '" + zone.name + "'" +
+					(zone.fullcone_proto ? " (protocols: " + join(', ', zone.fullcone_proto) + ")" : ""));
+			}
+		}
+
+		if (zone.masq6) {
 			zone.dflags.snat = true;
+			if (zone.fullcone6) {
+				zone.dflags.dnat = true;
+				this.myinfo_section(data, "IPv6 fullcone NAT enabled for zone '" + zone.name + "'" +
+					(zone.fullcone_proto ? " (protocols: " + join(', ', zone.fullcone_proto) + ")" : ""));
+			}
+		}
 
 		if ((zone.auto_helper && !(zone.masq || zone.masq6)) || length(zone.helper)) {
 			zone.dflags.helper = true;
