From: chasey-dev <ellenyoung0912@gmail.com>
Subject: [PATCH] nl80211: Add MTK MLO external authentication events

MTK driver reports external authentication through a nested vendor
event. nl80211 decodes its authentication suite and MLO information for
wpa_supplicant. The event identifies a wiphy without an interface index,
so the connection's SSID and known target BSSID identify the receiving
station interface. MLD and link MAC addresses can differ.

Group key installation also requires a vendor preset-link command to
select the target link before sending the key command.

Signed-off-by: chasey-dev <ellenyoung0912@gmail.com>
---
--- a/src/drivers/driver.h
+++ b/src/drivers/driver.h
@@ -2105,6 +2105,12 @@ struct wpa_driver_set_key_params {
 	 *
 	 * Set to a valid Link ID (0-14) when applicable, otherwise -1. */
 	int link_id;
+
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	/**
+	 * use_mtk_mlo_preset_link - Use MTK private MLO preset-link command */
+	bool use_mtk_mlo_preset_link;
+#endif /* CONFIG_DRIVER_NL80211_MTK */
 };
 
 enum wpa_driver_if_type {
@@ -3045,6 +3051,9 @@ enum wpa_drv_update_connect_params_mask
  *	from user space to the driver.
  * @pmkid: Generated PMKID as part of external auth exchange (e.g., SAE).
  * @mld_addr: AP's MLD address or %NULL if MLO is not used
+ * @own_mld_addr: Local MLD address or %NULL if not provided
+ * @mlo_ie: Driver-generated Multi-Link element for external authentication
+ * @mlo_ie_len: Length of mlo_ie in octets
  */
 struct external_auth {
 	enum {
@@ -3058,6 +3067,9 @@ struct external_auth {
 	u16 status;
 	const u8 *pmkid;
 	const u8 *mld_addr;
+	const u8 *own_mld_addr;
+	const u8 *mlo_ie;
+	size_t mlo_ie_len;
 };
 
 #define WPAS_MAX_PASN_PEERS 10
--- a/src/drivers/driver_nl80211.c
+++ b/src/drivers/driver_nl80211.c
@@ -2634,6 +2634,16 @@ static int nl80211_mgmt_subscribe_non_ap
 {
 	struct wpa_driver_nl80211_data *drv = bss->drv;
 	u16 type = (WLAN_FC_TYPE_MGMT << 2) | (WLAN_FC_STYPE_AUTH << 4);
+
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	/* MTK private MLO external auth can require user space SAE frames. */
+	bool should_subscribe_sae = (drv->capa.flags & WPA_DRIVER_FLAGS_SAE) &&
+		(!(drv->capa.flags & WPA_DRIVER_FLAGS_SME) ||
+		 (drv->capa.flags2 & WPA_DRIVER_FLAGS2_MTK_AP_SME));
+#else /* CONFIG_DRIVER_NL80211_MTK */
+	bool should_subscribe_sae = (drv->capa.flags & WPA_DRIVER_FLAGS_SAE) &&
+		!(drv->capa.flags & WPA_DRIVER_FLAGS_SME);
+#endif /* CONFIG_DRIVER_NL80211_MTK */
 	int ret = 0;
 
 	if (nl80211_alloc_mgmt_handle(bss))
@@ -2644,8 +2654,7 @@ static int nl80211_mgmt_subscribe_non_ap
 	if (drv->nlmode == NL80211_IFTYPE_ADHOC) {
 		/* register for any AUTH message */
 		nl80211_register_frame(bss, bss->nl_mgmt, type, NULL, 0, false);
-	} else if ((drv->capa.flags & WPA_DRIVER_FLAGS_SAE) &&
-		   !(drv->capa.flags & WPA_DRIVER_FLAGS_SME)) {
+	} else if (should_subscribe_sae) {
 		/* register for SAE Authentication frames */
 		nl80211_register_frame(bss, bss->nl_mgmt, type,
 				       (u8 *) "\x03\x00", 2, false);
@@ -3671,6 +3680,43 @@ static int nl80211_set_pmk(struct wpa_dr
 }
 
 
+#ifdef CONFIG_DRIVER_NL80211_MTK
+static int nl80211_mtk_preset_mlo_link(struct i802_bss *bss, int link_id)
+{
+	struct wpa_driver_nl80211_data *drv = bss->drv;
+	struct nlattr *data;
+	struct nl_msg *msg;
+	int ret;
+
+	if (link_id < 0 || link_id >= MAX_NUM_MLD_LINKS)
+		return -EINVAL;
+
+	msg = nl80211_bss_msg(bss, 0, NL80211_CMD_VENDOR);
+	if (!msg ||
+	    nla_put_u32(msg, NL80211_ATTR_VENDOR_ID,
+			MTK_NL80211_VENDOR_ID) ||
+	    nla_put_u32(msg, NL80211_ATTR_VENDOR_SUBCMD,
+			MTK_NL80211_VENDOR_SUBCMD_SET_MLO_PRESET_LINK) ||
+	    !(data = nla_nest_start(msg, NL80211_ATTR_VENDOR_DATA)) ||
+	    nla_put_u8(msg, MTK_NL80211_VENDOR_ATTR_MLO_PRESET_LINKID_INFO,
+		       link_id))
+		goto fail;
+
+	nla_nest_end(msg, data);
+	ret = send_and_recv_cmd(drv, msg);
+	if (ret)
+		wpa_printf(MSG_ERROR,
+			   "nl80211: MTK failed to preset MLO key link: link_id=%d ret=%d (%s)",
+			   link_id, ret, strerror(-ret));
+	return ret;
+
+fail:
+	nlmsg_free(msg);
+	return -ENOBUFS;
+}
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+
+
 static int wpa_driver_nl80211_set_key(struct i802_bss *bss,
 				      struct wpa_driver_set_key_params *params)
 {
@@ -3735,6 +3781,15 @@ static int wpa_driver_nl80211_set_key(st
 		return -EOPNOTSUPP;
 	}
 
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	if (params->use_mtk_mlo_preset_link) {
+		ret = nl80211_mtk_preset_mlo_link(bss, link_id);
+		if (ret)
+			return ret;
+		link_id = -1;
+	}
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+
 	ret = -ENOBUFS;
 	key_msg = nlmsg_alloc();
 	if (!key_msg)
--- a/src/drivers/driver_nl80211_event.c
+++ b/src/drivers/driver_nl80211_event.c
@@ -3677,6 +3677,26 @@ struct mtk_bss_mlo_info_event {
 	u8 addr[ETH_ALEN];
 };
 
+enum mtk_mlo_event_subid {
+	MTK_MLO_EVENT_EXTERNAL_AUTH = 1,
+};
+
+struct mtk_mlo_event {
+	u8 id;
+	u8 len;
+	u8 data[];
+} STRUCT_PACKED;
+
+struct mtk_mlo_external_auth_event {
+	u8 ssid[SSID_MAX_LEN + 1];
+	u8 ssid_len;
+	u8 bssid[ETH_ALEN];
+	u32 key_mgmt_suite;
+	u32 action;
+	u8 da[ETH_ALEN];
+	u8 mlo_ie[];
+} STRUCT_PACKED;
+
 static enum hostapd_hw_mode get_mtk_hw_mode(u8 hw_mode)
 {
 	switch (hw_mode) {
@@ -3847,6 +3867,115 @@ static void nl80211_mtk_bss_mlo_info_eve
 }
 
 
+static void nl80211_mtk_mlo_external_auth_event(struct i802_bss *bss,
+						u8 *data, size_t len)
+{
+	struct nlattr *attr = (struct nlattr *) data;
+
+	/* MTK driver wraps its event TLVs in a vendor-data attribute. */
+	if (!data || len < sizeof(*attr) || len > INT_MAX ||
+	    !nla_ok(attr, len) ||
+	    nla_type(attr) != NL80211_ATTR_VENDOR_DATA)
+		return;
+
+	data = nla_data(attr);
+	len = nla_len(attr);
+
+	while (len >= sizeof(struct mtk_mlo_event)) {
+		const struct mtk_mlo_external_auth_event *auth;
+		const struct mtk_mlo_event *vendor_event;
+		struct ieee802_11_elems elems;
+		union wpa_event_data event;
+		const u8 *own_mld_addr = NULL;
+		size_t event_len, mlo_ie_len;
+		u32 action;
+
+		vendor_event = (const struct mtk_mlo_event *) data;
+		event_len = sizeof(*vendor_event) + vendor_event->len;
+		if (event_len > len) {
+			wpa_printf(MSG_DEBUG,
+				   "nl80211: Ignore truncated MTK MLO event");
+			return;
+		}
+
+		if (vendor_event->id != MTK_MLO_EVENT_EXTERNAL_AUTH) {
+			data += event_len;
+			len -= event_len;
+			continue;
+		}
+
+		if (vendor_event->len < sizeof(*auth)) {
+			wpa_printf(MSG_DEBUG,
+				   "nl80211: Ignore short MTK MLO external auth event");
+			return;
+		}
+
+		auth = (const struct mtk_mlo_external_auth_event *)
+			vendor_event->data;
+
+		os_memset(&event, 0, sizeof(event));
+		action = WPA_GET_LE32(vendor_event->data +
+				       offsetof(struct mtk_mlo_external_auth_event,
+						action));
+		if (action == NL80211_EXTERNAL_AUTH_ABORT) {
+			event.external_auth.action = EXT_AUTH_ABORT;
+			wpa_supplicant_event(bss->ctx, EVENT_EXTERNAL_AUTH,
+					     &event);
+			return;
+		}
+		if (action != NL80211_EXTERNAL_AUTH_START)
+			return;
+		if (auth->ssid_len > SSID_MAX_LEN)
+			return;
+
+		/* MTK events identify a wiphy, not an interface. Match the
+		 * connection request instead of comparing MLD and link addresses. */
+		if (bss->drv->nlmode != NL80211_IFTYPE_STATION ||
+		    auth->ssid_len != bss->drv->ssid_len ||
+		    os_memcmp(auth->ssid, bss->drv->ssid, auth->ssid_len) ||
+		    (!is_zero_ether_addr(bss->drv->auth_attempt_bssid) &&
+		     !ether_addr_equal(auth->bssid,
+				       bss->drv->auth_attempt_bssid)))
+			return;
+
+		event.external_auth.action = EXT_AUTH_START;
+		mlo_ie_len = vendor_event->len - sizeof(*auth);
+		if (!mlo_ie_len ||
+		    ieee802_11_parse_elems(auth->mlo_ie, mlo_ie_len,
+					 &elems, 0) == ParseFailed ||
+		    !elems.basic_mle || !elems.basic_mle_len) {
+			wpa_printf(MSG_DEBUG,
+				   "nl80211: MTK MLO external auth has no valid Basic Multi-Link element");
+			return;
+		}
+		own_mld_addr = get_basic_mle_mld_addr(elems.basic_mle,
+						       elems.basic_mle_len);
+		if (!own_mld_addr || is_zero_ether_addr(own_mld_addr) ||
+		    is_multicast_ether_addr(own_mld_addr))
+			return;
+		event.external_auth.mlo_ie = auth->mlo_ie;
+		event.external_auth.mlo_ie_len = mlo_ie_len;
+
+		event.external_auth.key_mgmt_suite =
+			WPA_GET_LE32(vendor_event->data +
+				     offsetof(struct mtk_mlo_external_auth_event,
+					      key_mgmt_suite));
+		event.external_auth.ssid = auth->ssid;
+		event.external_auth.ssid_len = auth->ssid_len;
+		event.external_auth.bssid = auth->bssid;
+		event.external_auth.own_mld_addr = own_mld_addr;
+
+		wpa_printf(MSG_DEBUG,
+			   "nl80211: MTK MLO external auth action=%u "
+			   "BSSID=" MACSTR " own MLD=" MACSTR,
+			   event.external_auth.action,
+			   MAC2STR(auth->bssid), MAC2STR(own_mld_addr));
+		wpa_supplicant_event(bss->ctx, EVENT_EXTERNAL_AUTH, &event);
+		return;
+	}
+}
+
+
 static void nl80211_vendor_event_mtk(struct i802_bss *bss, u32 subcmd,
 				     u8 *data, size_t len)
 {
@@ -3857,6 +3986,9 @@ static void nl80211_vendor_event_mtk(str
 	case MTK_NL80211_VENDOR_EVENT_SEND_ML_INFO:
 		nl80211_mtk_bss_mlo_info_event(bss, data, len);
 		break;
+	case MTK_NL80211_VENDOR_EVENT_MLO_EVENT:
+		nl80211_mtk_mlo_external_auth_event(bss, data, len);
+		break;
 	default:
 		wpa_printf(MSG_DEBUG,
 			   "nl80211: Ignore unsupported MTK vendor event %u",
