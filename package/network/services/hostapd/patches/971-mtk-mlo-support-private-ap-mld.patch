+bool hostapd_is_mtk_private_mld(struct hostapd_data *hapd)
+{
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	return hapd && hapd->conf && hapd->conf->mtk_private_mld;
+#else /* CONFIG_DRIVER_NL80211_MTK */
+	return false;
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+}
+
+
+bool hostapd_has_mtk_bss_mlo_info(struct hostapd_data *hapd)
+{
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	return hapd && hapd->conf && hapd->mtk_mld_group_idx &&
+		hapd->mld_link_id < MAX_NUM_MLD_LINKS &&
+		!is_zero_ether_addr(hapd->conf->mld_addr);
+#else /* CONFIG_DRIVER_NL80211_MTK */
+	return false;
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+}
+
+
+static int hostapd_update_mtk_bss_mlo_info(struct hostapd_data *hapd,
+					    u8 group_idx, u8 link_id,
+					    const u8 *mld_addr)
+{
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	struct hapd_interfaces *interfaces;
+	const char *ifname;
+	bool is_private;
+	bool is_changed;
+	size_t i, j;
+
+	ifname = hapd->conf->iface;
+	is_private = hostapd_is_mtk_private_mld(hapd);
+
+	if (!group_idx) {
+		wpa_printf(MSG_ERROR,
+			   "MTK BSS MLO: refuse update without driver group: iface=%s",
+			   ifname);
+		return -1;
+	}
+
+	if (link_id >= MAX_NUM_MLD_LINKS || !mld_addr ||
+	    is_zero_ether_addr(mld_addr))
+		return -1;
+
+	if (hapd->mtk_mld_group_idx &&
+	    hapd->mtk_mld_group_idx != group_idx && is_private) {
+		wpa_printf(MSG_ERROR,
+			   "MTK private MLD: refuse group change: "
+			   "iface=%s cached_group=%u driver_group=%u",
+			   ifname,
+			   hapd->mtk_mld_group_idx, group_idx);
+		return -1;
+	}
+
+	interfaces = hapd->iface ? hapd->iface->interfaces : NULL;
+	if (is_private && interfaces) {
+		for (i = 0; i < interfaces->count; i++) {
+			struct hostapd_iface *iface = interfaces->iface[i];
+
+			if (!iface)
+				continue;
+
+			for (j = 0; j < iface->num_bss; j++) {
+				struct hostapd_data *bss = iface->bss[j];
+
+				if (!bss || bss == hapd ||
+				    !hostapd_is_mtk_private_mld(bss))
+					continue;
+
+				if (!bss->mtk_mld_group_idx ||
+				    is_zero_ether_addr(bss->conf->mld_addr))
+					continue;
+
+				if (bss->mtk_mld_group_idx == group_idx) {
+					if (ether_addr_equal(bss->conf->mld_addr,
+							     mld_addr))
+						continue;
+
+					wpa_printf(MSG_ERROR,
+						   "MTK private MLD: refuse conflicting group member: "
+						   "iface=%s group=%u mld_addr=" MACSTR
+						   " partner_iface=%s partner_mld_addr=" MACSTR,
+						   ifname, group_idx, MAC2STR(mld_addr),
+						   bss->conf->iface,
+						   MAC2STR(bss->conf->mld_addr));
+					return -1;
+				}
+
+				if (ether_addr_equal(bss->conf->mld_addr,
+						     mld_addr)) {
+					wpa_printf(MSG_ERROR,
+						   "MTK private MLD: refuse duplicate MLD address: "
+						   "iface=%s group=%u mld_addr=" MACSTR
+						   " partner_iface=%s partner_group=%u",
+						   ifname, group_idx, MAC2STR(mld_addr),
+						   bss->conf->iface,
+						   bss->mtk_mld_group_idx);
+					return -1;
+				}
+			}
+		}
+	}
+
+	is_changed = hapd->mtk_mld_group_idx != group_idx ||
+		hapd->mld_link_id != link_id ||
+		is_zero_ether_addr(hapd->conf->mld_addr) ||
+		!ether_addr_equal(hapd->conf->mld_addr, mld_addr);
+
+	if (!is_zero_ether_addr(hapd->conf->mld_addr) &&
+	    !ether_addr_equal(hapd->conf->mld_addr, mld_addr)) {
+		wpa_printf(MSG_DEBUG,
+			   "MTK BSS MLO: replace cached MLD address: "
+			   "iface=%s old=" MACSTR " new=" MACSTR,
+			   ifname,
+			   MAC2STR(hapd->conf->mld_addr),
+			   MAC2STR(mld_addr));
+	}
+
+	hapd->mtk_mld_group_idx = group_idx;
+	hapd->mld_link_id = link_id;
+	os_memcpy(hapd->conf->mld_addr, mld_addr, ETH_ALEN);
+
+	if (hapd->wpa_auth &&
+	    wpa_auth_set_mld_addr(hapd->wpa_auth, mld_addr, link_id)) {
+		wpa_printf(MSG_ERROR,
+			   "MTK BSS MLO: failed to update WPA MLD info: iface=%s",
+			   ifname);
+		return -1;
+	}
+
+	/*
+	 * The MTK driver owns the BSS MLD beacon/ML IE state. It can report
+	 * the final MLD address while the link beacon path is still settling,
+	 * so keep hostapd/WPA state in sync without pushing another beacon.
+	 */
+	if (is_changed && hapd->started)
+		wpa_printf(MSG_DEBUG,
+			   "MTK BSS MLO: updated driver-owned link: "
+			   "iface=%s group=%u link_id=%u "
+			   "mld_addr=" MACSTR,
+			   ifname, group_idx, link_id,
+			   MAC2STR(mld_addr));
+
+	return 0;
+#else /* CONFIG_DRIVER_NL80211_MTK */
+	return 0;
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+}
+
+
+int hostapd_clear_mtk_bss_mlo_info(struct hostapd_data *hapd,
+				    u8 group_idx, u8 link_id)
+{
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	const char *ifname;
+
+	ifname = hapd->conf->iface;
+
+	if (!group_idx) {
+		wpa_printf(MSG_ERROR,
+			   "MTK BSS MLO: refuse DEL_LINK without driver group: iface=%s",
+			   ifname);
+		return -1;
+	}
+
+	if (hapd->mtk_mld_group_idx &&
+	    hapd->mtk_mld_group_idx != group_idx) {
+		wpa_printf(MSG_ERROR,
+			   "MTK BSS MLO: refuse DEL_LINK group mismatch: "
+			   "iface=%s driver_group=%u cached_group=%u",
+			   ifname, group_idx,
+			   hapd->mtk_mld_group_idx);
+		return -1;
+	}
+
+	if (hapd->mld_link_id != link_id) {
+		wpa_printf(MSG_ERROR,
+			   "MTK BSS MLO: refuse DEL_LINK link mismatch: "
+			   "iface=%s driver_link_id=%u cached_link_id=%u",
+			   ifname, link_id, hapd->mld_link_id);
+		return -1;
+	}
+
+	if (hapd->wpa_auth && wpa_auth_clear_mld_addr(hapd->wpa_auth)) {
+		wpa_printf(MSG_ERROR,
+			   "MTK BSS MLO: failed to clear WPA MLD info: iface=%s",
+			   ifname);
+		return -1;
+	}
+
+	os_memset(hapd->conf->mld_addr, 0, ETH_ALEN);
+	hapd->mtk_mld_group_idx = 0;
+	hapd->mld_link_id = 0;
+
+	return 0;
+#else /* CONFIG_DRIVER_NL80211_MTK */
+	return 0;
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+}
+
+
+int hostapd_sync_mtk_bss_mlo_info(struct hostapd_data *hapd)
+{
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	u8 mld_addr[ETH_ALEN];
+	u8 group_idx = 0;
+	u8 link_id = 0;
+	bool is_private;
+
+	if (!hapd || !hapd->conf)
+		return -1;
+
+	is_private = hostapd_is_mtk_private_mld(hapd);
+	if (hapd->conf->mld_ap && !is_private)
+		return 0;
+
+	if (!hapd->driver || !hapd->driver->get_bss_mlo_info)
+		return is_private ? -1 : 0;
+
+	os_memset(mld_addr, 0, sizeof(mld_addr));
+	if (hapd->driver->get_bss_mlo_info(hapd->drv_priv, mld_addr,
+					   &link_id, &group_idx))
+		return is_private ? -1 : 0;
+
+	if (is_zero_ether_addr(mld_addr)) {
+		if (hostapd_has_mtk_bss_mlo_info(hapd) &&
+		    hostapd_clear_mtk_bss_mlo_info(
+			    hapd, hapd->mtk_mld_group_idx,
+			    hapd->mld_link_id))
+			return -1;
+
+		/*
+		 * The MTK driver may publish BSS MLD info after the BSS is
+		 * attached. Keep the state empty until it publishes a non-zero
+		 * MLD address.
+		 */
+		wpa_printf(MSG_DEBUG,
+			   "MTK BSS MLO: defer driver MLD address: iface=%s",
+			   hapd->conf->iface);
+		return 0;
+	}
+
+	return hostapd_update_mtk_bss_mlo_info(hapd, group_idx, link_id,
+					      mld_addr);
+#else /* CONFIG_DRIVER_NL80211_MTK */
+	return 0;
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+}
