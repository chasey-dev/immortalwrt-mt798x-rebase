 void ap_free_sta_pasn(struct hostapd_data *hapd, struct sta_info *sta);
 
 bool ap_sta_is_mld(struct hostapd_data *hapd, struct sta_info *sta);
+bool ap_sta_has_ml_rsn(struct hostapd_data *hapd, struct sta_info *sta);
 void ap_sta_set_mld(struct sta_info *sta, bool mld);
 
 void ap_sta_free_sta_profile(struct mld_info *info);
--- a/src/ap/wpa_auth_glue.c
+++ b/src/ap/wpa_auth_glue.c
@@ -700,6 +700,16 @@ static int hostapd_wpa_auth_for_each_par
 	if (cb(hapd->wpa_auth, cb_ctx))
 		return 1;
 
+	/* MTK driver-managed links use private BSS groups instead of mld. */
+	if (hostapd_is_mtk_private_mld(hapd)) {
+		for_each_mtk_private_mld_link(bss, hapd) {
+			if (bss != hapd && bss->wpa_auth &&
+			    cb(bss->wpa_auth, cb_ctx))
+				return 1;
+		}
+		return 0;
+	}
+
 	if (!hapd->mld)
 		return 0;
 
@@ -1627,7 +1637,8 @@ static int hostapd_wpa_auth_get_ml_key_i
 	wpa_printf(MSG_DEBUG, "WPA_AUTH: MLD: Get key info CB: n_mld_links=%u",
 		   info->n_mld_links);
 
-	if (!hapd->conf->mld_ap || !hapd->iface || !hapd->iface->interfaces)
+	if ((!hapd->conf->mld_ap && !hostapd_has_mtk_bss_mlo_info(hapd)) ||
+	    !hapd->iface || !hapd->iface->interfaces)
 		return -1;
 
 	for (i = 0; i < info->n_mld_links; i++) {
@@ -1648,17 +1659,32 @@ static int hostapd_wpa_auth_get_ml_key_i
 			continue;
 		}
 
-		for_each_mld_link(bss, hapd) {
-			if (bss == hapd || bss->mld_link_id != link_id)
-				continue;
-
-			wpa_auth_ml_get_key_info(bss->wpa_auth,
-						 &info->links[i],
-						 info->mgmt_frame_prot,
-						 info->beacon_prot,
-						 rekey);
-			link_bss_found = true;
-			break;
+		if (hostapd_is_mtk_private_mld(hapd)) {
+			for_each_mtk_private_mld_link(bss, hapd) {
+				if (!bss->wpa_auth || bss->mld_link_id != link_id)
+					continue;
+
+				wpa_auth_ml_get_key_info(bss->wpa_auth,
+							 &info->links[i],
+							 info->mgmt_frame_prot,
+							 info->beacon_prot,
+							 rekey);
+				link_bss_found = true;
+				break;
+			}
+		} else if (hapd->conf->mld_ap) {
+			for_each_mld_link(bss, hapd) {
+				if (bss == hapd || bss->mld_link_id != link_id)
+					continue;
+
+				wpa_auth_ml_get_key_info(bss->wpa_auth,
+							 &info->links[i],
+							 info->mgmt_frame_prot,
+							 info->beacon_prot,
+							 rekey);
+				link_bss_found = true;
+				break;
+			}
 		}
 
 		if (!link_bss_found)
@@ -1869,7 +1895,13 @@ int hostapd_setup_wpa(struct hostapd_dat
 	_conf.link_id = -1;
 	_conf.first_link_auth = NULL;
 
-	if (hapd->conf->mld_ap) {
+	if (hostapd_is_mtk_private_mld(hapd) &&
+	    !hostapd_has_mtk_bss_mlo_info(hapd)) {
+		wpa_printf(MSG_DEBUG,
+			   "MTK private MLD: defer WPA MLD address: iface=%s",
+			   hapd->conf->iface);
+	} else if (!hostapd_is_mtk_private_mld(hapd) &&
+		   hapd->conf->mld_ap) {
 		struct hostapd_data *lhapd;
 
 		_conf.mld_addr = hapd->mld->mld_addr;
@@ -1891,6 +1923,22 @@ int hostapd_setup_wpa(struct hostapd_dat
 		return -1;
 	}
 
+#if defined(CONFIG_IEEE80211BE) && defined(CONFIG_DRIVER_NL80211_MTK)
+	/*
+	 * MTK BSS MLD state can become available after WPA initialization. If
+	 * it is already known, apply it through the same update path used by a
+	 * later driver event.
+	 */
+	if (hostapd_has_mtk_bss_mlo_info(hapd) &&
+	    wpa_auth_set_mld_addr(hapd->wpa_auth, hapd->conf->mld_addr,
+				  hapd->mld_link_id)) {
+		wpa_printf(MSG_ERROR,
+			   "MTK BSS MLO: failed to initialize WPA MLD info: iface=%s",
+			   hapd->conf->iface);
+		return -1;
+	}
+#endif /* CONFIG_IEEE80211BE && CONFIG_DRIVER_NL80211_MTK */
+
 	if (hostapd_set_privacy(hapd, 1)) {
 		wpa_printf(MSG_ERROR, "Could not set PrivacyInvoked "
 			   "for interface %s", hapd->conf->iface);
@@ -1959,6 +2007,36 @@ void hostapd_reconfig_wpa(struct hostapd
 }
 
 
+#if defined(CONFIG_IEEE80211BE) && defined(CONFIG_DRIVER_NL80211_MTK)
+void hostapd_release_mtk_private_mld_auth_refs(struct hostapd_data *hapd)
+{
+	struct hostapd_data *bss;
+	struct sta_info *sta;
+	struct rsn_pmksa_cache *pmksa;
+
+	if (!hostapd_is_mtk_private_mld(hapd) ||
+	    !hostapd_has_mtk_bss_mlo_info(hapd))
+		return;
+
+	/* Cache deinit skips release callbacks. Flush borrowed entries first. */
+	pmksa = wpa_auth_get_pmksa_cache(hapd->wpa_auth);
+	if (pmksa)
+		pmksa_cache_auth_flush(pmksa);
+
+	for_each_mtk_private_mld_link(bss, hapd) {
+		if (bss == hapd)
+			continue;
+
+		for (sta = bss->sta_list; sta; sta = sta->next) {
+			if (ap_sta_has_ml_rsn(bss, sta))
+				wpa_release_link_auth_ref(sta->wpa_sm,
+							  hapd->mld_link_id, false);
+		}
+	}
+}
+#endif /* CONFIG_IEEE80211BE && CONFIG_DRIVER_NL80211_MTK */
+
+
 void hostapd_deinit_wpa(struct hostapd_data *hapd)
 {
 	ieee80211_tkip_countermeasures_deinit(hapd);
@@ -1967,6 +2045,9 @@ void hostapd_deinit_wpa(struct hostapd_d
 
 	rsn_preauth_iface_deinit(hapd);
 	if (hapd->wpa_auth) {
+#if defined(CONFIG_IEEE80211BE) && defined(CONFIG_DRIVER_NL80211_MTK)
+		hostapd_release_mtk_private_mld_auth_refs(hapd);
+#endif /* CONFIG_IEEE80211BE && CONFIG_DRIVER_NL80211_MTK */
 		wpa_deinit(hapd->wpa_auth);
 		hapd->wpa_auth = NULL;
 
--- a/src/ap/wpa_auth_glue.h
