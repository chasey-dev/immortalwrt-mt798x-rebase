---
[v1] pptp: Add fill_forward_path support for NPU tunnel flow offload

Implement pptp_fill_forward_path() to enable PPTP tunnel hardware flow
offload through the NPU. The function fills struct net_device_path with
the PPTP tunnel parameters required by the NPU:
  - Outer IPv4 src/dst address from pptp_opt
  - Local and peer GRE call IDs for both UL/DL identification
  - Current software path sequence number (seq_sent) for the NPU sequence
    generator to continue from, ensuring seamless handoff from software to
    hardware forwarding path without sequence number discontinuity
  - Source and destination MAC addresses resolved via a fresh route lookup
    using pptp_route_output(), consistent with pptp_xmit() behaviour

The callback is registered in pptp_chan_ops, allowing ppp_fill_forward_path()
in ppp_generic to invoke it during flow table path traversal.

---
v1: Add PPTP fill_forward_path for NPU flow offload
---

--- a/drivers/net/ppp/pptp.c
+++ b/drivers/net/ppp/pptp.c
@@ -628,9 +628,64 @@ static int pptp_ppp_ioctl(struct ppp_cha
 	return err;
 }
 
+static int pptp_fill_forward_path(struct net_device_path_ctx *ctx,
+				  struct net_device_path *path,
+				  const struct ppp_channel *chan)
+{
+	struct sock *sk = chan->private;
+	struct pppox_sock *po = pppox_sk(sk);
+	struct pptp_opt *opt = &po->proto.pptp;
+	struct neighbour *n;
+	struct flowi4 fl4;
+	struct rtable *rt;
+
+	if (sock_flag(sk, SOCK_DEAD) || !(sk->sk_state & PPPOX_CONNECTED))
+		return -ENOTCONN;
+
+	path->type = DEV_PATH_PPTP;
+	if (!mtk_flow_tnl_offloadable || !mtk_flow_tnl_offloadable(path))
+		return -EOPNOTSUPP;
+
+	path->tunnel.sip.ip = opt->src_addr.sin_addr.s_addr;
+	path->tunnel.dip.ip = opt->dst_addr.sin_addr.s_addr;
+	path->tunnel.pptp.call_id = opt->src_addr.call_id;
+	path->tunnel.pptp.peer_call_id = opt->dst_addr.call_id;
+	path->tunnel.pptp.seq_sent = opt->seq_sent;
+
+	rt = pptp_route_output(po, &fl4);
+	if (IS_ERR(rt))
+		return  PTR_ERR(rt);
+
+	n = dst_neigh_lookup(&rt->dst, &opt->dst_addr.sin_addr.s_addr);
+	if (!n)
+		goto err_put_rt;
+
+	if (!(READ_ONCE(n->nud_state) & NUD_VALID)) {
+		neigh_release(n);
+		goto err_put_rt;
+	}
+
+	neigh_ha_snapshot(path->tunnel.h_dest, n, n->dev);
+	memcpy(path->tunnel.h_source, n->dev->dev_addr, ETH_ALEN);
+
+	path->dev = ctx->dev;
+	ctx->dev = n->dev;
+
+	neigh_release(n);
+	ip_rt_put(rt);
+
+	return 0;
+
+err_put_rt:
+	ip_rt_put(rt);
+
+	return -EHOSTUNREACH;
+}
+
 static const struct ppp_channel_ops pptp_chan_ops = {
 	.start_xmit = pptp_xmit,
 	.ioctl      = pptp_ppp_ioctl,
+	.fill_forward_path = pptp_fill_forward_path,
 };
 
 static struct proto pptp_sk_proto __read_mostly = {
