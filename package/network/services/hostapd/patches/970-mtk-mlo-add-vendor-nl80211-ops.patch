+struct mtk_bss_mlo_info_ctx {
+	struct bss_mlo_info info;
+	bool has_info;
+};
+
+static int nl80211_mtk_bss_mlo_info_handler(struct nl_msg *msg, void *arg)
+{
+	struct nlattr *tb[NL80211_ATTR_MAX + 1];
+	struct nlattr *sub_tb[MTK_NL80211_VENDOR_ATTR_BSS_MLO_INFO_ATTR_MAX + 1];
+	struct genlmsghdr *gnlh = nlmsg_data(nlmsg_hdr(msg));
+	struct mtk_bss_mlo_info_ctx *ctx = arg;
+	struct nlattr *info;
+
+	if (gnlh->cmd != NL80211_CMD_VENDOR)
+		return NL_SKIP;
+
+	if (nla_parse(tb, NL80211_ATTR_MAX, genlmsg_attrdata(gnlh, 0),
+		      genlmsg_attrlen(gnlh, 0), NULL) ||
+	    !tb[NL80211_ATTR_VENDOR_DATA])
+		return NL_SKIP;
+
+	if (nla_parse_nested(sub_tb,
+			     MTK_NL80211_VENDOR_ATTR_BSS_MLO_INFO_ATTR_MAX,
+			     tb[NL80211_ATTR_VENDOR_DATA], NULL))
+		return NL_SKIP;
+
+	info = sub_tb[MTK_NL80211_VENDOR_ATTR_BSS_MLO_INFO];
+	if (!info)
+		return NL_SKIP;
+
+	if ((size_t) nla_len(info) != sizeof(ctx->info)) {
+		wpa_printf(MSG_DEBUG,
+			   "nl80211: MTK BSS MLO info length mismatch: len=%d expected=%zu",
+			   nla_len(info), sizeof(ctx->info));
+		return NL_SKIP;
+	}
+
+	os_memcpy(&ctx->info, nla_data(info), sizeof(ctx->info));
+	ctx->has_info = true;
+
+	return NL_SKIP;
+}
+
+static int nl80211_mtk_get_bss_mlo_info(struct i802_bss *bss,
+					u8 *mld_addr, u8 *link_id,
+					u8 *mld_grp_idx)
+{
+	struct wpa_driver_nl80211_data *drv = bss->drv;
+	struct mtk_bss_mlo_info_ctx ctx = {};
+	struct nl_msg *msg;
+	struct nlattr *data;
+	int ret;
+
+	wpa_printf(MSG_DEBUG, "nl80211: Query MTK BSS MLO info: ifname=%s",
+		   bss->ifname);
+
+	msg = nl80211_bss_msg(bss, 0, NL80211_CMD_VENDOR);
+	if (!msg ||
+	    nla_put_u32(msg, NL80211_ATTR_VENDOR_ID, MTK_NL80211_VENDOR_ID) ||
+	    nla_put_u32(msg, NL80211_ATTR_VENDOR_SUBCMD,
+			MTK_NL80211_VENDOR_SUBCMD_GET_BSS_MLO_INFO) ||
+	    !(data = nla_nest_start(msg, NL80211_ATTR_VENDOR_DATA)) ||
+	    nla_put_flag(msg, MTK_NL80211_VENDOR_ATTR_BSS_MLO_INFO))
+		goto fail;
+
+	nla_nest_end(msg, data);
+
+	ret = send_and_recv_resp(drv, msg, nl80211_mtk_bss_mlo_info_handler,
+				 &ctx);
+	if (ret) {
+		wpa_printf(MSG_DEBUG,
+			   "nl80211: MTK get BSS MLO info failed: ifname=%s ret=%d (%s)",
+			   bss->ifname, ret, strerror(-ret));
+		return ret;
+	}
+
+	if (!ctx.has_info || !ctx.info.mld_grp_idx ||
+	    is_zero_ether_addr(ctx.info.addr)) {
+		bss->has_mtk_mlo_info = 0;
+		wpa_printf(MSG_DEBUG, "nl80211: No MTK BSS MLO info: ifname=%s",
+			   bss->ifname);
+		return 0;
+	}
+
+	if (ctx.info.link_id >= MAX_NUM_MLD_LINKS) {
+		bss->has_mtk_mlo_info = 0;
+		wpa_printf(MSG_DEBUG,
+			   "nl80211: Invalid MTK BSS MLO link ID: ifname=%s link_id=%u",
+			   bss->ifname, ctx.info.link_id);
+		return -EINVAL;
+	}
+
+	bss->has_mtk_mlo_info = 1;
+	bss->mtk_mlo_group_idx = ctx.info.mld_grp_idx;
+	bss->mtk_mlo_link_id = ctx.info.link_id;
+	os_memcpy(bss->mtk_mlo_addr, ctx.info.addr, ETH_ALEN);
+	if (mld_addr)
+		os_memcpy(mld_addr, ctx.info.addr, ETH_ALEN);
+	if (link_id)
+		*link_id = ctx.info.link_id;
+	if (mld_grp_idx)
+		*mld_grp_idx = ctx.info.mld_grp_idx;
+
+	wpa_printf(MSG_DEBUG,
+		   "nl80211: MTK BSS MLO info: ifname=%s links=%u group=%u "
+		   "link_id=%u mld_addr=" MACSTR,
+		   bss->ifname, ctx.info.link_cnt, bss->mtk_mlo_group_idx,
+		   bss->mtk_mlo_link_id, MAC2STR(bss->mtk_mlo_addr));
+
+	return 0;
+
+fail:
+	nlmsg_free(msg);
+	return -ENOBUFS;
+}
+
+static int wpa_driver_nl80211_get_bss_mlo_info(void *priv, u8 *mld_addr,
+					       u8 *link_id,
+					       u8 *mld_grp_idx)
+{
+	struct i802_bss *bss = priv;
+
+	return nl80211_mtk_get_bss_mlo_info(bss, mld_addr, link_id,
+					    mld_grp_idx);
+}
+
+static int nl80211_mtk_set_auth_mlo_ie(struct i802_bss *bss,
+				       const u8 *mld_addr,
+				       const u8 *link_addr)
+{
+	struct wpa_driver_nl80211_data *drv = bss->drv;
+	struct wpa_mlo_ie_parse peer_mlo;
+	struct nl_msg *msg;
+	struct nlattr *data;
+	int ret;
+
+	if (!mld_addr || !link_addr || !bss->has_mtk_mlo_info)
+		return -EINVAL;
+
+	os_memset(&peer_mlo, 0, sizeof(peer_mlo));
+	peer_mlo.type = MULTI_LINK_CONTROL_TYPE_BASIC;
+	os_memcpy(peer_mlo.ml_addr, mld_addr, ETH_ALEN);
+	peer_mlo.common_info_len = 1 + ETH_ALEN;
+	peer_mlo.ml_link_num = 1;
+	peer_mlo.valid = 1;
+	peer_mlo.profiles[0].link_id = bss->mtk_mlo_link_id;
+	os_memcpy(peer_mlo.profiles[0].addr, link_addr, ETH_ALEN);
+	peer_mlo.profiles[0].mac_addr_present = 1;
+
+	if (!(msg = nl80211_drv_msg(drv, 0, NL80211_CMD_VENDOR)) ||
+	    nla_put_u32(msg, NL80211_ATTR_VENDOR_ID, MTK_NL80211_VENDOR_ID) ||
+	    nla_put_u32(msg, NL80211_ATTR_VENDOR_SUBCMD,
+			MTK_NL80211_VENDOR_SUBCMD_SET_MLO_IE) ||
+	    !(data = nla_nest_start(msg, NL80211_ATTR_VENDOR_DATA)) ||
+	    nla_put(msg, MTK_NL80211_VENDOR_ATTR_SET_AUTH_MLO_IE,
+		    sizeof(peer_mlo), &peer_mlo)) {
+		nlmsg_free(msg);
+		return -ENOBUFS;
+	}
+	nla_nest_end(msg, data);
+
+	wpa_printf(MSG_DEBUG,
+		   "nl80211: MTK set auth MLO IE: ifname=%s mld_addr=" MACSTR
+		   " link_addr=" MACSTR,
+		   bss->ifname, MAC2STR(mld_addr),
+		   MAC2STR(link_addr));
+
+	ret = send_and_recv_cmd(drv, msg);
+	if (ret)
+		wpa_printf(MSG_DEBUG,
+			   "nl80211: MTK failed to set auth MLO IE: ifname=%s ret=%d (%s)",
+			   bss->ifname, ret, strerror(-ret));
+	return ret;
+}
+
+static int wpa_driver_nl80211_set_auth_mlo_ie(void *priv,
+					      const u8 *mld_addr,
+					      const u8 *link_addr)
+{
+	struct i802_bss *bss = priv;
+
+	return nl80211_mtk_set_auth_mlo_ie(bss, mld_addr, link_addr);
+}
