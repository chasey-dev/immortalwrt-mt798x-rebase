@@ -12,5 +12,8 @@
 int hostapd_setup_wpa(struct hostapd_data *hapd);
 void hostapd_reconfig_wpa(struct hostapd_data *hapd);
 void hostapd_deinit_wpa(struct hostapd_data *hapd);
+#if defined(CONFIG_IEEE80211BE) && defined(CONFIG_DRIVER_NL80211_MTK)
+void hostapd_release_mtk_private_mld_auth_refs(struct hostapd_data *hapd);
+#endif /* CONFIG_IEEE80211BE && CONFIG_DRIVER_NL80211_MTK */
 
 #endif /* WPA_AUTH_GLUE_H */
--- a/src/ap/wpa_auth.c
+++ b/src/ap/wpa_auth.c
@@ -681,6 +681,12 @@ static void wpa_auth_pmksa_free_cb(struc
 {
 	struct wpa_authenticator *wpa_auth = ctx;
 	const u8 *aa = wpa_auth->addr;
+#ifdef CONFIG_IEEE80211BE
+	bool clear_partners = entry->is_ml;
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	u64 drv_flags = 0, drv_flags2 = 0;
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+#endif /* CONFIG_IEEE80211BE */
 
 #ifdef CONFIG_IEEE80211BE
 	if (wpa_auth->is_ml)
@@ -688,7 +694,17 @@ static void wpa_auth_pmksa_free_cb(struc
 #endif /* CONFIG_IEEE80211BE */
 
 #ifdef CONFIG_IEEE80211BE
-	if (!entry->is_ml) {
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	/*
+	 * MTK MLO association can borrow a partner's non-ML PMKSA entry.
+	 * Clear those references before the partner cache frees the entry.
+	 */
+	if (wpa_auth->is_ml &&
+	    wpa_auth_get_drv_flags(wpa_auth, &drv_flags, &drv_flags2) == 0 &&
+	    (drv_flags2 & WPA_DRIVER_FLAGS2_MTK_AP_SME))
+		clear_partners = true;
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+	if (!clear_partners) {
 		wpa_auth_for_each_sta(wpa_auth, wpa_auth_pmksa_clear_cb, entry);
 	} else {
 		/* Clear stale PMKSA references across partner MLD links. */
