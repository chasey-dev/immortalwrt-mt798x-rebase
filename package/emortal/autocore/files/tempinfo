#!/bin/sh

. /etc/openwrt_release

IEEE_PATH="/sys/class/ieee80211"
THERMAL_PATH="/sys/class/thermal"

get_mtwifi_temp() {
	local flag
	local ifname
	local temp
	local mdeg
	local want=0
	local got=0
	local mtwifi_vifs="ra0 rax0 rai0 ray0 rae0 raz0"
	local result=""

	# mt_wifi exposes the per-band chip temperature through
	# /proc/net/mt_wifi/tempN in millidegrees Celsius.  It is the same
	# MCU query as "iwpriv <if> stat", but without formatting and
	# parsing the whole stat block on every refresh.  Only use it when
	# every file could be read; otherwise fall back to iwpriv below.
	for temp in /proc/net/mt_wifi/temp*; do
		[ -e "$temp" ] || continue
		want=$((want + 1))
		mdeg="$(cat "$temp" 2>/dev/null)" || continue
		case "$mdeg" in
		''|*[!0-9]*) continue ;;
		esac
		mdeg=$(( (mdeg + 500) / 1000 ))
		got=$((got + 1))
		[ -z "$result" ] && result="${mdeg}°C" || result="${result}/${mdeg}°C"
	done
	if [ "$want" -gt 0 ] && [ "$got" -eq "$want" ]; then
		echo "$result"
		return
	fi

	result=""
	for ifname in $mtwifi_vifs; do
		if [ -f "/sys/class/net/${ifname}/flags" ]; then
			flag="$(cat /sys/class/net/${ifname}/flags)"
			if [ "$((flag & 0x1))" -eq "1" ]; then
				temp="$(iwpriv ${ifname} stat | awk '/CurrentTemperature/ {printf("%d°C", $3)}')"
				[ -z "$result" ] && result="${temp}" || result="${result}/${temp}"
			fi
		fi
	done
	echo ${result:-unknown}
}

case "$DISTRIB_TARGET" in
ipq40xx/*|ipq806x/*)
	wifi_temp="$(awk '{printf("%.1f°C ", $0 / 1000)}' "$IEEE_PATH"/phy*/device/hwmon/hwmon*/temp1_input 2>"/dev/null" | awk '$1=$1')"
	;;
mediatek/mt7622)
	wifi_temp="$(awk '{printf("%.1f°C ", $0 / 1000)}' "$IEEE_PATH"/wl*/hwmon*/temp1_input 2>"/dev/null" | awk '$1=$1')"
	;;
mediatek/filogic)
	wifi_temp="$(get_mtwifi_temp)"
	;;
*)
	wifi_temp="$(awk '{printf("%.1f°C ", $0 / 1000)}' "$IEEE_PATH"/phy*/hwmon*/temp1_input 2>"/dev/null" | awk '$1=$1')"
	;;
esac

case "$DISTRIB_TARGET" in
ipq40xx/*)
	if [ -e "$IEEE_PATH/phy0/hwmon0/temp1_input" ]; then
		mt76_temp="$(awk -F ': ' '{print $2}' "$IEEE_PATH/phy0/hwmon0/temp1_input" 2>"/dev/null")°C"
	fi
	[ -z "$mt76_temp" ] || wifi_temp="${wifi_temp:+$wifi_temp }$mt76_temp"
	;;
*)
	cpu_temp="$(awk '{printf("%.1f°C", $0 / 1000)}' "$THERMAL_PATH/thermal_zone0/temp" 2>"/dev/null")"
	;;
esac

if [ -n "$cpu_temp" ] && [ -z "$wifi_temp" ]; then
	echo -n "CPU: $cpu_temp"
elif [ -z "$cpu_temp" ] && [ -n "$wifi_temp" ]; then
	echo -n "WiFi: $wifi_temp"
elif [ -n "$cpu_temp" ] && [ -n "$wifi_temp" ]; then
	echo -n "CPU: $cpu_temp, WiFi: $wifi_temp"
else
	echo -n "No temperature info"
fi
