From: chasey-dev <ellenyoung0912@gmail.com>
Subject: [PATCH] WPA: Sync AP PMKSA entries with MTK driver

MTK driver maintains PMKID state separately from the hostapd PMKSA
cache. Its vendor ABI uses station addresses for addition and AP
addresses for removal.

PMKSA synchronization now passes those addresses and reports removal
failures. A failed PMKID installation rejects SAE authentication and
removes the unsynchronized cache entry. This requires MTK driver to
report missing stations and invalid PMKID operations as errors.

Signed-off-by: chasey-dev <ellenyoung0912@gmail.com>
---
--- a/src/ap/ap_drv_ops.c
+++ b/src/ap/ap_drv_ops.c
@@ -1414,11 +1414,35 @@ int hostapd_add_pmkid(struct hostapd_dat
 	params.pmkid = pmkid;
 	params.pmk = pmk;
 	params.pmk_len = pmk_len;
+	(void) akmp;
 
 	return hostapd_drv_add_pmkid(hapd, &params);
 }
 
 
+#ifdef CONFIG_DRIVER_NL80211_MTK
+int hostapd_add_mtk_pmkid(struct hostapd_data *hapd, const u8 *aa,
+			  const u8 *sta_addr, const u8 *link_addr,
+			  const u8 *pmk, size_t pmk_len, const u8 *pmkid,
+			  int akmp)
+{
+	struct wpa_pmkid_params params;
+
+	os_memset(&params, 0, sizeof(params));
+	params.bssid = sta_addr;
+	params.pmkid = pmkid;
+	params.pmk = pmk;
+	params.pmk_len = pmk_len;
+	params.mtk_own_addr = aa;
+	params.mtk_sta_addr = sta_addr;
+	params.mtk_link_addr = link_addr;
+	params.mtk_akmp = akmp;
+
+	return hostapd_drv_add_pmkid(hapd, &params);
+}
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+
+
 static int hostapd_drv_remove_pmkid(struct hostapd_data *hapd,
 				    struct wpa_pmkid_params *params)
 {
@@ -1439,3 +1463,30 @@ int hostapd_remove_pmkid(struct hostapd_
 
 	return hostapd_drv_remove_pmkid(hapd, &params);
 }
+
+
+#ifdef CONFIG_DRIVER_NL80211_MTK
+int hostapd_remove_mtk_pmkid(struct hostapd_data *hapd, const u8 *aa,
+			     const u8 *sta_addr, const u8 *link_addr,
+			     const u8 *pmkid, int akmp)
+{
+	struct wpa_pmkid_params params;
+	int ret;
+
+	os_memset(&params, 0, sizeof(params));
+	params.bssid = sta_addr;
+	params.pmkid = pmkid;
+	params.mtk_own_addr = aa;
+	params.mtk_sta_addr = sta_addr;
+	params.mtk_link_addr = link_addr;
+	params.mtk_akmp = akmp;
+
+	ret = hostapd_drv_remove_pmkid(hapd, &params);
+	if (ret < 0 &&
+	    (hapd->iface->drv_flags2 & WPA_DRIVER_FLAGS2_MTK_AP_SME))
+		wpa_printf(MSG_ERROR,
+			   "RSN: Failed to remove PMKID from driver for " MACSTR
+			   ": %d", MAC2STR(sta_addr), ret);
+	return ret;
+}
+#endif /* CONFIG_DRIVER_NL80211_MTK */
--- a/src/ap/ap_drv_ops.h
+++ b/src/ap/ap_drv_ops.h
@@ -514,5 +514,14 @@ int hostapd_add_pmkid(struct hostapd_dat
 		      size_t pmk_len, const u8 *pmkid, int akmp);
 int hostapd_remove_pmkid(struct hostapd_data *hapd, const u8 *sta_addr,
 			 const u8 *pmkid);
+#ifdef CONFIG_DRIVER_NL80211_MTK
+int hostapd_add_mtk_pmkid(struct hostapd_data *hapd, const u8 *aa,
+			  const u8 *sta_addr, const u8 *link_addr,
+			  const u8 *pmk, size_t pmk_len, const u8 *pmkid,
+			  int akmp);
+int hostapd_remove_mtk_pmkid(struct hostapd_data *hapd, const u8 *aa,
+			     const u8 *sta_addr, const u8 *link_addr,
+			     const u8 *pmkid, int akmp);
+#endif /* CONFIG_DRIVER_NL80211_MTK */
 
 #endif /* AP_DRV_OPS */
--- a/src/ap/ieee802_11.c
+++ b/src/ap/ieee802_11.c
@@ -1145,10 +1145,25 @@ static int sae_assign_vlan(struct hostap
 
 void sae_accept_sta(struct hostapd_data *hapd, struct sta_info *sta)
 {
+	int ret;
+
 	if (sta->sae->tmp &&
 	    sae_assign_vlan(hapd, sta, sta->sae->tmp->vlan_id) < 0)
 		return;
 
+	ret = wpa_auth_pmksa_add_sae(hapd->wpa_auth, sta->addr,
+				   sta->sae->pmk, sta->sae->pmk_len,
+				   sta->sae->pmkid, sta->sae->akmp,
+				   ap_sta_is_mld(hapd, sta), sta->vlan_id);
+	if (ret < 0 && !hapd->conf->disable_pmksa_caching &&
+	    (hapd->iface->drv_flags2 & WPA_DRIVER_FLAGS2_MTK_AP_SME)) {
+		sta->flags &= ~WLAN_STA_AUTH;
+		sae_set_state(sta, SAE_NOTHING, "PMKID synchronization failed");
+		sae_sme_send_external_auth_status(hapd, sta,
+						  WLAN_STATUS_UNSPECIFIED_FAILURE);
+		return;
+	}
+
 	sta->flags |= WLAN_STA_AUTH;
 	sta->auth_alg = WLAN_AUTH_SAE;
 	mlme_authenticate_indication(hapd, sta);
@@ -1157,10 +1172,6 @@ void sae_accept_sta(struct hostapd_data
 	crypto_bignum_deinit(sta->sae->peer_commit_scalar_accepted, 0);
 	sta->sae->peer_commit_scalar_accepted = sta->sae->peer_commit_scalar;
 	sta->sae->peer_commit_scalar = NULL;
-	wpa_auth_pmksa_add_sae(hapd->wpa_auth, sta->addr,
-			       sta->sae->pmk, sta->sae->pmk_len,
-			       sta->sae->pmkid, sta->sae->akmp,
-			       ap_sta_is_mld(hapd, sta), sta->vlan_id);
 	sae_sme_send_external_auth_status(hapd, sta, WLAN_STATUS_SUCCESS);
 }
 
--- a/src/ap/wpa_auth.c
+++ b/src/ap/wpa_auth.c
@@ -680,6 +680,12 @@ static void wpa_auth_pmksa_free_cb(struc
 				   void *ctx)
 {
 	struct wpa_authenticator *wpa_auth = ctx;
+	const u8 *aa = wpa_auth->addr;
+
+#ifdef CONFIG_IEEE80211BE
+	if (wpa_auth->is_ml)
+		aa = wpa_auth->mld_addr;
+#endif /* CONFIG_IEEE80211BE */
 
 #ifdef CONFIG_IEEE80211BE
 	if (!entry->is_ml) {
@@ -697,8 +703,8 @@ static void wpa_auth_pmksa_free_cb(struc
 	/* Remove matching PMKID from the driver, if it had been added, e.g.,
 	 * by external SAE authentication */
 	if (wpa_auth->cb->remove_pmkid)
-		wpa_auth->cb->remove_pmkid(wpa_auth->cb_ctx, entry->spa,
-					   entry->pmkid);
+		wpa_auth->cb->remove_pmkid(wpa_auth->cb_ctx, aa, entry->spa,
+					   wpa_auth->addr, entry->pmkid, entry->akmp);
 }
 
 
@@ -6618,6 +6624,15 @@ int wpa_auth_pmksa_add_sae(struct wpa_au
 #ifdef CONFIG_IEEE80211BE
 	entry->is_ml = is_ml;
 #endif /* CONFIG_IEEE80211BE */
+	if (!is_ml && wpa_auth->cb->add_pmkid &&
+	    wpa_auth->cb->add_pmkid(wpa_auth->cb_ctx, aa, addr, addr,
+				  entry->pmk, entry->pmk_len,
+				  entry->pmkid, entry->akmp) < 0) {
+		wpa_printf(MSG_ERROR, "RSN: Failed to add PMKID to driver for "
+			   MACSTR, MAC2STR(addr));
+		pmksa_cache_free_entry(pmksa, entry);
+		return -1;
+	}
 
 	return 0;
 }
--- a/src/ap/wpa_auth.h
+++ b/src/ap/wpa_auth.h
@@ -437,7 +437,11 @@ struct wpa_auth_callbacks {
 	struct wpa_authenticator * (*next_primary_auth)(void *ctx);
 #endif /* CONFIG_IEEE80211BE */
 	int (*get_drv_flags)(void *ctx, u64 *drv_flags, u64 *drv_flags2);
-	int (*remove_pmkid)(void *ctx, const u8 *sta_addr, const u8 *pmkid);
+	int (*add_pmkid)(void *ctx, const u8 *aa, const u8 *sta_addr,
+			 const u8 *link_addr, const u8 *pmk, size_t pmk_len,
+			 const u8 *pmkid, int akmp);
+	int (*remove_pmkid)(void *ctx, const u8 *aa, const u8 *sta_addr,
+			    const u8 *link_addr, const u8 *pmkid, int akmp);
 };
 
 struct wpa_authenticator * wpa_init(const u8 *addr,
--- a/src/ap/wpa_auth_glue.c
+++ b/src/ap/wpa_auth_glue.c
@@ -1701,11 +1701,40 @@ static int hostapd_wpa_auth_get_drv_flag
 }
 
 
-static int hostapd_wpa_auth_remove_pmkid(void *ctx, const u8 *sta_addr,
-					 const u8 *pmkid)
+#ifdef CONFIG_DRIVER_NL80211_MTK
+static int hostapd_wpa_auth_add_pmkid(void *ctx, const u8 *aa,
+				      const u8 *sta_addr,
+				      const u8 *link_addr, const u8 *pmk,
+				      size_t pmk_len, const u8 *pmkid,
+				      int akmp)
 {
 	struct hostapd_data *hapd = ctx;
 
+	if (!(hapd->iface->drv_flags2 & WPA_DRIVER_FLAGS2_MTK_AP_SME))
+		return 0;
+
+	return hostapd_add_mtk_pmkid(hapd, aa, sta_addr, link_addr, pmk,
+				     pmk_len, pmkid, akmp);
+}
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+
+
+static int hostapd_wpa_auth_remove_pmkid(void *ctx, const u8 *aa,
+					 const u8 *sta_addr,
+					 const u8 *link_addr,
+					 const u8 *pmkid, int akmp)
+{
+	struct hostapd_data *hapd = ctx;
+
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	if (os_memcmp(aa, link_addr, ETH_ALEN) == 0)
+		return hostapd_remove_mtk_pmkid(hapd, aa, sta_addr, link_addr,
+						pmkid, akmp);
+#else /* CONFIG_DRIVER_NL80211_MTK */
+	(void) aa;
+	(void) link_addr;
+	(void) akmp;
+#endif /* CONFIG_DRIVER_NL80211_MTK */
 	return hostapd_remove_pmkid(hapd, sta_addr, pmkid);
 }
 
@@ -1768,6 +1797,9 @@ int hostapd_setup_wpa(struct hostapd_dat
 		.next_primary_auth = hostapd_next_primary_auth,
 #endif /* CONFIG_IEEE80211BE */
 		.get_drv_flags = hostapd_wpa_auth_get_drv_flags,
+#ifdef CONFIG_DRIVER_NL80211_MTK
+		.add_pmkid = hostapd_wpa_auth_add_pmkid,
+#endif /* CONFIG_DRIVER_NL80211_MTK */
 		.remove_pmkid = hostapd_wpa_auth_remove_pmkid,
 	};
 	const u8 *wpa_ie;
--- a/src/drivers/driver.h
+++ b/src/drivers/driver.h
@@ -3000,6 +3000,12 @@ struct wpa_pmkid_params {
 	size_t pmk_len;
 	u32 pmk_lifetime;
 	u8 pmk_reauth_threshold;
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	const u8 *mtk_own_addr;
+	const u8 *mtk_sta_addr;
+	const u8 *mtk_link_addr;
+	int mtk_akmp;
+#endif /* CONFIG_DRIVER_NL80211_MTK */
 };
 
 /* Mask used to specify which connection parameters have to be updated */
--- a/src/drivers/driver_nl80211.c
+++ b/src/drivers/driver_nl80211.c
@@ -10438,6 +10438,62 @@ static int nl80211_pmkid(struct i802_bss
 }
 
 
+#ifdef CONFIG_DRIVER_NL80211_MTK
+/* Must match MTK driver struct mt_priv_pmkid ABI. */
+struct mtk_pmkid_entry {
+	u8 bssid[ETH_ALEN];
+	u8 sta[ETH_ALEN];
+	u8 link_addr[ETH_ALEN];
+	u8 pmkid[PMKID_LEN];
+	u8 add_remove;
+	int akmp;
+};
+
+static int nl80211_mtk_set_pmkid(struct i802_bss *bss,
+				 struct wpa_pmkid_params *params, bool add)
+{
+	struct mtk_pmkid_entry entry = {};
+	struct nl_msg *msg;
+	struct nlattr *data;
+
+	if (!params->mtk_own_addr || !params->mtk_sta_addr ||
+	    !params->mtk_link_addr || !params->pmkid)
+		return -EINVAL;
+
+	os_memcpy(entry.bssid, params->mtk_own_addr, ETH_ALEN);
+	os_memcpy(entry.sta, params->mtk_sta_addr, ETH_ALEN);
+	os_memcpy(entry.link_addr, params->mtk_link_addr, ETH_ALEN);
+	os_memcpy(entry.pmkid, params->pmkid, PMKID_LEN);
+	entry.add_remove = add ? 1 : 0;
+	entry.akmp = params->mtk_akmp;
+
+	wpa_printf(MSG_DEBUG,
+		   "nl80211: MTK %s PMKID own=" MACSTR " sta=" MACSTR
+		   " %s=" MACSTR " akmp=0x%x",
+		   add ? "add" : "remove", MAC2STR(entry.bssid),
+		   MAC2STR(entry.sta), add ? "sta_link" : "ap_link",
+		   MAC2STR(entry.link_addr), entry.akmp);
+
+	msg = nl80211_bss_msg(bss, 0, NL80211_CMD_VENDOR);
+	if (!msg ||
+	    nla_put_u32(msg, NL80211_ATTR_VENDOR_ID, MTK_NL80211_VENDOR_ID) ||
+	    nla_put_u32(msg, NL80211_ATTR_VENDOR_SUBCMD,
+			MTK_NL80211_VENDOR_SUBCMD_SET_PMKID) ||
+	    !(data = nla_nest_start(msg, NL80211_ATTR_VENDOR_DATA)) ||
+	    nla_put(msg, MTK_NL80211_VENDOR_ATTR_SET_PMKSA_CACHE,
+		    sizeof(entry), &entry))
+		goto fail;
+
+	nla_nest_end(msg, data);
+	return send_and_recv_cmd(bss->drv, msg);
+
+fail:
+	nlmsg_free(msg);
+	return -ENOBUFS;
+}
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+
+
 static int nl80211_add_pmkid(void *priv, struct wpa_pmkid_params *params)
 {
 	struct i802_bss *bss = priv;
@@ -10446,6 +10502,12 @@ static int nl80211_add_pmkid(void *priv,
 	bool skip_pmk = params->pmk_len > PMK_MAX_LEN;
 	int ret;
 
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	if (params->mtk_own_addr &&
+	    (bss->drv->capa.flags2 & WPA_DRIVER_FLAGS2_MTK_AP_SME))
+		return nl80211_mtk_set_pmkid(bss, params, true);
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+
 	if (params->bssid)
 		wpa_printf(MSG_DEBUG, "nl80211: Add PMKID for " MACSTR,
 			   MAC2STR(params->bssid));
@@ -10480,6 +10542,12 @@ static int nl80211_remove_pmkid(void *pr
 	struct i802_bss *bss = priv;
 	int ret;
 
+#ifdef CONFIG_DRIVER_NL80211_MTK
+	if (params->mtk_own_addr &&
+	    (bss->drv->capa.flags2 & WPA_DRIVER_FLAGS2_MTK_AP_SME))
+		return nl80211_mtk_set_pmkid(bss, params, false);
+#endif /* CONFIG_DRIVER_NL80211_MTK */
+
 	if (params->bssid)
 		wpa_printf(MSG_DEBUG, "nl80211: Delete PMKID for " MACSTR,
 			   MAC2STR(params->bssid));
