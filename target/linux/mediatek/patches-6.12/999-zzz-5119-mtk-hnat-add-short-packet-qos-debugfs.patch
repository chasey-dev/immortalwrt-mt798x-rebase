hnat: add short-packet QoS debugfs knobs

Add short_pkt_toggle / short_pkt_qid / short_pkt_len debugfs nodes
under /sys/kernel/debug/hnat so userspace can enable per-flow short
packet detection and select the target hardware queue.

Also fix hnat_qos_toggle_read to print the value via seq_printf
instead of pr_info so `cat qos_toggle` works, and include the entry
qid in the all_entry dump for easier debugging.

Signed-off-by: hxlls <hxlls@users.noreply.github.com>
---

diff --git a/drivers/net/ethernet/mediatek/mtk_hnat/hnat.h b/drivers/net/ethernet/mediatek/mtk_hnat/hnat.h
index 2be5d44304..57b5d46264 100644
--- a/drivers/net/ethernet/mediatek/mtk_hnat/hnat.h
+++ b/drivers/net/ethernet/mediatek/mtk_hnat/hnat.h
@@ -1509,6 +1509,9 @@ extern int qos_toggle;
 extern int l2br_toggle;
 extern int l4s_toggle;
 extern int tnl_toggle;
+extern int short_pkt_toggle;
+extern int short_pkt_qid;
+extern int short_pkt_len;
 extern int (*mtk_tnl_encap_offload)(struct sk_buff *skb, struct ethhdr *eth);
 extern int (*mtk_tnl_decap_offload)(struct sk_buff *skb);
 extern bool (*mtk_tnl_decap_offloadable)(struct sk_buff *skb);
diff --git a/drivers/net/ethernet/mediatek/mtk_hnat/hnat_debugfs.c b/drivers/net/ethernet/mediatek/mtk_hnat/hnat_debugfs.c
